---
// Launch-style hero: centred name and headline, the Arrow AI film as the
// visual event, a floating audit capsule and a quiet row of assistant logos.
// Any element with data-watch (and optional data-t seconds) plays the film
// with sound from that point.
import Icon from './Icon.astro';
import { ARROW, ENGINE_LOGOS } from '../lib/site';
const engines = ENGINE_LOGOS.filter((l) => l.name !== 'Google AI Mode');
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <p class="launch">New · 15 guides</p>
  <p class="product"><img src="/brand/arrow-icon-192.png" alt="Arrow AI logo" width="30" height="30" fetchpriority="high" />Arrow Signal</p>
  <h1 id="hero-title" class="t-hero">Be <span class="hl">the answer</span><br /> when buyers ask AI.</h1>
  <p class="lede">AI visibility guides from Arrow AI: how brands get found, cited and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.</p>
  <div class="btn-row center">
    <a class="btn btn-primary" href={ARROW.freeAudit}>Get your free audit</a>
    <a class="link" href="/blog/">Read the 15 guides <span class="arr" aria-hidden="true">›</span></a>
  </div>

  <figure class="stage" id="film">
    <div class="frame-v" data-frame>
      <video data-film muted loop playsinline preload="none" width="1280" height="720" poster="/media/arrow-ai-geo-film-poster.webp" aria-label="Arrow AI film, 36 seconds: SEO ranked you. GEO gets you answered.">
        <source src="/media/arrow-ai-geo-film.webm" type="video/webm" />
        <source src="/media/arrow-ai-geo-film.mp4" type="video/mp4" />
        <track kind="captions" src="/media/arrow-ai-geo-film.en.vtt" srclang="en" label="English" />
      </video>
      <div class="controls" data-controls>
        <button class="ctl watch" type="button" data-watch data-t="0"><Icon name="play" size={14} />Watch the film</button>
        <button class="ctl round" type="button" data-toggle aria-label="Pause the preview">
          <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.6" height="14" rx="1" /><rect x="13.9" y="5" width="3.6" height="14" rx="1" /></svg>
          <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
        </button>
      </div>
    </div>
    <figcaption class="sr-only">Arrow AI in 36 seconds: SEO ranked you. GEO gets you answered.</figcaption>
    <div class="capsule">
      <img src="/brand/arrow-icon-192.png" alt="" width="36" height="36" loading="lazy" />
      <p><strong>Free AI visibility audit</strong><span>See what AI says about your brand.</span></p>
      <a class="btn btn-primary btn-sm" href={ARROW.freeAudit}>Get started</a>
    </div>
  </figure>

  <div class="engines">
    <p class="eyebrow">Built for answers in</p>
    <ul aria-label="AI assistants covered by these guides">
      {engines.map((l) => <li><img src={l.src} alt="" width="22" height="22" loading="lazy" />{l.name}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero { padding: 64px var(--pad) 0; text-align: center; }
  .launch { display: block; margin-bottom: 14px; }
  .product { display: inline-flex; align-items: center; gap: 10px; font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
  .product img { width: 30px; height: 30px; border-radius: 8px; }
  .t-hero { margin: 18px auto 0; max-width: 900px; }
  .hero .lede { margin: 22px auto 0; max-width: 600px; }
  .hero .btn-row { margin-top: 30px; }

  .stage { position: relative; max-width: var(--wide); margin: 64px auto 0; }
  .frame-v { position: relative; border-radius: var(--r-card); overflow: hidden; background: #0b0d1d; aspect-ratio: 16 / 9; }
  .frame-v video { width: 100%; height: 100%; object-fit: cover; }
  .controls { position: absolute; right: 20px; bottom: 20px; display: flex; gap: 10px; transition: opacity 0.3s; }
  .ctl { height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: 36px; background: rgba(210, 210, 215, 0.64); backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px); color: rgba(0, 0, 0, 0.72); font-size: 0.85rem; font-weight: 600; transition: background 0.2s, color 0.2s; }
  .ctl:hover { background: rgba(223, 223, 227, 0.82); color: #000; }
  .ctl.watch { padding: 0 18px 0 15px; }
  .ctl.round { width: 44px; }
  .ctl svg { width: 16px; height: 16px; }
  .ctl .i-play { display: none; }
  .ctl.paused .i-play { display: block; }
  .ctl.paused .i-pause { display: none; }
  .stage.is-playing .controls { opacity: 0; pointer-events: none; }

  .capsule { position: absolute; left: 50%; bottom: 0; transform: translate(-50%, 50%); display: flex; align-items: center; gap: 14px; padding: 12px 12px 12px 14px; border-radius: var(--r-card); background: var(--white); box-shadow: var(--ring); text-align: left; white-space: nowrap; }
  .capsule img { width: 36px; height: 36px; border-radius: 10px; }
  .capsule p { display: grid; line-height: 1.3; }
  .capsule strong { font-size: 0.92rem; font-weight: 600; letter-spacing: -0.01em; }
  .capsule span { font-size: 0.8rem; color: var(--slate); }
  .capsule .btn { margin-left: 10px; }

  .engines { max-width: var(--content); margin: 92px auto 0; padding-bottom: 8px; }
  .engines ul { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 34px; margin-top: 18px; }
  .engines li { display: inline-flex; align-items: center; gap: 9px; font-size: 0.95rem; font-weight: 600; letter-spacing: -0.02em; }
  .engines img { width: 22px; height: 22px; }

  @media (max-width: 734px) {
    .hero { padding-top: 44px; }
    .t-hero br { display: none; }
    .stage { margin-top: 44px; margin-inline: calc(-1 * var(--pad) + 12px); }
    .frame-v { border-radius: 20px; }
    .controls { right: 12px; bottom: 12px; }
    .ctl { height: 36px; font-size: 0.78rem; }
    .ctl.round { width: 36px; }
    .capsule { position: static; transform: none; margin: 16px 0 0; white-space: normal; }
    .capsule .btn { margin-left: auto; }
    .engines { margin-top: 52px; }
    .engines ul { gap: 12px 22px; }
  }
</style>

<script>
  import { reduced } from '../lib/motion';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const stage = hero.querySelector<HTMLElement>('.stage')!;
    const frame = hero.querySelector<HTMLElement>('[data-frame]')!;
    const video = hero.querySelector<HTMLVideoElement>('[data-film]')!;
    const toggle = hero.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const calm = reduced() || (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let withSound = false;
    let userPaused = calm;

    const setToggle = () => {
      const paused = video.paused;
      toggle.classList.toggle('paused', paused);
      toggle.setAttribute('aria-label', paused ? 'Play the preview' : 'Pause the preview');
    };
    const preview = () => {
      if (userPaused || withSound) return;
      video.preload = 'auto';
      video.play().then(setToggle).catch(setToggle);
    };
    setToggle();
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) preview();
      else if (!withSound) { video.pause(); setToggle(); }
    }, { threshold: 0.3 }).observe(frame);
    toggle.addEventListener('click', () => {
      if (video.paused) { userPaused = false; preview(); }
      else { userPaused = true; video.pause(); setToggle(); }
    });

    // play the film with sound, from the start or from a highlight
    const watch = (from: number) => {
      withSound = true;
      video.currentTime = from;
      video.muted = false;
      video.loop = false;
      video.controls = true;
      video.preload = 'auto';
      stage.classList.add('is-playing');
      video.play().catch(() => {});
      frame.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'center' });
    };
    document.querySelectorAll<HTMLElement>('[data-watch]').forEach((el) =>
      el.addEventListener('click', () => watch(Number(el.dataset.t || 0))),
    );
    video.addEventListener('ended', () => {
      withSound = false;
      video.controls = false;
      video.muted = true;
      video.loop = true;
      stage.classList.remove('is-playing');
      preview();
    });
  }
</script>
