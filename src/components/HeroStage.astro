---
// Launch hero: product name, one-line statement, then the "product render"
// (two phones showing AI answers that name your brand) with a floating audit
// capsule. "Watch the film" opens the Arrow AI film full screen; any element
// with data-film-open (and optional data-t seconds) does the same.
import Phone from './Phone.astro';
import { ARROW } from '../lib/site';
---
<section class="hero" aria-labelledby="hero-title">
  <p class="launch">New</p>
  <p class="product">Arrow Signal</p>
  <h1 id="hero-title" class="t-hero">Be the answer.</h1>
  <p class="lede">Get your brand named, cited and recommended when buyers ask ChatGPT, Gemini, Perplexity and Claude.</p>
  <button class="play-link" type="button" data-film-open data-t="0">
    <span class="ic"><svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><path d="M0 0v12l10-6z" /></svg></span>Watch the film
  </button>

  <div class="render">
    <Phone kind="chatgpt" class="p1" size={320} label="Illustrative example: a ChatGPT answer that recommends Your Brand and cites yourbrand.com." />
    <Phone kind="perplexity" class="p2" size={320} label="Illustrative example: a Perplexity answer that cites yourbrand.com as its first source." />
  </div>

  <div class="callout">
    <p><strong>Free AI visibility audit</strong><span>From the Arrow AI team. See what AI says about you.</span></p>
    <a class="btn btn-primary btn-sm" href={ARROW.freeAudit}>Get started</a>
  </div>
  <p class="footnote note">Illustrative answers. Real answers vary by assistant, question and date.</p>
</section>

<dialog class="film" data-film-modal aria-label="Arrow AI film">
  <button class="close" type="button" data-film-close aria-label="Close the film">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
  </button>
  <video data-film controls playsinline preload="none" width="1280" height="720" poster="/media/arrow-ai-geo-film-poster.webp" aria-label="Arrow AI film, 36 seconds: SEO ranked you. GEO gets you answered.">
    <source src="/media/arrow-ai-geo-film.webm" type="video/webm" />
    <source src="/media/arrow-ai-geo-film.mp4" type="video/mp4" />
    <track kind="captions" src="/media/arrow-ai-geo-film.en.vtt" srclang="en" label="English" />
  </video>
</dialog>

<style>
  .hero { padding: 64px var(--pad) 0; text-align: center; }
  .launch { font-size: 17px; line-height: 1.47; letter-spacing: -0.022em; margin-bottom: 4px; }
  .product { font-size: 28px; font-weight: 600; line-height: 1.14; letter-spacing: 0.007em; }
  .t-hero { margin-top: 10px; }
  .hero .lede { margin: 18px auto 0; max-width: 560px; }
  .play-link { margin-top: 22px; }

  .render { display: flex; justify-content: center; align-items: flex-start; gap: 36px; margin-top: 64px; }
  .render :global(.p2) { margin-top: 64px; }

  .callout { position: relative; z-index: 2; display: inline-flex; align-items: center; gap: 24px; margin-top: -96px; padding: 14px 14px 14px 24px; border-radius: var(--r-card); background: var(--white); box-shadow: var(--ring); text-align: left; }
  .callout p { display: grid; }
  .callout strong { font-size: 14px; font-weight: 600; line-height: 1.43; letter-spacing: -0.016em; }
  .callout span { font-size: 12px; line-height: 1.33; letter-spacing: -0.01em; color: var(--slate); }
  .note { margin-top: 28px; }

  .film { width: min(1180px, 92vw); max-width: none; max-height: none; margin: auto; padding: 0; border: 0; background: transparent; overflow: visible; }
  .film::backdrop { background: rgba(0, 0, 0, 0.94); }
  .film video { width: 100%; height: auto; border-radius: 18px; background: #000; }
  .close { position: fixed; top: 24px; right: 24px; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: #333336; color: rgba(255, 255, 255, 0.8); transition: background 0.2s; }
  .close:hover { background: #48484a; color: #fff; }
  .close svg { width: 18px; height: 18px; }

  @media (max-width: 1068px) { .render { gap: 24px; } }
  @media (max-width: 734px) {
    .hero { padding-top: 40px; }
    .render { gap: 0; margin-top: 44px; }
    .render :global(.phone) { --w: 186px !important; }
    .render :global(.p2) { margin-top: 36px; margin-left: -26px; }
    .callout { display: flex; margin-top: 24px; gap: 14px; }
    .callout .btn { margin-left: auto; }
  }
</style>

<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-film-modal]');
  const video = modal?.querySelector<HTMLVideoElement>('[data-film]');
  if (modal && video) {
    const close = () => { video.pause(); if (modal.open) modal.close(); };
    document.querySelectorAll<HTMLElement>('[data-film-open]').forEach((el) =>
      el.addEventListener('click', () => {
        modal.showModal();
        video.preload = 'auto';
        video.currentTime = Number(el.dataset.t || 0);
        video.play().catch(() => {});
      }),
    );
    modal.querySelector('[data-film-close]')?.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    modal.addEventListener('close', () => video.pause());
  }
</script>
