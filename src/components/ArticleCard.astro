---
const { article, index = 0 } = Astro.props;
---
<a class="article-card" href={`/blog/${article.slug}/`} data-category={article.category} data-title={article.title.toLowerCase()}>
  <div class:list={['article-art', `art-${index % 4}`]} aria-hidden="true"><div class="art-rings"></div><span class="art-symbol">{index % 4 === 0 ? (<svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg>) : ['◎', '◎', '✳', '⌘'][index % 4]}</span><span class="art-label">ARROW / SIGNAL {String(index + 1).padStart(2, '0')}</span></div>
  <div class="article-card-body"><span class="eyebrow">{article.category} <span class="read-time">/ {article.minutes} MIN READ</span></span><h3>{article.title}</h3><p>{article.description}</p><span class="card-link">Read the signal <span aria-hidden="true"><svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></span></span></div>
</a>
