---
// Scroll-driven line that resolves from noise into a clean signal as the
// reader moves through the method section.
---
<div class="scope" data-scope aria-hidden="true">
  <svg viewBox="0 0 1200 160" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="scope-g" x1="0" x2="1">
        <stop offset="0" stop-color="#9296ad" />
        <stop offset=".45" stop-color="#2563eb" />
        <stop offset="1" stop-color="#655cff" />
      </linearGradient>
    </defs>
    <line x1="0" y1="80" x2="1200" y2="80" class="axis" />
    <path class="trace-glow" d="M0 80 L1200 80" />
    <path class="trace" d="M0 80 L1200 80" />
  </svg>
  <div class="scope-labels mono"><span>Noise</span><span data-scope-readout>Signal lock 0%</span><span>Signal</span></div>
</div>

<style>
  .scope { position: relative; margin: 8px 0 36px; }
  .scope svg { width: 100%; height: clamp(90px, 13vw, 160px); overflow: visible; }
  .axis { stroke: var(--a8); stroke-dasharray: 4 6; }
  .trace { fill: none; stroke: url(#scope-g); stroke-width: 2.2; vector-effect: non-scaling-stroke; }
  .trace-glow { fill: none; stroke: #2563eb; stroke-width: 8; opacity: 0.12; filter: blur(6px); vector-effect: non-scaling-stroke; }
  .scope-labels { display: flex; justify-content: space-between; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); margin-top: 6px; }
  .scope-labels span:nth-child(2) { color: var(--blue); }
</style>

<script>
  import { reducedMotion } from '../lib/reveal';
  document.querySelectorAll<HTMLElement>('[data-scope]').forEach((scope) => {
    const paths = scope.querySelectorAll<SVGPathElement>('path');
    const readout = scope.querySelector<HTMLElement>('[data-scope-readout]');
    const section = scope.closest('section') ?? scope;
    // fixed pseudo-random noise table so the line is stable between frames
    const rnd = Array.from({ length: 241 }, (_, i) => Math.abs(Math.sin(i * 12.9898) * 43758.5453) % 1);
    let phase = 0;
    let lock = 0;
    let target = 0;
    let raf = 0;
    const build = (p: number) => {
      let d = '';
      for (let i = 0; i <= 240; i++) {
        const x = i * 5;
        const xr = i / 240;
        const local = Math.min(1, Math.max(0, p * 1.6 - (1 - xr) * 0.6));
        const noise = (rnd[i] * 2 - 1) * 46 + Math.sin(i * 0.7 + phase * 2) * 10;
        const sig = Math.sin(xr * Math.PI * 10 - phase) * 46;
        const y = 80 + noise * (1 - local) + sig * local;
        d += `${i ? 'L' : 'M'}${x} ${y.toFixed(1)}`;
      }
      return d;
    };
    const frame = () => {
      lock += (target - lock) * 0.08;
      phase += 0.03;
      const d = build(lock);
      paths.forEach((p) => p.setAttribute('d', d));
      if (readout) readout.textContent = `Signal lock ${Math.round(lock * 100)}%`;
      raf = requestAnimationFrame(frame);
    };
    const measure = () => {
      const r = section.getBoundingClientRect();
      const total = r.height + innerHeight * 0.4;
      target = Math.min(1, Math.max(0, (innerHeight * 0.85 - r.top) / total));
    };
    if (reducedMotion()) {
      const d = build(1);
      paths.forEach((p) => p.setAttribute('d', d));
      if (readout) readout.textContent = 'Signal lock 100%';
      return;
    }
    addEventListener('scroll', measure, { passive: true });
    addEventListener('resize', measure);
    measure();
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      if (e.isIntersecting) raf = requestAnimationFrame(frame);
    }).observe(scope);
  });
</script>
