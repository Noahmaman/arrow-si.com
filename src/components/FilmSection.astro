---
import Icon from './Icon.astro';
const chapters = [
  { t: 0, label: '00:00', title: 'SEO is dead.', img: '/media/film-seo-is-dead.webp', alt: 'Film still: the words “SEO is dead.” in white and Arrow blue, struck through by a blue line on a dark field.' },
  { t: 16, label: '00:16', title: 'Enter GEO.', img: '/media/film-enter-geo.webp', alt: 'Film still: “Enter GEO — Generative Engine Optimization” glowing in Arrow blue on a dark night background.' },
  { t: 20, label: '00:20', title: 'Make AI recommend you.', img: '/media/film-make-ai-recommend-you.webp', alt: 'Film still: “Make AI recommend you.” above an AI answer card where a citation names Arrow AI as the most recommended option.' },
  { t: 24, label: '00:24', title: 'Build authority.', img: '/media/film-build-authority.webp', alt: 'Film still: “Build synthetic authority.” with three badges reading Cited, Recommended and Source linked.' },
];
---
<div class="film">
  <div class="film-frame reveal">
    <video
      data-film
      controls
      muted
      playsinline
      loop
      preload="none"
      width="1280"
      height="720"
      poster="/media/arrow-ai-geo-film-poster.webp"
      aria-label="Arrow AI film, 36 seconds: SEO ranked you. GEO gets you answered."
      aria-describedby="film-transcript"
    >
      <source src="/media/arrow-ai-geo-film.webm" type="video/webm" />
      <source src="/media/arrow-ai-geo-film.mp4" type="video/mp4" />
      <track kind="captions" src="/media/arrow-ai-geo-film.en.vtt" srclang="en" label="English" default />
    </video>
  </div>
  <ol class="chapters" aria-label="Film chapters">
    {chapters.map((c, i) => (
      <li class="reveal" style={`--d:${i * 80}ms`}>
        <button type="button" data-seek={c.t} aria-label={`Play the film from ${c.label}: ${c.title}`}>
          <img src={c.img} alt={c.alt} width="1280" height="720" loading="lazy" decoding="async" />
          <span class="c-meta"><span class="mono">{c.label}</span><strong>{c.title}</strong></span>
          <span class="c-play"><Icon name="play" size={12} /></span>
        </button>
      </li>
    ))}
  </ol>
  <details class="transcript" id="film-transcript">
    <summary class="mono">Read the film script</summary>
    <p>SEO is dead. Search used to be a list of links — your brand, one result among ten. Enter GEO: Generative Engine Optimization. Make AI recommend you: when a buyer asks ChatGPT for the best option in your category, the answer names you and cites your page. Build authority — cited, recommended, source linked. The AI era is here: be part of it. Arrow AI — arrow-ai.us.</p>
  </details>
</div>

<style>
  .film { display: grid; gap: 18px; }
  .film-frame {
    position: relative; border-radius: 22px; overflow: hidden; background: #000;
    border: 1px solid var(--n16);
    box-shadow: 0 50px 140px -40px rgba(37, 99, 235, 0.6), 0 0 0 1px rgba(0, 0, 0, 0.6);
  }
  .film-frame video { width: 100%; height: auto; aspect-ratio: 16 / 9; background: #000; }
  .chapters { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .chapters button {
    position: relative; display: block; width: 100%; text-align: left; border-radius: 14px; overflow: hidden;
    border: 1px solid var(--n10); background: var(--night-3);
    transition: transform 0.25s var(--ease), border-color 0.25s;
  }
  .chapters button:hover, .chapters button.is-active { transform: translateY(-2px); border-color: rgba(122, 162, 255, 0.55); }
  .chapters img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; opacity: 0.85; }
  .c-meta { display: grid; gap: 2px; padding: 10px 12px 12px; }
  .c-meta .mono { font-size: 0.66rem; letter-spacing: 0.12em; color: var(--blue-ice); }
  .c-meta strong { font-size: 0.9rem; font-weight: 600; color: var(--night-text); }
  .c-play {
    position: absolute; top: 10px; right: 10px; width: 28px; height: 28px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(4, 6, 14, 0.7); color: #fff; border: 1px solid var(--n24);
  }
  .transcript summary { cursor: pointer; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--night-muted); }
  .transcript p { margin-top: 10px; color: var(--night-muted); max-width: 820px; }
  @media (max-width: 760px) { .chapters { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
  import { reducedMotion } from '../lib/reveal';
  const video = document.querySelector<HTMLVideoElement>('[data-film]');
  if (video) {
    let userPaused = false;
    video.addEventListener('pause', () => { if (!video.ended && document.visibilityState === 'visible' && video.dataset.auto !== 'pausing') userPaused = true; });
    if (!reducedMotion()) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !userPaused) {
          video.preload = 'auto';
          video.play().catch(() => {});
        } else if (!e.isIntersecting && !video.paused) {
          video.dataset.auto = 'pausing';
          video.pause();
          video.dataset.auto = '';
        }
      }, { threshold: 0.5 }).observe(video);
    }
    document.querySelectorAll<HTMLButtonElement>('[data-seek]').forEach((btn) => {
      btn.addEventListener('click', () => {
        userPaused = false;
        video.preload = 'auto';
        video.currentTime = Number(btn.dataset.seek);
        video.play().catch(() => {});
        video.scrollIntoView({ behavior: reducedMotion() ? 'auto' : 'smooth', block: 'center' });
      });
    });
    video.addEventListener('timeupdate', () => {
      const t = video.currentTime;
      document.querySelectorAll<HTMLButtonElement>('[data-seek]').forEach((btn, i, all) => {
        const start = Number(btn.dataset.seek);
        const next = all[i + 1] ? Number(all[i + 1].dataset.seek) : Infinity;
        btn.classList.toggle('is-active', t >= start && t < next);
      });
    });
  }
</script>
