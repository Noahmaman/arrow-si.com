---
// Homepage hero, agency style: a big human headline with the real assistant
// logos, then the Arrow AI film as a showreel (muted preview, play with sound
// on click) with its chapters, then a logo band of the assistants we cover.
import Icon from './Icon.astro';
import { ARROW, SOCIALS, ENGINE_LOGOS } from '../lib/site';

const icons = { LinkedIn: 'linkedin', Instagram: 'instagram', YouTube: 'youtube', TikTok: 'tiktok' } as const;
const stack = ENGINE_LOGOS.slice(0, 4);
const band = ENGINE_LOGOS.filter((l) => l.name !== 'Google AI Mode');
const chapters = [
  { t: 0, end: 16, label: '0:00', title: 'SEO is dead', img: '/media/film-seo-is-dead.webp', alt: 'Film still: the words “SEO is dead.” struck through by a blue line.' },
  { t: 16, end: 20, label: '0:16', title: 'Enter GEO', img: '/media/film-enter-geo.webp', alt: 'Film still: “Enter GEO, Generative Engine Optimization” in Arrow blue.' },
  { t: 20, end: 24, label: '0:20', title: 'Make AI recommend you', img: '/media/film-make-ai-recommend-you.webp', alt: 'Film still: an AI answer card citing Arrow AI as the most recommended option.' },
  { t: 24, end: 36, label: '0:24', title: 'Build authority', img: '/media/film-build-authority.webp', alt: 'Film still: “Build synthetic authority” with Cited, Recommended and Source linked badges.' },
];
---
<section class="rh" aria-labelledby="hero-title" data-reel>
  <div class="rh-top">
    <a class="maker" href={ARROW.url}>
      <img src="/brand/arrow-icon-192.png" alt="Arrow AI logo" width="44" height="44" fetchpriority="high" />
      <span><strong>By Arrow AI</strong><span class="mono">The GEO team behind arrow-ai.us</span></span>
    </a>
    <div class="follow">
      <span class="mono">Follow Arrow</span>
      {SOCIALS.map((s) => (
        <a href={s.url} target="_blank" rel="noopener me" aria-label={`Arrow AI on ${s.name}`} title={`${s.name} ${s.handle}`}><Icon name={icons[s.name]} size={15} /></a>
      ))}
    </div>
  </div>

  <h1 id="hero-title" class="rh-title">
    <span class="ln">Be the <span class="mark">answer<svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M4 16 C 60 6, 120 4, 180 9 S 270 18, 296 7" /></svg></span></span>
    <span class="ln">when buyers ask <span class="stack" aria-hidden="true">{stack.map((l, i) => <img src={l.src} alt="" width="24" height="24" style={`--i:${i}`} />)}</span><span class="sr-only">ChatGPT, Gemini, Perplexity and Claude</span>.</span>
  </h1>

  <div class="rh-row">
    <div>
      <p class="rh-sub">Your buyers ask AI before they ask you, and the answer names two or three brands. <strong>Arrow AI</strong> makes sure yours is one of them. These guides show you how it works.</p>
      <div class="rh-cta">
        <a class="btn btn-heat btn-lg" href={ARROW.freeAudit}>Get your free AI visibility audit <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost btn-lg" href="/blog/">Read the 15 guides</a>
      </div>
    </div>
    <p class="note" aria-hidden="true">
      <span class="mono">The Arrow story<br />in 36 seconds</span>
      <svg viewBox="0 0 120 120" fill="none" aria-hidden="true"><path class="d" pathLength="1" d="M96 8 C 112 44, 92 86, 34 100" /><path class="d h" pathLength="1" d="M48 86 L 32 101 L 52 112" /></svg>
    </p>
  </div>

  <figure class="reel" data-reel-box>
    <div class="reel-frame" data-frame>
      <video data-film muted loop playsinline preload="none" width="1280" height="720" poster="/media/arrow-ai-geo-film-poster.webp" aria-label="Arrow AI film, 36 seconds: SEO ranked you. GEO gets you answered.">
        <source src="/media/arrow-ai-geo-film.webm" type="video/webm" />
        <source src="/media/arrow-ai-geo-film.mp4" type="video/mp4" />
        <track kind="captions" src="/media/arrow-ai-geo-film.en.vtt" srclang="en" label="English" />
      </video>
      <span class="reel-tag mono" aria-hidden="true"><span class="rec"></span>Arrow AI · The film · 0:36</span>
      <button class="reel-play" type="button" data-play aria-label="Play the Arrow AI film with sound (36 seconds)">
        <svg class="ring" viewBox="0 0 120 120" aria-hidden="true">
          <defs><path id="reel-ring" d="M60 60 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0" /></defs>
          <text><textPath href="#reel-ring">Play the film · Sound on · Arrow AI · </textPath></text>
        </svg>
        <span class="tri"><Icon name="play" size={20} /></span>
      </button>
    </div>
    <figcaption class="sr-only">Arrow AI in 36 seconds: SEO ranked you. GEO gets you answered.</figcaption>
    <ol class="reel-chapters" aria-label="Film chapters">
      {chapters.map((c) => (
        <li>
          <button type="button" data-seek={c.t} data-end={c.end} aria-label={`Play from ${c.label}: ${c.title}`}>
            <img src={c.img} alt={c.alt} width="1280" height="720" loading="lazy" decoding="async" />
            <span><span class="mono">{c.label}</span>{c.title}</span>
          </button>
        </li>
      ))}
    </ol>
  </figure>

  <div class="rh-logos">
    <p class="mono lbl">Where your <br />buyers ask</p>
    <div class="marquee">
      <div class="track">
        {[0, 1].map((copy) => (
          <ul aria-hidden={copy === 1 ? 'true' : undefined} aria-label={copy === 0 ? 'AI assistants covered by these guides' : undefined}>
            {band.map((l) => <li><img src={l.src} alt="" width="24" height="24" loading="lazy" />{l.name}</li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .rh { position: relative; padding: clamp(28px, 4vw, 48px) var(--pad) 0; }

  /* maker line + socials */
  .rh-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .maker { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
  .maker img { width: 44px; height: 44px; border-radius: 12px; transform: rotate(-6deg); box-shadow: 0 10px 22px -10px rgba(37, 99, 235, 0.7); transition: transform 0.3s var(--ease); }
  .maker:hover img { transform: rotate(0deg) scale(1.06); }
  .maker strong { display: block; font-size: 1.02rem; letter-spacing: -0.02em; line-height: 1.2; }
  .maker .mono { font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .follow { display: flex; align-items: center; gap: 6px; }
  .follow .mono { font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); margin-right: 6px; }
  .follow a { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--a10); background: var(--bg-card); display: inline-grid; place-items: center; color: var(--ink); transition: transform 0.2s var(--ease), color 0.2s, border-color 0.2s; }
  .follow a:hover { color: var(--geo); border-color: var(--geo); transform: translateY(-2px) rotate(-6deg); }

  /* headline */
  .rh-title { margin-top: clamp(28px, 4.5vw, 52px); font-size: clamp(2.6rem, 7.6vw, 5.9rem); line-height: 0.98; letter-spacing: -0.058em; font-weight: 700; color: var(--ink); text-wrap: initial; }
  .ln { display: block; }
  @media (min-width: 1000px) { .ln { white-space: nowrap; } }
  .mark { position: relative; display: inline-block; white-space: nowrap; color: var(--geo); }
  .mark svg { position: absolute; left: -3%; bottom: -0.16em; width: 106%; height: 0.3em; overflow: visible; }
  .mark path { fill: none; stroke: var(--heat); stroke-width: 7; stroke-linecap: round; stroke-dasharray: 1; }
  .stack { display: inline-flex; vertical-align: -0.06em; margin: 0 0.04em 0 0.1em; }
  .stack img { box-sizing: border-box; width: 0.8em; height: 0.8em; padding: 0.15em; border-radius: 50%; background: #fff; box-shadow: 0 0 0 0.045em var(--bg), 0 12px 24px -12px rgba(18, 20, 40, 0.5); position: relative; z-index: calc(10 - var(--i)); }
  .stack img + img { margin-left: -0.2em; }

  /* sub + ctas */
  .rh-row { margin-top: clamp(26px, 3.4vw, 40px); display: grid; grid-template-columns: 1fr auto; gap: 24px 48px; align-items: end; }
  .rh-sub { max-width: 540px; font-size: clamp(1.04rem, 1.45vw, 1.2rem); line-height: 1.55; color: var(--ink-soft); }
  .rh-sub strong { color: var(--ink); }
  .rh-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .btn-lg { padding: 15px 24px; font-size: 0.98rem; border-radius: 12px; }
  .note { position: relative; display: flex; align-items: flex-start; gap: 4px; margin-right: 2%; margin-bottom: -34px; color: var(--geo); }
  .note .mono { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.5; text-align: right; padding-top: 2px; color: var(--muted); }
  .note svg { width: 104px; height: 104px; }
  .note .d { stroke: var(--geo); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; }

  /* showreel */
  .reel { position: relative; z-index: 1; margin: clamp(30px, 4vw, 44px) calc(14px - var(--pad)) 0; transform: scale(calc(0.93 + 0.07 * var(--p, 1))); transform-origin: 50% 0; }
  .reel-frame { position: relative; aspect-ratio: 16 / 9; border-radius: calc(36px - 16px * var(--p, 1)); overflow: hidden; background: #0b0d1d; box-shadow: 0 60px 110px -60px rgba(18, 20, 40, 0.7), 0 0 0 1px var(--a8); }
  .reel-frame video { width: 100%; height: 100%; object-fit: cover; background: #0b0d1d; }
  .reel-tag { position: absolute; top: 18px; left: 18px; display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; background: rgba(11, 13, 29, 0.55); backdrop-filter: blur(8px); color: rgba(255, 255, 255, 0.9); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; pointer-events: none; transition: opacity 0.3s; }
  .rec { width: 7px; height: 7px; border-radius: 50%; background: var(--heat); animation: rec 1.6s ease-in-out infinite; }
  @keyframes rec { 50% { opacity: 0.3; } }
  .reel-play { position: absolute; left: 50%; top: 50%; width: 136px; height: 136px; margin: -68px 0 0 -68px; border-radius: 50%; background: var(--heat); color: #fff; display: grid; place-items: center; box-shadow: 0 20px 50px -14px rgba(255, 100, 47, 0.7); transform: translate(var(--dx, 0px), var(--dy, 0px)) scale(var(--s, 1)); transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s; }
  .reel-play:hover { --s: 1.08; }
  .ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 14s linear infinite; }
  .ring text { font-family: var(--mono); font-size: 9.4px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; fill: #fff; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .tri { width: 46px; height: 46px; border-radius: 50%; background: #fff; color: var(--heat); display: grid; place-items: center; }
  .tri :global(svg) { margin-left: 3px; }
  .reel.cursor-badge:not(.is-playing) .reel-frame { cursor: none; }
  .reel.is-playing .reel-play, .reel.is-playing .reel-tag { opacity: 0; pointer-events: none; --s: 0.4; }

  .reel-chapters { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 14px; }
  .reel-chapters button { position: relative; width: 100%; display: grid; grid-template-columns: 68px 1fr; gap: 12px; align-items: center; padding: 8px; border-radius: 14px; text-align: left; background: var(--bg-card); border: 1px solid var(--a8); overflow: hidden; transition: border-color 0.2s, transform 0.2s var(--ease); }
  .reel-chapters button:hover, .reel-chapters button.on { border-color: var(--geo); transform: translateY(-2px); }
  .reel-chapters button::after { content: ''; position: absolute; left: 0; bottom: 0; height: 2px; width: calc(var(--prog, 0) * 100%); background: var(--grad); }
  .reel-chapters img { width: 68px; height: 38px; border-radius: 7px; object-fit: cover; }
  .reel-chapters button > span { display: grid; font-size: 0.86rem; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; }
  .reel-chapters .mono { font-size: 0.64rem; font-weight: 500; letter-spacing: 0.08em; color: var(--heat-strong); }

  /* logo band */
  .rh-logos { margin: clamp(40px, 5vw, 60px) calc(-1 * var(--pad)) 0; border-top: 1px solid var(--a6); display: grid; grid-template-columns: auto 1fr; align-items: center; }
  .rh-logos .lbl { padding: 22px var(--pad); font-size: 0.66rem; letter-spacing: 0.14em; line-height: 1.5; text-transform: uppercase; color: var(--faint); border-right: 1px solid var(--a6); white-space: nowrap; }
  .marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
  .track { display: flex; width: max-content; animation: logos 34s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .track ul { list-style: none; display: flex; gap: 48px; padding: 22px 24px 22px 0; margin-left: 24px; }
  .track li { display: inline-flex; align-items: center; gap: 10px; font-size: 1.08rem; font-weight: 600; letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; }
  .track img { width: 26px; height: 26px; }
  @keyframes logos { to { transform: translateX(-50%); } }

  /* entrance: lines rise, logos pop, the orange underline and the arrow draw themselves */
  @keyframes rise { from { opacity: 0; transform: translateY(28px); } }
  @keyframes pop { from { opacity: 0; transform: scale(0.4) rotate(-20deg); } }
  @keyframes draw { from { stroke-dashoffset: 1; } }
  .rh-top { animation: rise 0.9s var(--ease) both; }
  .ln { animation: rise 0.9s var(--ease) 0.06s both; }
  .ln + .ln { animation-delay: 0.14s; }
  .rh-row { animation: rise 0.9s var(--ease) 0.24s both; }
  .stack img { animation: pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(0.55s + var(--i) * 0.09s); }
  .mark path { animation: draw 0.9s var(--ease) 0.6s both; }
  .note .d { animation: draw 1s var(--ease) 0.9s both; }
  .note .d.h { animation-duration: 0.4s; animation-delay: 1.8s; }

  @media (max-width: 900px) {
    .rh-row { grid-template-columns: 1fr; }
    .note { display: none; }
    .reel-chapters { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .follow .mono { display: none; }
    .rh-title { letter-spacing: -0.052em; }
    .reel { margin-inline: calc(8px - var(--pad)); }
    .reel { transform: none; }
    .reel-frame { border-radius: 18px; }
    .reel-play { width: 96px; height: 96px; margin: -48px 0 0 -48px; }
    .tri { width: 36px; height: 36px; }
    .reel-tag { top: 10px; left: 10px; font-size: 0.58rem; }
    .reel-chapters { gap: 8px; }
    .reel-chapters button { grid-template-columns: 1fr; gap: 6px; }
    .reel-chapters img { width: 100%; height: auto; aspect-ratio: 16 / 9; }
    .rh-logos { grid-template-columns: 1fr; }
    .rh-logos .lbl { border-right: 0; border-bottom: 1px solid var(--a6); padding: 14px var(--pad); }
    .rh-logos .lbl br { display: none; }
    .btn-lg { width: 100%; }
  }
</style>

<script>
  import { reduced } from '../lib/motion';
  const hero = document.querySelector<HTMLElement>('[data-reel]');
  if (hero) {
    const box = hero.querySelector<HTMLElement>('[data-reel-box]')!;
    const frame = hero.querySelector<HTMLElement>('[data-frame]')!;
    const video = hero.querySelector<HTMLVideoElement>('[data-film]')!;
    const play = hero.querySelector<HTMLButtonElement>('[data-play]')!;
    const chapters = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-seek]'));
    const calm = reduced() || (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let withSound = false;

    // muted preview loop while the film is on screen
    const preview = () => {
      if (calm || withSound) return;
      video.preload = 'auto';
      video.play().catch(() => {});
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) preview();
      else video.pause();
    }, { threshold: 0.35 }).observe(frame);

    // play with sound, from the start or from a chapter
    const start = (from?: number) => {
      if (!withSound || from !== undefined) video.currentTime = from ?? 0;
      withSound = true;
      video.muted = false;
      video.loop = false;
      video.controls = true;
      video.preload = 'auto';
      box.classList.add('is-playing');
      video.play().catch(() => {});
    };
    play.addEventListener('click', (e) => { e.stopPropagation(); start(); video.focus(); });
    frame.addEventListener('click', () => { if (!withSound) start(); });
    chapters.forEach((b) => b.addEventListener('click', () => {
      start(Number(b.dataset.seek));
      frame.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'center' });
    }));
    video.addEventListener('ended', () => {
      withSound = false;
      video.controls = false;
      video.muted = true;
      video.loop = true;
      box.classList.remove('is-playing');
      preview();
    });
    // chapter progress bars
    video.addEventListener('timeupdate', () => {
      const t = video.currentTime;
      chapters.forEach((b) => {
        const s = Number(b.dataset.seek);
        const end = Number(b.dataset.end);
        const on = t >= s && t < end;
        b.classList.toggle('on', on && withSound);
        b.style.setProperty('--prog', String(Math.max(0, Math.min(1, (t - s) / (end - s)))));
      });
    });

    // the play badge follows the cursor over the film
    if (!reduced() && matchMedia('(pointer: fine)').matches) {
      box.classList.add('cursor-badge');
      frame.addEventListener('pointermove', (e) => {
        const r = frame.getBoundingClientRect();
        play.style.setProperty('--dx', `${e.clientX - r.left - r.width / 2}px`);
        play.style.setProperty('--dy', `${e.clientY - r.top - r.height / 2}px`);
      });
      frame.addEventListener('pointerleave', () => {
        play.style.setProperty('--dx', '0px');
        play.style.setProperty('--dy', '0px');
      });
    }

    // the film grows to full size as it scrolls into view
    if (!reduced()) {
      let ticking = false;
      const grow = () => {
        ticking = false;
        const r = frame.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight * 0.8)));
        box.style.setProperty('--p', p.toFixed(3));
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(grow); } }, { passive: true });
      addEventListener('resize', grow);
      grow();
    }
  }
</script>
