---
// A phone render drawn in CSS, used as the page's "product shot": the screen
// shows an illustrative AI answer (or a search results page for contrast).
interface Props { kind: 'chatgpt' | 'perplexity' | 'search'; label: string; size?: number; class?: string }
const { kind, label, size = 300, class: cls } = Astro.props;
---
<div class:list={['phone', cls]} style={`--w:${size}px`} role="img" aria-label={label}>
  <div class="bezel">
    <div class="screen">
      <span class="island"></span>
      <div class="status"><span>9:41</span><span class="sig"><i></i><i></i><i></i><i></i><b></b></span></div>

      {kind === 'chatgpt' && (
        <div class="app gpt">
          <div class="top"><span class="menu"><i></i><i></i></span><span class="name">ChatGPT</span><span class="dot"></span></div>
          <p class="ask">Best accounting firm for a 20-person startup in Austin?</p>
          <div class="ans">
            <p>For a startup your size, <b>Your Brand</b> is the strongest fit.</p>
            <ul><li>Works mostly with venture-backed teams</li><li>Publishes fixed monthly pricing</li><li>Onboards in under two weeks</li></ul>
            <span class="src"><img src="/brand/arrow-icon-192.png" alt="" width="14" height="14" />yourbrand.com</span>
            <p class="other">Other options: Northwind, Contoso.</p>
            <span class="acts"><i></i><i></i><i></i><i></i></span>
          </div>
          <p class="ask">How much does Your Brand cost?</p>
          <div class="ans"><p>Your Brand lists fixed monthly plans on its pricing page, with setup included.</p></div>
          <div class="bar"><span>Ask anything</span><span class="mic"></span></div>
        </div>
      )}

      {kind === 'perplexity' && (
        <div class="app ppx">
          <div class="top"><img src="/logos/perplexity.svg" alt="" width="18" height="18" /><span class="name">Perplexity</span></div>
          <p class="q">Which GEO agency should a B2B SaaS hire?</p>
          <p class="lbl">Sources</p>
          <div class="srcs">
            <span class="you"><em>1</em>yourbrand.com</span>
            <span><em>2</em>g2.example</span>
            <span><em>3</em>news.example</span>
          </div>
          <p class="lbl">Answer</p>
          <p class="txt"><b>Your Brand</b> stands out for B2B SaaS teams<sup>1</sup>. It runs dated answer checks, publishes clear pricing and shows case studies<sup>2</sup>.</p>
          <p class="lbl">Related</p>
          <ul class="rel"><li>Your Brand vs Northwind</li><li>Is Your Brand good for startups?</li><li>Your Brand pricing</li></ul>
          <div class="bar"><span>Ask follow-up</span><span class="mic"></span></div>
        </div>
      )}

      {kind === 'search' && (
        <div class="app srch">
          <div class="sbox"><img src="/logos/google.svg" alt="" width="16" height="16" /><span>accounting firm austin startup</span></div>
          <ol>
            {['northwind.example', 'contoso.example', 'directory.example', 'fabrikam.example', 'yourbrand.com', 'adatum.example', 'litware.example'].map((d, i) => (
              <li class:list={{ you: d === 'yourbrand.com' }}>
                <span class="d"><i></i>{d}</span>
                <span class="t">{d === 'yourbrand.com' ? 'Your Brand | Startup accounting' : ['Top 10 accounting firms in Austin', 'Contoso CPA | Small business', 'Best accountants near you', 'Fabrikam & Co. accountants', '', 'Adatum tax and payroll', 'Litware bookkeeping'][i]}</span>
                <span class="l"></span>
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>
  </div>
</div>

<style>
  .phone { width: var(--w); aspect-ratio: 300 / 622; padding: calc(var(--w) * 0.012); border-radius: calc(var(--w) * 0.17); background: linear-gradient(145deg, #c7c7cc 0%, #6e6e73 14%, #3a3a3c 40%, #2c2c2e 62%, #8e8e93 88%, #d1d1d6 100%); filter: drop-shadow(0 40px 50px rgba(0, 0, 0, 0.16)); flex-shrink: 0; }
  .bezel { height: 100%; padding: calc(var(--w) * 0.03); border-radius: calc(var(--w) * 0.158); background: #0b0b0c; }
  .screen { position: relative; height: 100%; border-radius: calc(var(--w) * 0.13); background: #fff; overflow: hidden; font-size: calc(var(--w) * 0.044); line-height: 1.42; letter-spacing: -0.01em; color: #0d0d0d; text-align: left; }
  .island { position: absolute; top: 0.75em; left: 50%; width: 30%; height: 1.9em; transform: translateX(-50%); border-radius: 1em; background: #000; z-index: 2; }
  .status { display: flex; justify-content: space-between; align-items: center; padding: 0.9em 1.9em 0; font-size: 1.02em; font-weight: 600; }
  .sig { display: inline-flex; align-items: flex-end; gap: 0.12em; }
  .sig i { width: 0.22em; background: #000; border-radius: 0.06em; }
  .sig i:nth-child(1) { height: 0.35em; } .sig i:nth-child(2) { height: 0.5em; } .sig i:nth-child(3) { height: 0.65em; } .sig i:nth-child(4) { height: 0.8em; }
  .sig b { width: 1.6em; height: 0.8em; margin-left: 0.35em; border-radius: 0.25em; box-shadow: inset 0 0 0 0.09em #000; background: linear-gradient(90deg, #000 70%, transparent 70%) no-repeat 0.15em 50% / calc(100% - 0.3em) 0.5em; }

  .app { position: absolute; inset: 3em 0 0; display: flex; flex-direction: column; padding: 0.4em 1.15em 1.1em; }
  .top { display: flex; align-items: center; justify-content: center; gap: 0.45em; height: 2.4em; position: relative; }
  .name { font-weight: 600; font-size: 1.08em; }
  .menu { position: absolute; left: 0.1em; display: grid; gap: 0.28em; }
  .menu i { display: block; width: 1.05em; height: 0.12em; border-radius: 1em; background: #0d0d0d; }
  .menu i + i { width: 0.7em; }
  .dot { position: absolute; right: 0.2em; width: 1.4em; height: 1.4em; border-radius: 50%; box-shadow: inset 0 0 0 0.12em #0d0d0d; }
  .bar { margin-top: auto; display: flex; justify-content: space-between; align-items: center; padding: 0.75em 0.9em 0.75em 1.1em; border-radius: 2em; box-shadow: inset 0 0 0 0.07em #d9d9d9, 0 0.3em 1em rgba(0, 0, 0, 0.06); color: #8e8e8e; }
  .mic { width: 1.7em; height: 1.7em; border-radius: 50%; background: #0d0d0d; }

  .gpt .ask { align-self: flex-end; max-width: 80%; margin-top: 1em; padding: 0.65em 0.95em; border-radius: 1.3em; background: #f2f2f2; }
  .gpt .ans { margin-top: 1.1em; display: grid; gap: 0.55em; }
  .gpt ul { padding-left: 1.1em; display: grid; gap: 0.2em; }
  .gpt b, .ppx b { font-weight: 700; }
  .src { justify-self: start; display: inline-flex; align-items: center; gap: 0.4em; padding: 0.3em 0.7em 0.3em 0.35em; border-radius: 1em; background: #f2f2f2; font-size: 0.85em; color: #5d5d5d; }
  .src img { width: 1.2em; height: 1.2em; border-radius: 0.3em; }
  .other { color: #5d5d5d; }
  .acts { display: flex; gap: 0.7em; }
  .acts i { width: 1em; height: 1em; border-radius: 0.25em; box-shadow: inset 0 0 0 0.1em #8e8e8e; }

  .ppx .top { justify-content: flex-start; }
  .ppx .top img { width: 1.35em; height: 1.35em; }
  .ppx .q { margin-top: 0.6em; font-size: 1.42em; font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; }
  .ppx .lbl { margin-top: 1em; font-size: 0.82em; font-weight: 600; color: #5d5d5d; }
  .srcs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4em; margin-top: 0.45em; }
  .srcs span { display: grid; gap: 0.2em; padding: 0.5em; border-radius: 0.7em; background: #f3f3ee; font-size: 0.72em; color: #5d5d5d; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .srcs em { font-style: normal; font-weight: 600; color: #0d0d0d; }
  .srcs .you { background: #e9eefc; color: #1d4fd7; }
  .ppx .txt { margin-top: 0.45em; }
  .ppx sup { font-size: 0.65em; font-weight: 600; color: #1d4fd7; margin-left: 0.1em; }
  .rel { list-style: none; margin-top: 0.3em; }
  .rel li { display: flex; justify-content: space-between; padding: 0.55em 0; border-top: 0.06em solid #e5e5e0; }
  .rel li::after { content: '+'; color: #1d4fd7; font-weight: 600; }

  .srch .sbox { display: flex; align-items: center; gap: 0.6em; margin-top: 0.6em; padding: 0.75em 1em; border-radius: 2em; box-shadow: inset 0 0 0 0.07em #dadce0; font-size: 0.95em; }
  .srch .sbox img { width: 1.2em; height: 1.2em; }
  .srch ol { list-style: none; margin-top: 0.9em; display: grid; gap: 0.95em; }
  .srch li { display: grid; gap: 0.15em; opacity: 0.55; }
  .srch .d { display: flex; align-items: center; gap: 0.45em; font-size: 0.78em; color: #4d5156; }
  .srch .d i { width: 1.15em; height: 1.15em; border-radius: 50%; background: #e8eaed; }
  .srch .t { font-size: 1em; color: #1a0dab; }
  .srch .l { height: 0.45em; width: 88%; border-radius: 0.3em; background: #eceef1; }
  .srch li.you { opacity: 1; }
  .srch li.you .d i { background: #2563eb; }
</style>
