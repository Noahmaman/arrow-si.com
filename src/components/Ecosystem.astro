---
import Icon from './Icon.astro';
import { ECOSYSTEM } from '../lib/site';
const [signal, ...others] = ECOSYSTEM;
---
<div class="eco">
  <figure class="eco-map reveal">
    <svg viewBox="0 0 520 440" role="img" aria-labelledby="eco-title eco-desc">
      <title id="eco-title">The Arrow ecosystem signal map</title>
      <desc id="eco-desc">Arrow Signal at arrow-si.com sits at the centre and sends signal to Arrow AI at arrow-ai.us, Arrow Answers at answers.arrow-ai.us and the GEO demo at arrow-ai.tech.</desc>
      <defs>
        <radialGradient id="eco-core" cx=".5" cy=".5" r=".5">
          <stop offset="0" stop-color="#5b8cff" stop-opacity=".55" />
          <stop offset="1" stop-color="#2563eb" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="eco-line" x1="0" x2="1"><stop offset="0" stop-color="#2563eb" /><stop offset="1" stop-color="#655cff" /></linearGradient>
      </defs>
      <circle cx="260" cy="220" r="190" class="orbit" />
      <circle cx="260" cy="220" r="128" class="orbit" />
      <circle cx="260" cy="220" r="66" class="orbit" />
      <circle cx="260" cy="220" r="120" fill="url(#eco-core)" />
      <path id="eco-a" class="link" d="M260 220 C 210 160 150 120 92 92" />
      <path id="eco-b" class="link" d="M260 220 C 320 160 380 120 430 96" />
      <path id="eco-c" class="link" d="M260 220 C 262 290 262 330 262 372" />
      <circle r="4" class="pulse"><animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="#eco-a" /></animateMotion></circle>
      <circle r="4" class="pulse"><animateMotion dur="2.6s" begin=".9s" repeatCount="indefinite"><mpath href="#eco-b" /></animateMotion></circle>
      <circle r="4" class="pulse"><animateMotion dur="2.6s" begin="1.7s" repeatCount="indefinite"><mpath href="#eco-c" /></animateMotion></circle>
      <g class="node core">
        <circle cx="260" cy="220" r="44" />
        <image href="/brand/arrow-icon-192.png" x="236" y="196" width="48" height="48" clip-path="inset(0 round 12px)" />
      </g>
      <g class="node"><circle cx="92" cy="92" r="9" /><text x="92" y="66" text-anchor="middle">arrow-ai.us</text></g>
      <g class="node"><circle cx="430" cy="96" r="9" /><text x="430" y="70" text-anchor="middle">answers.arrow-ai.us</text></g>
      <g class="node"><circle cx="262" cy="372" r="9" /><text x="262" y="408" text-anchor="middle">arrow-ai.tech</text></g>
      <text x="260" y="292" text-anchor="middle" class="core-label">arrow-si.com</text>
    </svg>
  </figure>
  <div class="eco-list">
    <div class="eco-item is-here reveal">
      <span class="mono eco-role">{signal.role}</span>
      <h3 class="h-card">{signal.name} <span class="mono host">{signal.host}</span></h3>
      <p>{signal.line}</p>
    </div>
    {others.map((item, i) => (
      <a class="eco-item reveal" href={item.url} style={`--d:${(i + 1) * 90}ms`}>
        <span class="mono eco-role">{item.role}</span>
        <h3 class="h-card">{item.name} <span class="mono host">{item.host}</span></h3>
        <p>{item.line}</p>
        <span class="eco-go"><Icon name="arrow" size={18} /></span>
      </a>
    ))}
  </div>
</div>

<style>
  .eco { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .eco-map svg { width: 100%; height: auto; overflow: visible; }
  .orbit { fill: none; stroke: var(--a8); stroke-dasharray: 2 6; }
  .link { fill: none; stroke: url(#eco-line); stroke-width: 1.6; opacity: 0.55; }
  .pulse { fill: #2563eb; filter: drop-shadow(0 0 6px rgba(37, 99, 235, 0.9)); }
  .node circle { fill: #fff; stroke: #2563eb; stroke-width: 2; }
  .node.core circle { fill: #fff; stroke: url(#eco-line); stroke-width: 2.5; filter: drop-shadow(0 10px 30px rgba(37, 99, 235, 0.35)); }
  .node text, .core-label { font-family: var(--mono); font-size: 12.5px; letter-spacing: 0.04em; fill: var(--ink-soft); }
  .core-label { fill: var(--blue); font-weight: 600; }
  .eco-list { display: grid; gap: 12px; }
  .eco-item {
    position: relative; display: block; padding: 20px 56px 20px 22px; border-radius: var(--r-lg); text-decoration: none;
    background: #fff; border: 1px solid var(--a8);
    transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.3s;
  }
  a.eco-item:hover { transform: translateX(4px); border-color: rgba(37, 99, 235, 0.35); box-shadow: 0 16px 40px -20px rgba(37, 99, 235, 0.4); }
  .eco-item.is-here { background: linear-gradient(120deg, rgba(37, 99, 235, 0.08), rgba(101, 92, 255, 0.06)); border-color: rgba(37, 99, 235, 0.25); }
  .eco-role { font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); }
  .eco-item h3 { margin-top: 6px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .host { font-size: 0.74rem; font-weight: 400; color: var(--faint); letter-spacing: 0.02em; }
  .eco-item p { margin-top: 6px; color: var(--muted); font-size: 0.95rem; }
  .eco-go { position: absolute; right: 20px; top: 50%; transform: translateY(-50%); color: var(--blue); }
  @media (max-width: 860px) { .eco { grid-template-columns: 1fr; } .eco-map { max-width: 460px; margin: 0 auto; } }
  @media (prefers-reduced-motion: reduce) { .pulse { display: none; } }
</style>
