---
// Illustrative AI visibility dashboard (sample data, clearly labelled).
const sov = [
  { name: 'Your brand', value: 34, you: true },
  { name: 'Competitor A', value: 27 },
  { name: 'Competitor B', value: 21 },
  { name: 'Others', value: 18 },
];
const prompts = [
  { q: 'best GEO agency for SaaS', s: ['c', 'r', 'm', 'c'] },
  { q: 'how to appear in ChatGPT answers', s: ['c', 'c', 'm', 'n'] },
  { q: 'AI visibility audit cost', s: ['r', 'm', 'c', 'm'] },
  { q: 'GEO vs SEO for B2B', s: ['m', 'n', 'c', 'c'] },
  { q: 'track brand mentions in Gemini', s: ['n', 'c', 'm', 'r'] },
];
const legend = { c: 'Cited', r: 'Recommended', m: 'Mentioned', n: 'Absent' } as const;
const sources = [
  { url: 'yourbrand.com/pricing', n: 14 },
  { url: 'yourbrand.com/guides/geo', n: 11 },
  { url: 'industry-review.example', n: 8 },
  { url: 'community-forum.example', n: 5 },
];
// sparkline points (illustrative weekly signal score)
const pts = [41, 44, 43, 49, 52, 51, 58, 61, 60, 66, 70, 72];
const sx = (i: number) => (i / (pts.length - 1)) * 300;
const sy = (v: number) => 90 - ((v - 35) / 45) * 80;
const line = pts.map((v, i) => `${i ? 'L' : 'M'}${sx(i).toFixed(1)} ${sy(v).toFixed(1)}`).join(' ');
const area = `${line} L300 96 L0 96 Z`;
---
<div class="dash" role="group" aria-label="Illustrative AI visibility dashboard with sample data">
  <article class="panel p-score reveal">
    <header><span class="p-label mono">AI visibility score</span><span class="chip is-ok">▲ 31 pts</span></header>
    <div class="big"><span data-count="72">72</span><small>/100</small></div>
    <svg class="spark" viewBox="0 0 300 96" preserveAspectRatio="none" role="img" aria-label="Sample trend line: the visibility score rises from 41 to 72 over twelve weeks.">
      <defs>
        <linearGradient id="spark-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2563eb" stop-opacity=".45" /><stop offset="1" stop-color="#2563eb" stop-opacity="0" /></linearGradient>
        <linearGradient id="spark-line" x1="0" x2="1"><stop offset="0" stop-color="#5b8cff" /><stop offset="1" stop-color="#655cff" /></linearGradient>
      </defs>
      <path d={area} fill="url(#spark-fill)" class="spark-area" />
      <path d={line} fill="none" stroke="url(#spark-line)" stroke-width="2.2" class="spark-line" pathLength="1" vector-effect="non-scaling-stroke" />
    </svg>
    <p class="p-foot mono">12 weekly answer checks</p>
  </article>

  <article class="panel p-sov reveal" style="--d:80ms">
    <header><span class="p-label mono">Share of voice · “best GEO agency”</span></header>
    <ul class="bars">
      {sov.map((b) => (
        <li class:list={{ you: b.you }}>
          <span class="b-name">{b.name}</span>
          <span class="b-track"><span class="b-fill" style={`--w:${b.value}%`}></span></span>
          <span class="b-val mono">{b.value}%</span>
        </li>
      ))}
    </ul>
    <p class="p-foot mono">Share of brand mentions across sampled answers</p>
  </article>

  <article class="panel p-prompts reveal" style="--d:160ms">
    <header><span class="p-label mono">Buyer-question panel</span><span class="chip">4 engines</span></header>
    <table>
      <caption class="sr-only">Sample buyer questions and whether each AI engine cites, recommends, mentions or omits the brand.</caption>
      <thead><tr><th scope="col">Question</th><th scope="col">GPT</th><th scope="col">Gem</th><th scope="col">Pplx</th><th scope="col">Cld</th></tr></thead>
      <tbody>
        {prompts.map((p) => (
          <tr>
            <th scope="row">{p.q}</th>
            {p.s.map((s) => <td><span class:list={['dot', `is-${s}`]} title={legend[s as keyof typeof legend]}><span class="sr-only">{legend[s as keyof typeof legend]}</span></span></td>)}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="legend mono">
      <span><i class="dot is-c"></i>Cited</span><span><i class="dot is-r"></i>Recommended</span><span><i class="dot is-m"></i>Mentioned</span><span><i class="dot is-n"></i>Absent</span>
    </p>
  </article>

  <article class="panel p-sources reveal" style="--d:240ms">
    <header><span class="p-label mono">Most-cited sources</span></header>
    <ol>
      {sources.map((s, i) => (
        <li><span class="mono s-rank">0{i + 1}</span><span class="s-url">{s.url}</span><span class="s-bar" style={`--w:${(s.n / 14) * 100}%`}></span><span class="mono s-n">{s.n}×</span></li>
      ))}
    </ol>
    <p class="p-foot mono">Where answers get their facts</p>
  </article>

  <article class="panel p-accuracy reveal" style="--d:320ms">
    <header><span class="p-label mono">Answer accuracy</span></header>
    <ul class="checks">
      <li><span class="chip is-ok">Correct</span> Core offer &amp; category</li>
      <li><span class="chip is-ok">Correct</span> Locations served</li>
      <li><span class="chip warn">Outdated</span> Pricing from 2024</li>
    </ul>
  </article>
</div>

<style>
  .dash { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; }
  .panel {
    position: relative; border-radius: 18px; padding: 20px 22px; min-width: 0;
    background: linear-gradient(180deg, rgba(21, 29, 56, 0.75), rgba(8, 12, 27, 0.85));
    border: 1px solid var(--n10); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    overflow: hidden;
  }
  .panel::after {
    content: ''; position: absolute; inset: -1px; border-radius: inherit; pointer-events: none;
    background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 0%), rgba(91, 140, 255, 0.14), transparent 50%);
    opacity: 0; transition: opacity 0.3s;
  }
  .panel:hover::after { opacity: 1; }
  .panel header { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 16px; }
  .p-label { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--night-muted); }
  .p-foot { margin-top: 12px; font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--night-faint); }
  .p-score { grid-column: span 2; }
  .p-sov { grid-column: span 4; }
  .p-prompts { grid-column: span 3; }
  .p-sources { grid-column: span 3; }
  .p-accuracy { grid-column: span 6; }
  .big { display: flex; align-items: baseline; gap: 4px; }
  .big span { font-size: clamp(3rem, 6vw, 4.4rem); font-weight: 600; letter-spacing: -0.05em; line-height: 1; background: var(--grad-signal); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .big small { color: var(--night-faint); font-size: 1rem; }
  .spark { width: 100%; height: 86px; margin-top: 12px; overflow: visible; }
  .spark-line { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 2s var(--ease) 0.3s; filter: drop-shadow(0 0 6px rgba(91, 140, 255, 0.8)); }
  .spark-area { opacity: 0; transition: opacity 1.2s ease 1.2s; }
  .is-in .spark-line { stroke-dashoffset: 0; }
  .is-in .spark-area { opacity: 1; }
  .bars { list-style: none; display: grid; gap: 14px; }
  .bars li { display: grid; grid-template-columns: 120px 1fr 48px; align-items: center; gap: 14px; font-size: 0.92rem; color: var(--night-muted); }
  .bars li.you { color: #fff; font-weight: 600; }
  .b-track { height: 12px; border-radius: 99px; background: rgba(150, 175, 255, 0.08); overflow: hidden; }
  .b-fill { display: block; height: 100%; width: 0; border-radius: inherit; background: rgba(150, 175, 255, 0.35); transition: width 1.4s var(--ease) 0.2s; }
  .you .b-fill { background: var(--grad-signal); box-shadow: 0 0 16px rgba(91, 140, 255, 0.7); }
  .is-in .b-fill { width: var(--w); }
  .b-val { text-align: right; font-size: 0.84rem; }
  table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  thead th { font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--night-faint); font-weight: 500; text-align: center; padding: 0 4px 10px; }
  thead th:first-child { text-align: left; }
  tbody th { text-align: left; font-weight: 500; color: var(--night-text); padding: 9px 8px 9px 0; border-top: 1px solid var(--n6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 0; width: 56%; }
  tbody td { text-align: center; border-top: 1px solid var(--n6); padding: 9px 4px; }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; vertical-align: middle; }
  .dot.is-c { background: #3ddc97; box-shadow: 0 0 10px rgba(61, 220, 151, 0.6); }
  .dot.is-r { background: #5b8cff; box-shadow: 0 0 10px rgba(91, 140, 255, 0.7); }
  .dot.is-m { background: transparent; border: 2px solid #a9c1ff; }
  .dot.is-n { background: rgba(150, 175, 255, 0.16); }
  .legend { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 14px; font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--night-faint); }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend .dot { width: 8px; height: 8px; }
  .p-sources ol { list-style: none; display: grid; gap: 12px; }
  .p-sources li { display: grid; grid-template-columns: 26px 1fr 42px; grid-template-rows: auto 6px; column-gap: 10px; row-gap: 6px; align-items: center; font-size: 0.9rem; }
  .s-rank { color: var(--night-faint); font-size: 0.72rem; grid-column: 1; grid-row: 1 / span 2; }
  .s-url { grid-column: 2; grid-row: 1; color: var(--night-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .s-n { text-align: right; color: var(--night-muted); font-size: 0.8rem; grid-column: 3; grid-row: 1 / span 2; }
  .s-bar { height: 4px; border-radius: 99px; width: 0; background: linear-gradient(90deg, #2563eb, #655cff); transition: width 1.3s var(--ease) 0.3s; grid-column: 2; grid-row: 2; }
  .is-in .s-bar { width: var(--w); }
  :global(.no-js) .b-fill, :global(.no-js) .s-bar { width: var(--w); }
  :global(.no-js) .spark-line { stroke-dashoffset: 0; }
  :global(.no-js) .spark-area { opacity: 1; }
  .checks { list-style: none; display: flex; flex-wrap: wrap; gap: 12px 32px; color: var(--night-text); font-size: 0.95rem; }
  .checks li { display: inline-flex; align-items: center; gap: 10px; }
  .chip.warn { color: #ffb08f; border-color: rgba(255, 100, 47, 0.4); background: rgba(255, 100, 47, 0.1); }
  @media (max-width: 960px) {
    .p-score, .p-sov, .p-prompts, .p-sources { grid-column: span 6; }
  }
  @media (max-width: 560px) {
    .panel { padding: 18px 16px; }
    .bars li { grid-template-columns: 92px 1fr 40px; gap: 10px; font-size: 0.85rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.dash .panel').forEach((panel) => {
    panel.addEventListener('pointermove', (e) => {
      const r = panel.getBoundingClientRect();
      panel.style.setProperty('--mx', `${e.clientX - r.left}px`);
      panel.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
