---
// "Get the highlights": a horizontally advancing set of large media cards on
// the mist band, built from the Arrow AI film, with dots and a pause control.
const cards = [
  { cap: 'Search still matters. But the answer now shows up before the links.', img: '/media/film-seo-is-dead.webp', alt: 'Film still: the words “SEO is dead.” struck through by a blue line.', dark: true, bg: '#07060b', t: 0 },
  { cap: 'GEO is the name for the work of getting into those answers.', img: '/media/film-enter-geo.webp', alt: 'Film still: “Enter GEO, Generative Engine Optimization” in Arrow blue.', dark: true, bg: '#0b0d18', t: 16 },
  { cap: 'Being listed is a start. Being the one it suggests is the goal.', img: '/media/film-make-ai-recommend-you.webp', alt: 'Film still: an AI answer card citing Arrow AI as the most recommended option.', dark: false, bg: '#edecf2', t: 20 },
  { cap: 'AI leans on what others say about you: reviews, articles, directories.', img: '/media/film-build-authority.webp', alt: 'Film still: “Build synthetic authority” with Cited, Recommended and Source linked badges.', dark: false, bg: '#edecf2', t: 24 },
];
const total = cards.length;
---
<section class="section mist hls" id="highlights" aria-labelledby="hls-title" data-hls>
  <div class="head-row">
    <h2 id="hls-title" class="h-section">The short version.</h2>
    <button class="play-link" type="button" data-film-open data-t="0">
      <span class="ic"><svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><path d="M0 0v12l10-6z" /></svg></span>Watch the film
    </button>
  </div>
  <ul class="track" data-track aria-label="Highlights">
    {cards.map((c, i) => (
      <li class:list={['card', { dark: c.dark }]} style={`background:${c.bg}`} aria-label={`${i + 1} of ${total}`}>
        <p class="t-card cap">{c.cap}</p>
        <button class="play-link watch" type="button" data-film-open data-t={c.t}>Watch this part</button>
        <img src={c.img} alt={c.alt} width="1280" height="720" loading="lazy" decoding="async" />
      </li>
    ))}
  </ul>
  <div class="ctrls">
    <div class="dots" data-dots>
      {Array.from({ length: total }, (_, i) => <button type="button" aria-label={`Show highlight ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}><i></i></button>)}
    </div>
    <button class="pp" type="button" data-pp aria-label="Pause the highlights">
      <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.6" height="14" rx="1" /><rect x="13.9" y="5" width="3.6" height="14" rx="1" /></svg>
      <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
    </button>
  </div>
</section>

<style>
  .hls { padding-left: 0; padding-right: 0; overflow: hidden; }
  .hls .head-row { padding: 0 var(--gutter); }
  .track { list-style: none; display: flex; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); padding: 0 var(--gutter); scrollbar-width: none; }
  .track::-webkit-scrollbar { display: none; }
  .card { flex: 0 0 min(980px, 86vw); scroll-snap-align: start; display: flex; flex-direction: column; border-radius: var(--r-card); background: var(--white); overflow: hidden; }
  .card.dark { background: #000; }
  .cap { padding: 48px 52px 0; max-width: 640px; }
  .card.dark .cap { color: #f5f5f7; }
  .watch { align-self: flex-start; margin: 14px 52px 0; font-size: 17px; }
  .card.dark .watch { color: #4f8bff; }
  .card > img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; margin-top: auto; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%); mask-image: linear-gradient(to bottom, transparent, #000 18%); }

  .ctrls { display: flex; justify-content: center; gap: 12px; margin-top: 32px; }
  .dots, .pp { height: 56px; border-radius: 36px; background: rgba(210, 210, 215, 0.64); backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px); }
  .dots { display: flex; align-items: center; gap: 2px; padding: 0 16px; }
  .dots button { width: 18px; height: 32px; display: grid; place-items: center; transition: width 0.4s var(--ease); }
  .dots i { position: relative; display: block; width: 8px; height: 8px; border-radius: 8px; background: rgba(0, 0, 0, 0.42); overflow: hidden; transition: width 0.4s var(--ease), background 0.3s; }
  .dots button[aria-current='true'] { width: 56px; }
  .dots button[aria-current='true'] i { width: 48px; background: rgba(0, 0, 0, 0.24); }
  .dots i::after { content: ''; position: absolute; inset: 0; width: 0; background: rgba(0, 0, 0, 0.56); }
  .dots button[aria-current='true'] i::after { width: calc(var(--p, 1) * 100%); }
  .pp { width: 56px; display: grid; place-items: center; color: rgba(0, 0, 0, 0.56); }
  .pp:hover { color: #000; }
  .pp svg { width: 20px; height: 20px; }
  .pp .i-play { display: none; }
  .pp.paused .i-play { display: block; }
  .pp.paused .i-pause { display: none; }

  @media (max-width: 734px) {
    .cap { padding: 32px 28px 0; }
    .watch { margin: 12px 28px 0; }
  }
</style>

<script>
  import { reduced } from '../lib/motion';
  document.querySelectorAll<HTMLElement>('[data-hls]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const cards = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dots] button'));
    const pp = root.querySelector<HTMLButtonElement>('[data-pp]')!;
    const DURATION = 6000;
    let index = 0;
    let progress = 0;
    let paused = reduced();
    let visible = false;
    let last = 0;

    const mark = (i: number) => {
      index = i;
      dots.forEach((d, j) => (j === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };
    const go = (i: number) => {
      const n = (i + cards.length) % cards.length;
      progress = 0;
      mark(n);
      track.scrollTo({ left: cards[n].offsetLeft - cards[0].offsetLeft, behavior: reduced() ? 'auto' : 'smooth' });
    };
    const setPaused = (p: boolean) => {
      paused = p;
      pp.classList.toggle('paused', p);
      pp.setAttribute('aria-label', p ? 'Play the highlights' : 'Pause the highlights');
      dots[index].style.setProperty('--p', p ? '1' : String(progress));
    };
    setPaused(paused);
    dots.forEach((d, i) => d.addEventListener('click', () => { go(i); setPaused(true); }));
    pp.addEventListener('click', () => setPaused(!paused));

    // keep the dots in step when the user swipes
    let t = 0;
    track.addEventListener('scroll', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        const x = track.scrollLeft;
        const i = cards.reduce((best, c, j) => (Math.abs(c.offsetLeft - cards[0].offsetLeft - x) < Math.abs(cards[best].offsetLeft - cards[0].offsetLeft - x) ? j : best), 0);
        if (i !== index) { progress = 0; mark(i); }
      }, 120);
    }, { passive: true });
    track.addEventListener('pointerdown', () => setPaused(true));

    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(track);
    const loop = (now: number) => {
      const dt = last ? now - last : 0;
      last = now;
      if (visible && !paused) {
        progress += dt / DURATION;
        dots[index].style.setProperty('--p', String(Math.min(1, progress)));
        if (progress >= 1) go(index + 1);
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  });
</script>
