---
// "Animated beam" diagram: the Arrow properties feed Arrow AI, which works on
// getting your brand into AI answers.
import { ARROW, ANSWERS, DEMO } from '../lib/site';
const left = [
  { y: 18, label: 'arrow-si.com', sub: 'Guides' },
  { y: 50, label: 'answers.arrow-ai.us', sub: 'Answers' },
  { y: 82, label: 'arrow-ai.tech', sub: 'GEO demo' },
];
const right = [
  { y: 22, label: 'ChatGPT' },
  { y: 50, label: 'Gemini · Perplexity' },
  { y: 78, label: 'AI Overviews' },
];
const curve = (x1: number, y1: number, x2: number, y2: number) => `M${x1} ${y1} C ${(x1 + x2) / 2} ${y1}, ${(x1 + x2) / 2} ${y2}, ${x2} ${y2}`;
const cards = [
  { name: 'Arrow AI', host: 'arrow-ai.us', url: ARROW.url, d: 'The team behind this site. GEO, AI systems and AI Studio for businesses.', cta: 'Visit Arrow AI' },
  { name: 'Arrow Answers', host: 'answers.arrow-ai.us', url: ANSWERS.url, d: 'Short answers to more than a hundred specific GEO questions.', cta: 'Browse the answers' },
  { name: 'GEO demo', host: 'arrow-ai.tech', url: DEMO.url, d: 'An interactive walkthrough from a website to a cited AI answer.', cta: 'Try the demo' },
];
---
<figure class="beam-wrap reveal" aria-labelledby="beam-cap">
  <figcaption id="beam-cap" class="sr-only">Diagram: Arrow Signal, Arrow Answers and the GEO demo connect to Arrow AI, which connects your brand to ChatGPT, Gemini, Perplexity and Google AI Overviews.</figcaption>
  <svg class="beams" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="beam-g" x1="0" x2="1"><stop offset="0" stop-color="#2563eb" stop-opacity="0" /><stop offset=".5" stop-color="#655cff" /><stop offset="1" stop-color="#ff642f" stop-opacity="0" /></linearGradient>
    </defs>
    {left.map((n, i) => (
      <>
        <path class="track" d={curve(22, n.y, 50, 50)} />
        <path class="beam" d={curve(22, n.y, 50, 50)} pathLength="100" style={`--delay:${i * 0.6}s`} />
      </>
    ))}
    {right.map((n, i) => (
      <>
        <path class="track" d={curve(50, 50, 78, n.y)} />
        <path class="beam" d={curve(50, 50, 78, n.y)} pathLength="100" style={`--delay:${1.2 + i * 0.6}s`} />
      </>
    ))}
  </svg>
  {left.map((n) => <span class="node left" style={`top:${n.y}%`}><span class="mono">{n.sub}</span>{n.label}</span>)}
  <span class="hub"><img src="/brand/arrow-icon-192.png" alt="" width="44" height="44" /><span>Arrow AI</span></span>
  {right.map((n) => <span class="node right" style={`top:${n.y}%`}>{n.label}<span class="mono">your brand cited</span></span>)}
</figure>
<ul class="eco">
  {cards.map((c, i) => (
    <li class="reveal" style={`--d:${i * 80}ms`}>
      <a href={c.url} data-spot>
        <span class="host mono">{c.host}</span>
        <h3>{c.name}</h3>
        <p>{c.d}</p>
        <span class="link">{c.cta} <span class="arr" aria-hidden="true">→</span></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .beam-wrap { position: relative; height: 340px; border-radius: var(--r-lg); background: var(--bg-card); border: 1px solid var(--a8); overflow: hidden; }
  .beam-wrap::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(var(--a8) 1px, transparent 1px); background-size: 20px 20px; mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 30%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 30%, transparent 80%); }
  .beams { position: absolute; inset: 0; width: 100%; height: 100%; }
  .track { fill: none; stroke: var(--a10); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .beam { fill: none; stroke: url(#beam-g); stroke-width: 2.5; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-dasharray: 18 82; stroke-dashoffset: 100; animation: travel 3s linear infinite; animation-delay: var(--delay); }
  @keyframes travel { to { stroke-dashoffset: 0; } }
  .node { position: absolute; transform: translateY(-50%); display: grid; gap: 1px; padding: 8px 12px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--a10); font-size: 0.86rem; font-weight: 600; color: var(--ink); box-shadow: 0 6px 18px -12px rgba(18, 20, 40, 0.35); white-space: nowrap; }
  .node .mono { font-size: 0.6rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); }
  .node.left { right: 78%; }
  .node.right { left: 78%; }
  .hub { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: grid; justify-items: center; gap: 8px; font-weight: 700; font-size: 0.9rem; }
  .hub img { width: 64px; height: 64px; padding: 10px; border-radius: 18px; background: var(--bg-card); border: 1px solid var(--a10); box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.06), 0 14px 30px -14px rgba(37, 99, 235, 0.5); }
  .eco { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 14px; }
  .eco a { position: relative; display: flex; flex-direction: column; height: 100%; padding: 22px; border-radius: var(--r-lg); background: var(--bg-card); border: 1px solid var(--a8); text-decoration: none; overflow: hidden; transition: transform 0.25s var(--ease), box-shadow 0.25s; }
  .eco a::before { content: ''; position: absolute; inset: 0; background: radial-gradient(360px circle at var(--mx, 50%) var(--my, -20%), rgba(255, 100, 47, 0.07), transparent 60%); pointer-events: none; }
  .eco a:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -24px rgba(18, 20, 40, 0.35); }
  .host { font-size: 0.7rem; letter-spacing: 0.06em; color: var(--faint); }
  .eco h3 { margin-top: 6px; font-size: 1.15rem; letter-spacing: -0.02em; }
  .eco p { margin-top: 6px; font-size: 0.93rem; color: var(--muted); flex: 1; }
  .eco .link { margin-top: 14px; font-size: 0.9rem; }
  @media (max-width: 760px) {
    .beam-wrap { height: 300px; }
    .node { font-size: 0.72rem; padding: 6px 8px; }
    .node .mono { display: none; }
    .node.left { right: auto; left: 8px; }
    .node.right { left: auto; right: 8px; }
    .hub img { width: 52px; height: 52px; }
    .eco { grid-template-columns: 1fr; }
  }
</style>
