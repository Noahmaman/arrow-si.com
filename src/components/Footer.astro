---
import Icon from './Icon.astro';
import { ARROW, ANSWERS, DEMO, SOCIALS } from '../lib/site';
const year = new Date().getFullYear();
const icons = { LinkedIn: 'linkedin', Instagram: 'instagram', YouTube: 'youtube', TikTok: 'tiktok' } as const;
const path = Astro.url.pathname;
const page = path.startsWith('/blog/') && path !== '/blog/' ? 'Guide' : path.startsWith('/blog') ? 'Guides' : path.startsWith('/glossary') ? 'Glossary' : path.startsWith('/about') ? 'About' : path.startsWith('/privacy') ? 'Privacy' : null;
---
<footer class="site-footer">
  <div class="inner">
    <div class="foot-notes">
      <p>Examples on this site that use made-up companies or data are labelled as examples. AI companies control their own answers, so no guide here guarantees a mention, citation or recommendation.</p>
      <p>ChatGPT, Gemini, Perplexity, Claude, Copilot and Google are trademarks of their owners. Arrow AI is not affiliated with them. Arrow AI (arrow-ai.us) is independent from Arrow Electronics and other companies named Arrow.</p>
    </div>
    <nav class="foot-crumbs" aria-label="You are here">
      <a href={ARROW.url} aria-label="Arrow AI"><img src="/brand/arrow-icon-192.png" alt="" width="18" height="18" loading="lazy" /></a>
      <span class="sep" aria-hidden="true">›</span>
      <a href="/">Arrow Signal</a>
      {page && <><span class="sep" aria-hidden="true">›</span><span>{page}</span></>}
    </nav>
    <div class="foot-cols">
      <div>
        <h2>Guides</h2>
        <ul>
          <li><a href="/blog/">All 15 guides</a></li>
          <li><a href="/blog/what-is-ai-visibility/">What is AI visibility?</a></li>
          <li><a href="/blog/how-to-measure-ai-visibility/">Measuring AI visibility</a></li>
          <li><a href="/blog/geo-vs-seo/">GEO vs SEO</a></li>
          <li><a href="/glossary/">Glossary</a></li>
        </ul>
      </div>
      <div>
        <h2>Arrow ecosystem</h2>
        <ul>
          <li><a href={ARROW.url}>Arrow AI</a></li>
          <li><a href={ARROW.geo}>GEO service</a></li>
          <li><a href={ANSWERS.url}>Arrow Answers</a></li>
          <li><a href={DEMO.url}>GEO demo</a></li>
          <li><a href={ARROW.pricing}>GEO pricing</a></li>
        </ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/about/">About this site</a></li>
          <li><a href={ARROW.freeAudit}>Free audit</a></li>
          <li><a href={ARROW.call}>Book a call</a></li>
          <li><a href={ARROW.contact}>Contact</a></li>
        </ul>
      </div>
      <div>
        <h2>Follow Arrow AI</h2>
        <ul class="soc">
          {SOCIALS.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener me" title={`${s.name} ${s.handle}`}><Icon name={icons[s.name]} size={13} />{s.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="foot-legal">
      <span>Copyright © {year} Arrow AI. All rights reserved.</span>
      <nav aria-label="Legal">
        <a href="/privacy/">Privacy</a>
        <a href="/about/">About</a>
        <a href="/feed.xml">RSS</a>
        <a href="/llms.txt">llms.txt</a>
      </nav>
      <span>arrow-si.com</span>
    </div>
  </div>
</footer>
