---
// Illustrative "answer scan" console for the hero. Sample data only — it is
// labelled as an illustration and never presented as a live measurement.
import Icon from './Icon.astro';

const wave = (amp: number, freq: number, width = 240, h = 24) => {
  let d = `M0 ${h / 2}`;
  for (let x = 0; x <= width; x += 2) d += ` L${x} ${(h / 2 + Math.sin((x / width) * Math.PI * 2 * freq) * amp).toFixed(2)}`;
  return d;
};
const noisy = (width = 240, h = 24) => {
  let d = `M0 ${h / 2}`;
  for (let x = 0; x <= width; x += 3) {
    const y = h / 2 + Math.sin(x * 0.9) * 2.5 + Math.sin(x * 2.3) * 2 + Math.sin(x * 0.31) * 1.5;
    d += ` L${x} ${y.toFixed(2)}`;
  }
  return d;
};
const clean = wave(8, 4);
const rough = noisy();
const engines = [
  { name: 'ChatGPT', status: 'Cited', tone: 'ok' },
  { name: 'Gemini', status: 'Recommended', tone: 'ok' },
  { name: 'Perplexity', status: 'Source linked', tone: 'ok' },
  { name: 'Claude', status: 'Mentioned', tone: 'blue' },
  { name: 'AI Overviews', status: 'Not cited yet', tone: 'muted' },
];
---
<div class="console" role="img" aria-label="Illustrative Arrow Signal answer scan. A buyer asks AI engines which GEO partner a B2B SaaS team should hire. ChatGPT cites the example brand, Gemini recommends it, Perplexity links its source, Claude mentions it and Google AI Overviews does not cite it yet. The example signal score reads 87 out of 100." data-console>
  <div class="console-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="console-title mono">arrow / signal — answer scan</span>
    <span class="chip">Illustrative</span>
  </div>
  <div class="console-body">
    <div class="console-main">
      <div class="prompt mono">
        <span class="caret">›</span>
        <span class="typed" data-typed>Which GEO partner should a B2B SaaS team hire?</span><span class="cursor"></span>
      </div>
      <ul class="engines">
        {engines.map((e, i) => (
          <li class="engine is-locked" data-engine style={`--i:${i}`} data-tone={e.tone}>
            <span class="e-name">{e.name}</span>
            <span class="e-wave" aria-hidden="true">
              <svg viewBox="0 0 240 24" preserveAspectRatio="none" aria-hidden="true"><path class="w-noise" d={rough} /><path class="w-clean" d={clean} /></svg>
            </span>
            <span class:list={['chip', 'e-status', { 'is-ok': e.tone === 'ok', 'is-blue': e.tone === 'blue' }]} data-status>{e.status}{e.tone === 'ok' && <Icon name="check" size={11} />}</span>
          </li>
        ))}
      </ul>
      <div class="console-foot mono">
        <span><span class="live-dot" aria-hidden="true"></span> 5 engines · 1 buyer question</span>
        <span data-scan-label>Scan complete</span>
      </div>
    </div>
    <aside class="console-side">
      <div class="score">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <defs>
            <linearGradient id="score-g" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#5b8cff" />
              <stop offset="1" stop-color="#655cff" />
            </linearGradient>
          </defs>
          <circle cx="60" cy="60" r="50" class="ring-bg" />
          <circle cx="60" cy="60" r="50" class="ring" data-ring pathLength="100" style="--v:87" />
        </svg>
        <div class="score-num"><strong data-score>87</strong><span>/100</span></div>
        <span class="score-label mono">Signal score</span>
      </div>
      <div class="answer">
        <span class="answer-label mono"><Icon name="spark" size={10} /> Citation detected</span>
        <p>“For this category, <mark>Your Brand</mark> is the most recommended option…”</p>
        <div class="answer-src mono"><span>[1] yourbrand.com/geo</span><span>[2] review-site.example</span></div>
      </div>
    </aside>
  </div>
</div>

<style>
  .console {
    position: relative; border-radius: 20px; overflow: hidden; text-align: left;
    background: linear-gradient(180deg, rgba(16, 22, 44, 0.92), rgba(6, 9, 20, 0.96));
    border: 1px solid rgba(150, 175, 255, 0.16);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4), 0 40px 120px -30px rgba(37, 99, 235, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    color: var(--night-text);
  }
  .console::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(122, 162, 255, 0.8), transparent);
  }
  .console-bar { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border-bottom: 1px solid var(--n10); }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.14); }
  .dots i:first-child { background: #ff642f; }
  .console-title { font-size: 0.74rem; color: var(--night-muted); letter-spacing: 0.04em; flex: 1; }
  .console-body { display: grid; grid-template-columns: 1.55fr 1fr; }
  .console-main { padding: 20px 22px 18px; border-right: 1px solid var(--n10); min-width: 0; }
  .prompt {
    display: flex; align-items: center; gap: 10px; padding: 13px 14px; border-radius: 12px;
    background: rgba(255, 255, 255, 0.03); border: 1px solid var(--n10); font-size: 0.86rem; min-height: 48px;
  }
  .caret { color: var(--blue-light); }
  .typed { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cursor { width: 7px; height: 16px; background: var(--blue-light); animation: blink 1s steps(1) infinite; flex-shrink: 0; }
  @keyframes blink { 50% { opacity: 0; } }
  .engines { list-style: none; margin-top: 14px; display: grid; gap: 4px; }
  .engine {
    display: grid; grid-template-columns: 104px 1fr auto; align-items: center; gap: 14px;
    padding: 9px 10px; border-radius: 10px; transition: background 0.4s ease;
  }
  .engine:hover { background: rgba(255, 255, 255, 0.03); }
  .e-name { font-size: 0.9rem; font-weight: 500; }
  .e-wave { height: 24px; overflow: hidden; position: relative; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .e-wave svg { width: 200%; height: 100%; animation: scroll 2.6s linear infinite; animation-delay: calc(var(--i) * -0.4s); }
  .e-wave path { fill: none; stroke-width: 1.5; vector-effect: non-scaling-stroke; transition: opacity 0.6s ease; }
  .w-noise { stroke: rgba(150, 175, 255, 0.35); opacity: 1; }
  .w-clean { stroke: #5b8cff; opacity: 0; filter: drop-shadow(0 0 4px rgba(91, 140, 255, 0.8)); }
  .engine.is-locked .w-noise { opacity: 0; }
  .engine.is-locked .w-clean { opacity: 1; }
  .engine[data-tone='muted'] .w-clean { stroke: rgba(150, 175, 255, 0.45); filter: none; }
  .engine[data-tone='blue'] .w-clean { stroke: #a9c1ff; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  .e-status { min-width: 0; white-space: nowrap; }
  .console-foot { display: flex; justify-content: space-between; gap: 12px; margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--n10); font-size: 0.7rem; color: var(--night-faint); letter-spacing: 0.06em; text-transform: uppercase; }
  .console-foot span:first-child { display: inline-flex; align-items: center; gap: 8px; }
  .console-side { padding: 20px 22px; display: flex; flex-direction: column; gap: 16px; }
  .score { position: relative; display: grid; place-items: center; padding: 6px 0 2px; }
  .score svg { width: 150px; height: 150px; transform: rotate(-90deg); }
  .ring-bg { fill: none; stroke: rgba(150, 175, 255, 0.1); stroke-width: 7; }
  .ring {
    fill: none; stroke: url(#score-g); stroke-width: 7; stroke-linecap: round;
    stroke-dasharray: 100; stroke-dashoffset: calc(100 - var(--v));
    transition: stroke-dashoffset 1.6s var(--ease); filter: drop-shadow(0 0 6px rgba(91, 140, 255, 0.7));
  }
  .score-num { position: absolute; top: 50px; display: flex; align-items: baseline; gap: 2px; }
  .score-num strong { font-size: 2.5rem; font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .score-num span { color: var(--night-faint); font-size: 0.9rem; }
  .score-label { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--night-muted); margin-top: 6px; }
  .answer { border-radius: 14px; padding: 14px 16px; background: #fbfbfe; color: var(--ink); box-shadow: 0 14px 40px -12px rgba(0, 0, 0, 0.6); }
  .answer-label { display: inline-flex; align-items: center; gap: 6px; font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); }
  .answer p { margin-top: 8px; font-size: 0.93rem; line-height: 1.45; }
  .answer mark { background: var(--heat); color: #fff; padding: 0 5px; border-radius: 4px; }
  .answer-src { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 10px; font-size: 0.64rem; color: var(--faint); letter-spacing: 0.04em; }
  @media (max-width: 860px) {
    .console-body { grid-template-columns: 1fr; }
    .console-main { border-right: 0; border-bottom: 1px solid var(--n10); }
    .console-side { flex-direction: row; align-items: center; }
    .score svg { width: 112px; height: 112px; }
    .score-num { top: 34px; }
    .score-num strong { font-size: 1.9rem; }
    .answer { flex: 1; }
  }
  @media (max-width: 560px) {
    .console-main { padding: 16px 14px; }
    .engine { grid-template-columns: 86px 1fr auto; gap: 8px; padding: 8px 4px; }
    .e-name { font-size: 0.82rem; }
    .console-side { flex-direction: column; padding: 16px 14px; }
    .console-title { font-size: 0.66rem; }
    .console-foot span:last-child { display: none; }
  }
</style>

<script>
  import { reducedMotion } from '../lib/reveal';

  type Scenario = { prompt: string; results: [string, string][]; score: number };
  const scenarios: Scenario[] = [
    {
      prompt: 'Which GEO partner should a B2B SaaS team hire?',
      results: [['Cited', 'ok'], ['Recommended', 'ok'], ['Source linked', 'ok'], ['Mentioned', 'blue'], ['Not cited yet', 'muted']],
      score: 87,
    },
    {
      prompt: 'How do I get my brand cited by ChatGPT?',
      results: [['Source linked', 'ok'], ['Mentioned', 'blue'], ['Cited', 'ok'], ['Cited', 'ok'], ['Mentioned', 'blue']],
      score: 79,
    },
    {
      prompt: 'Best AI visibility audit for a clinic in Miami?',
      results: [['Recommended', 'ok'], ['Cited', 'ok'], ['Mentioned', 'blue'], ['Not cited yet', 'muted'], ['Source linked', 'ok']],
      score: 82,
    },
  ];

  const check = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.2 4.2L19 7"/></svg>';

  document.querySelectorAll<HTMLElement>('[data-console]').forEach((root) => {
    if (reducedMotion()) return;
    const typed = root.querySelector<HTMLElement>('[data-typed]')!;
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-engine]'));
    const ring = root.querySelector<SVGCircleElement>('[data-ring]')!;
    const score = root.querySelector<HTMLElement>('[data-score]')!;
    const label = root.querySelector<HTMLElement>('[data-scan-label]')!;
    let index = 0;
    let timers: number[] = [];
    let visible = false;
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));

    const run = () => {
      timers.forEach(clearTimeout); timers = [];
      const s = scenarios[index % scenarios.length];
      index++;
      rows.forEach((r) => { r.classList.remove('is-locked'); const st = r.querySelector<HTMLElement>('[data-status]')!; st.className = 'chip e-status'; st.textContent = 'Scanning…'; });
      ring.style.setProperty('--v', '0');
      score.textContent = '0';
      label.textContent = 'Scanning answers…';
      typed.textContent = '';
      let c = 0;
      const typeNext = () => {
        typed.textContent = s.prompt.slice(0, ++c);
        if (c < s.prompt.length) later(typeNext, 28 + Math.random() * 30);
        else lockAll();
      };
      const lockAll = () => {
        rows.forEach((row, i) => later(() => {
          const [text, tone] = s.results[i];
          row.dataset.tone = tone;
          row.classList.add('is-locked');
          const st = row.querySelector<HTMLElement>('[data-status]')!;
          st.className = `chip e-status${tone === 'ok' ? ' is-ok' : tone === 'blue' ? ' is-blue' : ''}`;
          st.innerHTML = text + (tone === 'ok' ? check : '');
        }, 380 + i * 420));
        later(() => {
          ring.style.setProperty('--v', String(s.score));
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / 1400);
            score.textContent = String(Math.round(s.score * (1 - Math.pow(1 - t, 3))));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          label.textContent = 'Scan complete';
        }, 380 + rows.length * 420);
        later(() => visible && run(), 380 + rows.length * 420 + 4800);
      };
      later(typeNext, 500);
    };

    new IntersectionObserver(([e]) => {
      const was = visible;
      visible = e.isIntersecting;
      if (visible && !was) run();
      if (!visible) { timers.forEach(clearTimeout); timers = []; }
    }, { threshold: 0.35 }).observe(root);
  });
</script>
