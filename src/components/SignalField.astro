---
// Animated background: Arrow-blue signal lines that tighten from noise into a
// clean waveform around the centre of the hero. Decorative only.
interface Props { class?: string; lines?: number; mode?: 'hero' | 'calm' }
const { class: className = '', lines = 22, mode = 'hero' } = Astro.props;
---
<canvas class:list={['signal-field', className]} data-signal-field data-lines={lines} data-mode={mode} aria-hidden="true"></canvas>

<style>
  .signal-field { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>

<script>
  import { reducedMotion } from '../lib/reveal';

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const lines = Number(canvas.dataset.lines || 22);
    const calm = canvas.dataset.mode === 'calm';
    let w = 0, h = 0, dpr = 1, raf = 0, running = false, t = 0;
    const pointer = { x: 0.5, y: 0.45, tx: 0.5, ty: 0.45 };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.6);
      const r = canvas.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    // Deterministic pseudo-noise so the "noise" side looks organic, not random flicker.
    const noise = (x: number, s: number) => Math.sin(x * 1.7 + s) * 0.5 + Math.sin(x * 3.9 + s * 1.3) * 0.3 + Math.sin(x * 7.3 + s * 0.7) * 0.2;

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      pointer.x += (pointer.tx - pointer.x) * 0.05;
      pointer.y += (pointer.ty - pointer.y) * 0.05;
      const mid = h * (calm ? 0.5 : 0.42);
      const spread = h * (calm ? 0.5 : 0.62);
      for (let i = 0; i < lines; i++) {
        const k = i / (lines - 1);
        const offset = (k - 0.5) * spread;
        const dist = Math.abs(k - 0.5) * 2; // 0 centre → 1 edge
        const alpha = (1 - dist) * 0.55 + 0.06;
        const grad = ctx.createLinearGradient(0, 0, w, 0);
        grad.addColorStop(0, `rgba(37,99,235,0)`);
        grad.addColorStop(0.3, `rgba(91,140,255,${alpha})`);
        grad.addColorStop(0.7, `rgba(101,92,255,${alpha * 0.9})`);
        grad.addColorStop(1, `rgba(101,92,255,0)`);
        ctx.strokeStyle = grad;
        ctx.lineWidth = dist < 0.12 ? 1.6 : 1;
        ctx.beginPath();
        const steps = Math.max(60, Math.round(w / 9));
        for (let s = 0; s <= steps; s++) {
          const xr = s / steps;
          const x = xr * w;
          // signal lock: left side noisy, right side converges into a clean wave
          const lock = Math.min(1, Math.max(0, (xr - 0.12) / 0.6));
          const pd = Math.hypot(xr - pointer.x, (mid + offset) / h - pointer.y);
          const lift = Math.max(0, 0.22 - pd) * 160;
          const clean = Math.sin(xr * 10 - t * 1.1 + i * 0.18) * (10 + (1 - dist) * 26);
          const rough = noise(xr * 9 + i, t * 0.9 + i) * (18 + dist * 30);
          const y = mid + offset * (1 - lock * 0.82) + clean * lock + rough * (1 - lock) + Math.sin(xr * 6 + t) * lift * (1 - dist);
          s === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
      t += calm ? 0.008 : 0.012;
    };

    const loop = () => { draw(); raf = requestAnimationFrame(loop); };
    const play = () => { if (!running && !reducedMotion()) { running = true; loop(); } };
    const pause = () => { running = false; cancelAnimationFrame(raf); };

    resize();
    draw();
    new ResizeObserver(() => { resize(); draw(); }).observe(canvas);
    new IntersectionObserver(([e]) => (e.isIntersecting ? play() : pause())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
    const host = canvas.parentElement;
    host?.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      pointer.tx = (e.clientX - r.left) / r.width;
      pointer.ty = (e.clientY - r.top) / r.height;
    });
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-signal-field]').forEach(start);
</script>
