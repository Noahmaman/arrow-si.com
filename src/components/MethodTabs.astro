---
// Four-step method as auto-advancing tabs (sample visuals).
const steps = [
  { id: 'baseline', t: 'Baseline the answers', d: 'Run 20 to 50 real buyer questions on the AI tools your customers use. Save every answer with its date and sources.', href: '/blog/how-to-measure-ai-visibility/', link: 'Build a baseline' },
  { id: 'access', t: 'Fix access and facts', d: 'Let AI crawlers reach your pages, and describe your business the same way on your site, profiles and directories.', href: '/blog/technical-ai-visibility-checklist/', link: 'Technical checklist' },
  { id: 'publish', t: 'Publish answer pages', d: 'Answer pricing, comparison and “is this right for me” questions directly, with evidence AI tools can cite.', href: '/blog/content-ai-engines-cite/', link: 'Write citable pages' },
  { id: 'measure', t: 'Measure every month', d: 'Re-run the same questions, track share of voice and citations, and pick what to fix next.', href: '/blog/ai-share-of-voice/', link: 'Track share of voice' },
];
const bars = [12, 17, 24, 31];
---
<div class="tabs" data-tabs>
  <div class="tab-list" role="tablist" aria-label="The Arrow method">
    {steps.map((s, i) => (
      <button class="tab" role="tab" type="button" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="t-n mono">0{i + 1}</span>
        <span class="t-body"><strong>{s.t}</strong><span class="t-d">{s.d}</span></span>
        <span class="t-bar" aria-hidden="true"><i></i></span>
      </button>
    ))}
  </div>
  <div class="panels">
    <div class="panel" role="tabpanel" id="panel-baseline" aria-labelledby="tab-baseline" tabindex="0">
      <div class="p-head mono"><span>buyer questions</span><span class="eng-logos"><img src="/logos/chatgpt.svg" alt="ChatGPT" width="14" height="14" loading="lazy" /><img src="/logos/gemini.svg" alt="Gemini" width="14" height="14" loading="lazy" /><img src="/logos/perplexity.svg" alt="Perplexity" width="14" height="14" loading="lazy" /></span></div>
      <ul class="qs">
        <li><span>best accounting firm for startups in Austin</span><span class="dots"><i class="ok"></i><i class="ok"></i><i></i></span></li>
        <li><span>fixed-fee bookkeeping for SaaS</span><span class="dots"><i class="ok"></i><i></i><i class="ok"></i></span></li>
        <li><span>outsourced CFO vs accountant</span><span class="dots"><i></i><i></i><i class="ok"></i></span></li>
        <li><span>yourbrand pricing</span><span class="dots"><i class="ok"></i><i class="ok"></i><i class="ok"></i></span></li>
      </ul>
      <p class="p-foot mono">dated · saved with sources · repeated monthly</p>
    </div>
    <div class="panel" role="tabpanel" id="panel-access" aria-labelledby="tab-access" tabindex="0" hidden>
      <div class="p-head mono"><span>access & facts check</span><span>yourbrand.com</span></div>
      <ul class="checks">
        <li><span>OAI-SearchBot allowed</span><span class="chip ok">pass</span></li>
        <li><span>PerplexityBot allowed</span><span class="chip ok">pass</span></li>
        <li><span>Key pages indexed in Google and Bing</span><span class="chip ok">pass</span></li>
        <li><span>Prices visible in the HTML</span><span class="chip heat">fix</span></li>
        <li><span>Same description on site and profiles</span><span class="chip ok">pass</span></li>
      </ul>
    </div>
    <div class="panel" role="tabpanel" id="panel-publish" aria-labelledby="tab-publish" tabindex="0" hidden>
      <div class="p-head mono"><span>answer page</span><span>/pricing</span></div>
      <div class="page">
        <strong>How much does Your Brand cost?</strong>
        <p class="short"><span class="mono">short answer</span> From $490 a month, billed monthly. Setup takes three to five weeks.</p>
        <span class="line w90"></span><span class="line w75"></span><span class="line w82"></span>
        <div class="faq-mini mono"><span>FAQ</span><span>sources</span><span>updated Oct 2026</span></div>
      </div>
    </div>
    <div class="panel" role="tabpanel" id="panel-measure" aria-labelledby="tab-measure" tabindex="0" hidden>
      <div class="p-head mono"><span>share of voice</span><span>sample data</span></div>
      <div class="chart">
        {bars.map((v, i) => (
          <div class="col"><span class="val mono">{v}%</span><span class="bar" style={`--h:${v * 2.6}%`}></span><span class="m mono">{['Jul', 'Aug', 'Sep', 'Oct'][i]}</span></div>
        ))}
      </div>
    </div>
    <div class="links">
      {steps.map((s, i) => <a class="link" href={s.href} data-link={i} hidden={i !== 0}>{s.link} <span class="arr" aria-hidden="true">›</span></a>)}
    </div>
  </div>
</div>

<style>
  .tabs { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 40px; align-items: start; }
  .tab-list { display: grid; }
  .tab { position: relative; display: grid; grid-template-columns: 40px 1fr; gap: 8px; text-align: left; padding: 22px 0; border-top: 1px solid var(--hairline); }
  .tab:last-child { border-bottom: 1px solid var(--hairline); }
  .t-n { font-family: var(--mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.1em; color: var(--steel); padding-top: 4px; }
  .tab[aria-selected='true'] .t-n { color: var(--blue); }
  .t-body strong { display: block; font-size: 1.2rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.25; color: var(--slate); transition: color 0.2s; }
  .tab:hover strong, .tab[aria-selected='true'] strong { color: var(--ink); }
  .t-d { display: block; margin-top: 8px; color: var(--slate); max-height: 0; overflow: hidden; opacity: 0; transition: max-height 0.5s var(--ease), opacity 0.3s; }
  .tab[aria-selected='true'] .t-d { max-height: 140px; opacity: 1; }
  .t-bar { position: absolute; left: 0; right: 0; top: -1px; height: 2px; }
  .t-bar i { display: block; height: 100%; width: 0; background: var(--blue); }
  .tab[aria-selected='true'] .t-bar i { width: var(--p, 0%); }

  .panels { position: relative; border-radius: var(--r-card); padding: 32px; min-height: 380px; background: var(--white); }
  .panel { animation: fade 0.5s var(--ease); }
  .panel:focus-visible { outline-offset: 6px; }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .p-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); padding-bottom: 14px; margin-bottom: 14px; border-bottom: 1px solid var(--control); }
  .p-foot { margin-top: 14px; font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--steel); }
  .qs, .checks { list-style: none; display: grid; gap: 1px; border-radius: 16px; overflow: hidden; background: var(--control); }
  .qs li, .checks li { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 13px 16px; background: var(--mist); font-size: 0.93rem; }
  .eng-logos { display: inline-flex; gap: 5px; margin-right: 13.5px; }
  .eng-logos img { width: 14px; height: 14px; }
  .dots { display: inline-flex; gap: 10px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--hairline); }
  .dots i.ok { background: var(--blue); }
  .page { padding: 18px; border-radius: 16px; background: var(--mist); display: grid; gap: 12px; }
  .page strong { font-size: 1.1rem; letter-spacing: -0.02em; }
  .short { font-size: 0.93rem; padding: 12px 14px; border-radius: 12px; background: var(--white); }
  .short .mono { display: block; font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue); margin-bottom: 2px; }
  .line { display: block; height: 8px; border-radius: 4px; background: var(--control); }
  .w90 { width: 90%; } .w75 { width: 75%; } .w82 { width: 82%; }
  .faq-mini { display: flex; gap: 14px; font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--slate); }
  .chart { height: 240px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; align-items: end; padding: 8px 6px 0; }
  .col { display: flex; flex-direction: column; align-items: center; gap: 8px; height: 100%; justify-content: flex-end; }
  .bar { width: 100%; max-width: 64px; height: var(--h); border-radius: 10px 10px 4px 4px; background: var(--hairline); animation: grow 0.9s var(--ease) both; }
  .col:last-child .bar { background: var(--blue); }
  @keyframes grow { from { height: 0; } }
  .val { font-size: 0.75rem; font-weight: 600; }
  .m { font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--steel); }
  .links { margin-top: 20px; }
  @media (max-width: 900px) { .tabs { grid-template-columns: 1fr; gap: 24px; } }
  @media (max-width: 734px) { .panels { padding: 22px; min-height: 0; } }
</style>

<script>
  import { reduced } from '../lib/motion';
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    const links = Array.from(root.querySelectorAll<HTMLElement>('[data-link]'));
    let current = 0;
    let progress = 0;
    let paused = false;
    let visible = false;
    let last = 0;
    const DURATION = 6500;
    const select = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      progress = 0;
      tabs.forEach((t, j) => {
        const on = j === current;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
        links[j].hidden = !on;
        t.style.setProperty('--p', '0%');
      });
      if (focus) tabs[current].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { select(i); paused = true; });
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); select(current + 1, true); paused = true; }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); select(current - 1, true); paused = true; }
      });
    });
    if (reduced()) return;
    root.addEventListener('pointerenter', () => (paused = true));
    root.addEventListener('pointerleave', () => (paused = false));
    root.addEventListener('focusin', () => (paused = true));
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.3 }).observe(root);
    const loop = (now: number) => {
      const dt = last ? now - last : 0;
      last = now;
      if (visible && !paused) {
        progress += dt / DURATION;
        tabs[current].style.setProperty('--p', `${Math.min(100, progress * 100)}%`);
        if (progress >= 1) select(current + 1);
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  });
</script>
