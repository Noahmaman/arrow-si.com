---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles, publicationDate } from '../../data/articles';
export function getStaticPaths() { return articles.map(article => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props;
const current = articles.findIndex(entry => entry.slug === article.slug);
const related = [articles[(current + 1) % articles.length], articles[(current + 2) % articles.length], articles[(current + 3) % articles.length]];
const url = `https://arrow-si.com/blog/${article.slug}/`;
const sectionId = (index: number) => `section-${index + 1}`;
const schema = { '@type': 'Article', headline: article.title, description: article.description, image: 'https://arrow-si.com/og.png', datePublished: publicationDate, dateModified: publicationDate, mainEntityOfPage: url, author: { '@type': 'Organization', name: 'Arrow Signal Editorial', url: 'https://arrow-si.com/blog/' }, publisher: { '@id': 'https://arrow-si.com/#organization' }, articleSection: article.category, inLanguage: 'en' };
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://arrow-si.com/' }, { '@type': 'ListItem', position: 2, name: 'Journal', item: 'https://arrow-si.com/blog/' }, { '@type': 'ListItem', position: 3, name: article.title, item: url }] };
---
<Layout title={`${article.title} | Arrow Signal`} description={article.description} schema={schema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g, '\\u003c')} />
  <article>
    <header class="section article-header"><nav aria-label="Breadcrumb" class="breadcrumbs"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog/">Journal</a><span aria-hidden="true">/</span><span>{article.category}</span></nav><span class="eyebrow">{article.category} / THE SIGNAL JOURNAL</span><h1>{article.title}</h1><p class="article-deck">{article.description}</p><div class="article-meta"><span class="byline-mark" aria-hidden="true"><svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></span><span>Arrow Signal Editorial</span><span>·</span><time datetime={publicationDate}>October 13, 2026</time><span>·</span><span>{article.minutes} min read</span></div></header>
    <div class="section article-layout"><aside class="article-toc"><span class="eyebrow">IN THIS SIGNAL</span><a href="#takeaway">The direct answer</a>{article.sections.map((section, index) => <a href={`#${sectionId(index)}`}>{section.heading}</a>)}<a href="#checklist">Your next steps</a><a href="#sources">Source notes</a><a class="back-link" href="/blog/">← All signals</a></aside><div class="article-content"><section id="takeaway" class="takeaway"><span class="eyebrow">THE DIRECT ANSWER</span><p>{article.takeaway}</p></section>{article.sections.map((section, index) => <section id={sectionId(index)}><h2>{section.heading}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}<section id="checklist" class="checklist"><span class="eyebrow">TURN INSIGHT INTO ACTION</span><h2>Your next steps</h2><ul>{article.checklist.map(item => <li>{item}</li>)}</ul></section><section id="sources" class="source-notes"><h2>Source notes & further reading</h2><p>These primary references support the technical and editorial context. The practical recommendations above are Arrow Signal’s editorial interpretation, not platform guarantees.</p><ul>{article.sources.map(source => <li><a href={source.url}>{source.title} <span aria-hidden="true"><svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></span></a></li>)}</ul></section><div class="article-share"><span class="eyebrow">SHARE THIS SIGNAL</span><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer">LinkedIn <svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></a><a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener noreferrer">X <svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></a><button id="copy-link" data-url={url}>Copy link</button><span id="copy-status" role="status"></span></div></div></div>
  </article>
  <section class="article-cta section"><div><span class="eyebrow">CONTINUE YOUR DIRECTION</span><h2>Follow the signal<br />into the <span class="serif">Arrow ecosystem.</span></h2></div><div class="article-cta-links"><a href="https://arrow-ai.us/">Explore Arrow AI <svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></a><a href="https://answers.arrow-ai.us/">Continue to Arrow Answers <svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></a><a href="https://arrow-ai.tech/">Explore Arrow AI Tech <svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></a></div></section>
  <section class="section related-section"><div class="journal-heading"><h2>Your next <span class="serif blue">signal.</span></h2><a href="/blog/" class="text-link">All 15 articles <svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></a></div><div class="articles-grid">{related.map((entry, index) => <ArticleCard article={entry} index={index} />)}</div></section>
  <script>
    document.querySelector<HTMLButtonElement>('#copy-link')?.addEventListener('click', async event => {
      const button = event.currentTarget as HTMLButtonElement;
      const status = document.querySelector('#copy-status');
      try { await navigator.clipboard.writeText(button.dataset.url || location.href); if (status) status.textContent = 'Link copied.'; }
      catch { if (status) status.textContent = 'Copy the page address from your browser.'; }
    });
  </script>
</Layout>
