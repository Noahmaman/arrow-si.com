---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles, related, formatDate, type Article } from '../../lib/articles';
import { SITE, ARROW, ORGANIZATION_ID, askAiLinks, absolute } from '../../lib/site';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const { Content } = article;
const url = absolute(article.url);
const ogImage = `/og/${article.slug}.jpg`;
const next = related(article, 3);
const toc = article.headings.filter((h) => h.depth === 2);
const ask = askAiLinks(url, `“${article.title}”`);
const share = {
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
  x: `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(article.title)}`,
};

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: article.title,
    alternativeHeadline: article.seoTitle,
    description: article.description,
    abstract: article.summary,
    image: [{ '@type': 'ImageObject', url: absolute(ogImage), width: 1200, height: 630 }],
    datePublished: article.published,
    dateModified: article.updated,
    inLanguage: 'en',
    wordCount: article.words,
    timeRequired: `PT${article.minutes}M`,
    articleSection: article.category,
    keywords: article.keywords.join(', '),
    author: { '@id': ORGANIZATION_ID },
    publisher: { '@id': ORGANIZATION_ID },
    isPartOf: { '@type': 'Blog', '@id': `${SITE.url}/blog/#blog`, name: 'Arrow Signal guides', url: `${SITE.url}/blog/` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    about: article.keywords.slice(0, 3).map((k) => ({ '@type': 'Thing', name: k })),
    citation: article.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.short-answer p'] },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: article.title, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: article.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title={`${article.seoTitle} | Arrow Signal`}
  description={article.description}
  image={ogImage}
  imageAlt={`${article.title}. A guide from Arrow Signal by Arrow AI.`}
  type="article"
  published={`${article.published}T09:00:00Z`}
  modified={`${article.updated}T09:00:00Z`}
  section={article.category}
  tags={article.keywords}
  schema={schema}
>
  <article>
    <header class="page-head">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog/">Guides</a><span aria-hidden="true">/</span><span aria-current="page">{article.category}</span>
        </nav>
        <p class="kicker blue">{article.category} · Guide {String(article.order).padStart(2, '0')}</p>
        <h1>{article.title}</h1>
        <p class="lede">{article.description}</p>
        <p class="byline">
          <img src="/brand/arrow-icon-192.png" alt="" width="22" height="22" />
          <span>By <a href={ARROW.about}>Arrow AI</a></span>
          <span aria-hidden="true">·</span>
          <time datetime={article.updated}>{formatDate(article.updated)}</time>
          <span aria-hidden="true">·</span>
          <span>{article.minutes} min read</span>
        </p>
      </div>
    </header>

    <div class="layout">
      <aside class="toc" aria-label="On this page">
        <div class="toc-inner">
          <p class="toc-title">On this page</p>
          <ol>
            <li><a href="#short-answer">Short answer</a></li>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#sources">Sources</a></li>
          </ol>
        </div>
      </aside>

      <div class="main">
        <section class="short-answer" id="short-answer" aria-labelledby="sa-title">
          <h2 id="sa-title">Short answer</h2>
          <p>{article.summary}</p>
        </section>

        <section class="takeaways" aria-labelledby="kt-title">
          <h2 id="kt-title">Key points</h2>
          <ul>{article.takeaways.map((t) => <li>{t}</li>)}</ul>
        </section>

        <div class="prose">
          <Content />
        </div>

        <section class="block" id="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Frequently asked questions</h2>
          {article.faq.map((f) => (
            <div class="qa">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </section>

        <section class="block" aria-labelledby="more-title">
          <h2 id="more-title">Further reading from Arrow AI</h2>
          <ul class="more">
            {article.ecosystem.map((e) => (
              <li><a href={e.url}>{e.title}</a> <span class="muted">({e.note})</span></li>
            ))}
          </ul>
        </section>

        <section class="block" id="sources" aria-labelledby="src-title">
          <h2 id="src-title">Sources</h2>
          <ol class="sources">
            {article.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}
          </ol>
          <p class="note">The advice in this guide is Arrow AI’s view, based on the sources above and our GEO work with clients. AI companies control their own answers, so nothing here guarantees a mention, citation or recommendation.</p>
        </section>

        <div class="share">
          <div class="inline-links">
            <span class="label">Share</span>
            <a href={share.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            <a href={share.x} target="_blank" rel="noopener">X</a>
            <button type="button" data-copy={url}>Copy link</button>
          </div>
          <div class="inline-links">
            <span class="label">Summarize with</span>
            {ask.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.name}</a>)}
          </div>
        </div>

        <aside class="cta-box" aria-labelledby="cta-title">
          <h2 id="cta-title">Want to know what AI says about your brand?</h2>
          <p>Arrow AI’s free audit checks how AI tools describe your business and tells you what to fix first.</p>
          <div class="btn-row">
            <a class="btn btn-primary" href={ARROW.freeAudit}>Get the free audit</a>
            <a class="link" href="https://arrow-ai.tech/">See the GEO demo <span class="arr" aria-hidden="true">›</span></a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <section class="section mist" aria-labelledby="next-title">
    <div>
      <p class="kicker blue">Keep reading</p>
      <h2 id="next-title" class="h-section next-title">Related <span class="hl">guides</span></h2>
      <ul class="guide-grid">
        {next.map((a) => <ArticleCard article={a} />)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-head h1 { font-size: clamp(2.1rem, 4.4vw, 3.1rem); line-height: 1.08; letter-spacing: -0.04em; }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 26px; font-size: 0.875rem; color: var(--slate); }
  .byline img { border-radius: 6px; }
  .byline a { color: var(--ink); font-weight: 600; text-decoration: none; }
  .byline a:hover { color: var(--link); }

  .layout { display: grid; grid-template-columns: 200px minmax(0, 692px); gap: 64px; justify-content: center; padding: 8px var(--pad) var(--section-gap); }
  .toc-inner { position: sticky; top: calc(var(--lnav-h) + 28px); }
  .toc-title { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--steel); margin-bottom: 12px; }
  .toc ol { list-style: none; }
  .toc a { display: block; padding: 5px 0; font-size: 0.85rem; line-height: 1.4; color: var(--slate); text-decoration: none; transition: color 0.2s; }
  .toc a:hover { color: var(--ink); }
  .toc a.is-active { color: var(--ink); font-weight: 600; }
  @media (max-width: 1000px) { .layout { grid-template-columns: minmax(0, 1fr); } .toc { display: none; } }

  .short-answer, .takeaways { padding: 28px; border-radius: var(--r-card); background: var(--mist); }
  .short-answer h2, .takeaways h2 { font-family: var(--mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); }
  .short-answer p { margin-top: 10px; color: var(--ink); font-size: 1.12rem; line-height: 1.6; letter-spacing: -0.01em; }
  .takeaways { margin-top: 12px; background: var(--white); box-shadow: var(--ring); }
  .takeaways h2 { color: var(--slate); }
  .takeaways ul { margin-top: 12px; padding-left: 1.2em; display: grid; gap: 8px; }
  .takeaways li::marker { color: var(--blue); }
  .prose { margin-top: 44px; }

  .block { margin-top: 64px; }
  .block > h2 { font-size: 1.65rem; letter-spacing: -0.03em; margin-bottom: 8px; }
  .qa { padding: 20px 0; border-bottom: 1px solid var(--control); }
  .qa:first-of-type { border-top: 1px solid var(--hairline); }
  .qa h3 { font-size: 1.05rem; letter-spacing: -0.015em; }
  .qa p { margin-top: 6px; color: var(--slate); }
  .more, .sources { margin-top: 14px; padding-left: 1.2em; display: grid; gap: 8px; }
  .more a, .sources a { color: var(--link); text-decoration: none; }
  .more a:hover, .sources a:hover { text-decoration: underline; }
  .note { margin-top: 18px; font-size: 0.85rem; color: var(--slate); }
  .share { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--hairline); display: grid; gap: 12px; }
  .cta-box { margin-top: 48px; padding: 36px; border-radius: var(--r-card); background: var(--mist); }
  .cta-box h2 { font-size: 1.45rem; letter-spacing: -0.025em; }
  .cta-box p { margin-top: 8px; color: var(--slate); }
  .cta-box .btn-row { margin-top: 22px; }
  .next-title { margin-bottom: 40px; }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]'));
  const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
  if (targets.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) links.forEach((a) => a.classList.toggle('is-active', a.hash === `#${visible[0].target.id}`));
    }, { rootMargin: '-15% 0px -70% 0px' });
    targets.forEach((t) => io.observe(t));
  }
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || location.href);
        btn.textContent = 'Link copied';
      } catch {
        btn.textContent = 'Copy from the address bar';
      }
      setTimeout(() => (btn.textContent = 'Copy link'), 2400);
    });
  });
</script>
