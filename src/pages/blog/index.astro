---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles, categories } from '../../lib/articles';
import { SITE, ORGANIZATION_ID, absolute } from '../../lib/site';

const title = 'AI Visibility Guides: 15 Practical GEO Articles | Arrow Signal';
const description =
  'Fifteen practical guides to AI visibility and GEO: measure your brand in ChatGPT, Gemini and Perplexity, fix what blocks citations and earn recommendations.';
const schema = [
  {
    '@type': ['Blog', 'CollectionPage'],
    '@id': `${SITE.url}/blog/#blog`,
    url: `${SITE.url}/blog/`,
    name: 'Arrow Signal guides',
    description,
    inLanguage: 'en',
    publisher: { '@id': ORGANIZATION_ID },
    isPartOf: { '@id': `${SITE.url}/#website` },
    blogPost: articles.map((a) => ({ '@type': 'BlogPosting', '@id': `${absolute(a.url)}#article`, headline: a.title, url: absolute(a.url), datePublished: a.published })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/blog/` },
    ],
  },
];
---
<Base title={title} description={description} image="/og/blog.jpg" imageAlt="Arrow Signal: fifteen guides to AI visibility and GEO." schema={schema}>
  <header class="page-head">
    <div>
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Guides</span></nav>
      <p class="kicker blue">Guides</p>
      <h1>AI visibility <span class="hl">guides</span></h1>
      <p class="lede">How AI tools decide what to say about a business, and what you can do about it. Each guide starts with a short answer and links to its sources.</p>
    </div>
  </header>

  <section class="section mist">
    <div>
      <div class="tools">
        <div class="filters" role="group" aria-label="Filter guides by topic">
          <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">All</button>
          {categories.map((c) => <button type="button" class="filter" data-filter={c} aria-pressed="false">{c}</button>)}
        </div>
        <label class="search">
          <span class="sr-only">Search the guides</span>
          <input type="search" placeholder="Search guides" data-search autocomplete="off" />
        </label>
      </div>
      <p class="count" aria-live="polite" data-count-label>{articles.length} guides</p>
      <ul class="guide-grid" data-list>
        {articles.map((a) => <ArticleCard article={a} headingLevel="h2" />)}
      </ul>
      <p class="empty" hidden data-empty>No guide matches that search.</p>
    </div>
  </section>
</Base>

<style>
  .tools { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter { padding: 8px 16px; border-radius: var(--r-pill); box-shadow: inset 0 0 0 1px var(--hairline); background: var(--white); font-size: 0.85rem; font-weight: 500; color: var(--ink); transition: box-shadow 0.2s, background 0.2s, color 0.2s; }
  .filter:hover { box-shadow: inset 0 0 0 1px var(--steel); }
  .filter.is-active { background: var(--ink); color: #fff; box-shadow: inset 0 0 0 1px var(--ink); }
  .search input { width: min(280px, 100%); padding: 9px 44px 9px 20px; border-radius: 980px; border: 0; box-shadow: inset 0 0 0 1px var(--steel); background: var(--white); color: var(--ink); }
  .search input:focus { outline: 2px solid var(--blue); outline-offset: 2px; }
  .count { margin: 28px 0 18px; font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }
  .empty { padding: 32px 0; color: var(--slate); }
  @media (max-width: 620px) { .search, .search input { width: 100%; } }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-list] > li'));
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const label = document.querySelector<HTMLElement>('[data-count-label]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  let filter = 'all';
  const apply = () => {
    const q = (search?.value || '').trim().toLowerCase();
    let n = 0;
    items.forEach((li) => {
      const show = (filter === 'all' || li.dataset.category === filter) && (!q || (li.dataset.title || '').includes(q));
      li.hidden = !show;
      if (show) n++;
    });
    if (label) label.textContent = `${n} guide${n === 1 ? '' : 's'}`;
    if (empty) empty.hidden = n !== 0;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      filter = btn.dataset.filter || 'all';
      document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
        b.classList.toggle('is-active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      apply();
    });
  });
  search?.addEventListener('input', apply);
</script>
