---
import Base from '../layouts/Base.astro';
import { ARROW } from '../lib/site';
---
<Base title="Page not found | Arrow Signal" description="This page could not be found on Arrow Signal, the AI visibility guides from Arrow AI." noindex>
  <section class="page-head lost">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>Page not found</h1>
      <p class="lede">The page may have moved or never existed.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Go to the homepage</a>
        <a class="btn btn-secondary" href="/blog/">Browse the guides</a>
        <a class="btn btn-secondary" href={ARROW.url}>Visit Arrow AI</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost { min-height: 60vh; border-bottom: 0; }
  .lost .btn-row { margin-top: 28px; }
</style>
