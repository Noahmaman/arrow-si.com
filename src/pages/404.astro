---
import Base from '../layouts/Base.astro';
import SignalField from '../components/SignalField.astro';
import { ARROW } from '../lib/site';
---
<Base title="Signal lost (404) | Arrow Signal" description="This page could not be found on Arrow Signal." noindex>
  <section class="page-hero night lost">
    <SignalField lines={14} mode="calm" />
    <div class="wrap">
      <p class="kicker">Error 404 — signal lost</p>
      <h1>This frequency is <span class="grad">empty.</span></h1>
      <p class="lede">The page you’re looking for moved or never existed. Let’s get you back on signal.</p>
      <div class="btn-row" style="margin-top:28px">
        <a class="btn btn-heat" href="/">Back to Arrow Signal</a>
        <a class="btn btn-ghost-dark" href="/blog/">Read the journal</a>
        <a class="btn btn-ghost-dark" href={ARROW.url}>Visit Arrow AI</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost { min-height: 70vh; display: flex; align-items: center; }
</style>
