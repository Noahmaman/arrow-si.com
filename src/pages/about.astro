---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Ecosystem from '../components/Ecosystem.astro';
import { SITE, ARROW, ANSWERS, DEMO, SOCIALS, ORGANIZATION_ID } from '../lib/site';

const title = 'About Arrow Signal: the AI Visibility Hub of Arrow AI';
const description = 'Arrow Signal (arrow-si.com) is the AI visibility hub of Arrow AI: guides, a glossary and a free audit to get brands found, cited and recommended by AI.';
const icons = { LinkedIn: 'linkedin', Instagram: 'instagram', YouTube: 'youtube', TikTok: 'tiktok' } as const;
const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${SITE.url}/about/#webpage`,
    url: `${SITE.url}/about/`,
    name: title,
    description,
    inLanguage: 'en',
    about: { '@id': ORGANIZATION_ID },
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
    ],
  },
];
---
<Base title={title} description={description} schema={schema}>
  <header class="page-hero night">
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About</span></nav>
      <p class="kicker rise">About Arrow Signal</p>
      <h1 class="rise" style="--d:60ms">Less noise. <span class="grad">More signal.</span></h1>
      <p class="lede rise" style="--d:120ms">Arrow Signal is the AI visibility hub of <a class="text-link" href={ARROW.url}>Arrow AI</a>. One topic, covered properly: how brands get found, cited and recommended in AI answers.</p>
    </div>
  </header>

  <section class="section is-tight">
    <div class="wrap about-grid">
      <div class="about-copy">
        <h2 class="h-section">Why this site exists</h2>
        <p>Buyers now ask ChatGPT, Gemini, Perplexity, Claude and Google’s AI features to explain categories, compare providers and recommend a shortlist. Most brands have no idea what those answers say about them.</p>
        <p>Arrow AI builds GEO, AI Systems and AI Studio for businesses. Arrow Signal (arrow-si.com) focuses on a single part of that work — <strong>AI visibility</strong> — and relays it to the rest of the Arrow ecosystem: the <a href={ARROW.geo}>Arrow GEO service</a>, the practical library at <a href={ANSWERS.url}>Arrow Answers</a> and the interactive <a href={DEMO.url}>GEO demo</a>.</p>
        <h2 class="h-section">Editorial standards</h2>
        <ul class="standards">
          <li><Icon name="check" size={14} /> <span><strong>Answer first.</strong> Every guide opens with a short, direct answer.</span></li>
          <li><Icon name="check" size={14} /> <span><strong>Primary sources.</strong> Claims about how engines work link to official documentation or research.</span></li>
          <li><Icon name="check" size={14} /> <span><strong>No guarantees.</strong> AI products control their own answers. We never promise rankings, mentions or recommendations.</span></li>
          <li><Icon name="check" size={14} /> <span><strong>Illustrations are labelled.</strong> Dashboards and answer examples on this site use sample data and say so.</span></li>
          <li><Icon name="check" size={14} /> <span><strong>Transparent ecosystem links.</strong> Links to Arrow AI properties are our own — not independent endorsements.</span></li>
          <li><Icon name="check" size={14} /> <span><strong>Honest dates.</strong> We update “last updated” only when the content really changes.</span></li>
        </ul>
        <h2 class="h-section">Who we are</h2>
        <p>Arrow Signal is written by the Arrow AI team. Arrow AI (arrow-ai.us) is independent from Arrow Electronics (arrow.com), ArrowAI (arrowai.com) and other companies named Arrow.</p>
        <div class="btn-row">
          <a class="btn btn-heat" href={ARROW.freeAudit}>Get your free AI visibility audit <Icon name="arrow" size={15} /></a>
          <a class="btn btn-outline" href={ARROW.call}>Book 15 minutes with Noah</a>
        </div>
      </div>
      <aside class="card follow">
        <p class="kicker">Follow Arrow</p>
        <ul>
          {SOCIALS.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener me"><Icon name={icons[s.name]} size={18} /> <span>{s.name}</span><span class="mono h">{s.handle}</span></a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section is-tight hairline-top">
    <div class="wrap">
      <div class="section-head"><p class="kicker">The Arrow ecosystem</p><h2 class="h-section">One signal. <span class="grad">Four frequencies.</span></h2></div>
      <Ecosystem />
    </div>
  </section>
</Base>

<style>
  .about-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .about-copy { max-width: 720px; }
  .about-copy .h-section { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-top: 40px; }
  .about-copy .h-section:first-child { margin-top: 0; }
  .about-copy p { margin-top: 14px; color: var(--ink-soft); font-size: 1.05rem; }
  .about-copy a:not(.btn) { color: var(--blue); }
  .standards { list-style: none; margin-top: 16px; display: grid; gap: 12px; }
  .standards li { display: flex; gap: 12px; color: var(--ink-soft); }
  .standards :global(svg) { flex-shrink: 0; margin-top: 5px; color: var(--blue); }
  .btn-row { margin-top: 28px; }
  .follow { position: sticky; top: calc(var(--header-h) + 24px); }
  .follow ul { list-style: none; display: grid; gap: 6px; }
  .follow a { display: flex; align-items: center; gap: 12px; padding: 12px 12px; border-radius: 10px; text-decoration: none; color: var(--ink); transition: background 0.2s; }
  .follow a:hover { background: var(--blue-soft); }
  .follow .h { margin-left: auto; font-size: 0.74rem; color: var(--faint); }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; } .follow { position: static; } }
</style>
