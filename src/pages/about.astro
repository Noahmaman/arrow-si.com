---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, ARROW, ANSWERS, DEMO, SOCIALS, ORGANIZATION_ID } from '../lib/site';

const title = 'About Arrow Signal: AI Visibility Guides by Arrow AI';
const description = 'Arrow Signal (arrow-si.com) publishes practical guides on AI visibility. It is run by Arrow AI, which builds GEO, AI systems and AI Studio for businesses.';
const icons = { LinkedIn: 'linkedin', Instagram: 'instagram', YouTube: 'youtube', TikTok: 'tiktok' } as const;
const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${SITE.url}/about/#webpage`,
    url: `${SITE.url}/about/`,
    name: title,
    description,
    inLanguage: 'en',
    about: { '@id': ORGANIZATION_ID },
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
    ],
  },
];
---
<Base title={title} description={description} schema={schema}>
  <header class="page-head">
    <div>
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About</span></nav>
      <p class="kicker">About</p>
      <h1>About Arrow <span class="hl">Signal</span></h1>
      <p class="lede">Arrow Signal publishes practical guides on one topic: how businesses get found, cited and recommended in AI answers.</p>
    </div>
  </header>

  <section class="section">
    <div class="about">
      <div class="prose">
        <h2>Why this site exists</h2>
        <p>More and more buyers ask ChatGPT, Gemini, Perplexity, Claude or Google’s AI features to explain a category, compare providers and suggest a shortlist. Most companies have never checked what those answers say about them.</p>
        <p>Arrow Signal is run by <a href={ARROW.url}>Arrow AI</a>, which builds GEO, AI systems and AI Studio for businesses. This site covers the AI visibility part of that work. For specific questions, see <a href={ANSWERS.url}>Arrow Answers</a>. To see the process step by step, try the <a href={DEMO.url}>GEO demo</a>. To have it done for you, see <a href={ARROW.geo}>Arrow GEO</a>.</p>
        <h2>How we write</h2>
        <ul>
          <li>Every guide starts with a short, direct answer.</li>
          <li>Claims about how AI tools work link to official documentation or published research.</li>
          <li>We don’t promise rankings, mentions or recommendations. AI companies control their own answers.</li>
          <li>Examples that use made-up companies or data are labelled as examples.</li>
          <li>Links to other Arrow AI sites are our own, not independent endorsements.</li>
          <li>We only change the “updated” date when the content changes.</li>
        </ul>
        <h2>Who we are</h2>
        <p>The guides are written by the Arrow AI team. Arrow AI (arrow-ai.us) is independent from Arrow Electronics (arrow.com), ArrowAI (arrowai.com) and other companies named Arrow.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={ARROW.freeAudit}>Get a free AI visibility audit</a>
          <a class="link" href={ARROW.call}>Book a 15-minute call <span class="arr" aria-hidden="true">›</span></a>
        </div>
      </div>
      <aside class="follow">
        <h2>Follow Arrow AI</h2>
        <ul>
          {SOCIALS.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener me"><Icon name={icons[s.name]} size={16} /> {s.name} <span class="muted">{s.handle}</span></a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 64px; align-items: start; }
  .about .prose { max-width: 680px; }
  .about .prose h2:first-child { margin-top: 0; }
  .about .btn-row { margin-top: 32px; }
  .follow { border-radius: var(--r-card); padding: 28px; background: var(--mist); position: sticky; top: calc(var(--lnav-h) + 24px); }
  .follow h2 { font-size: 21px; font-weight: 600; letter-spacing: 0.011em; margin-bottom: 8px; }
  .follow ul { list-style: none; }
  .follow a { display: flex; align-items: center; gap: 10px; padding: 10px 0; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--control); }
  .follow li:last-child a { border-bottom: 0; }
  .follow a:hover { color: var(--link); }
  .follow .muted { margin-left: auto; font-size: 14px; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } .follow { position: static; } }
</style>
