---
import Base from '../layouts/Base.astro';
import { glossary } from '../lib/glossary';
import { SITE, ARROW, ORGANIZATION_ID } from '../lib/site';

const title = 'AI Visibility Glossary: GEO & AI Search Terms | Arrow Signal';
const description = 'Plain-English definitions of AI visibility and GEO terms: AI citations, share of voice, entity clarity, AI Overviews, query fan-out, AI crawlers and llms.txt.';
const sorted = [...glossary].sort((a, b) => a.term.localeCompare(b.term));
const url = `${SITE.url}/glossary/`;
const schema = [
  {
    '@type': 'DefinedTermSet',
    '@id': `${url}#terms`,
    name: 'AI visibility glossary',
    description,
    url,
    inLanguage: 'en',
    publisher: { '@id': ORGANIZATION_ID },
    hasDefinedTerm: sorted.map((g) => ({ '@type': 'DefinedTerm', '@id': `${url}#${g.slug}`, name: g.term, description: g.def, inDefinedTermSet: `${url}#terms` })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Glossary', item: url },
    ],
  },
];
---
<Base title={title} description={description} image="/og/glossary.jpg" imageAlt="AI visibility glossary from Arrow Signal." schema={schema}>
  <header class="page-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Glossary</span></nav>
      <h1>AI visibility glossary</h1>
      <p class="lede">{glossary.length} terms you will meet when working on AI visibility, each with a short definition. Arrow AI keeps a longer <a class="link" href={ARROW.glossary}>GEO glossary</a> too.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap narrow">
      <dl class="terms">
        {sorted.map((g) => (
          <div class="term" id={g.slug}>
            <dt>{g.term}</dt>
            <dd>
              {g.def}
              {g.link && <> <a class="link" href={g.link}>Read the guide</a></>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .terms { border-top: 1px solid var(--line); }
  .term { display: grid; grid-template-columns: 220px 1fr; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 16px); }
  .term:target dt { color: var(--blue); }
  dt { font-weight: 600; color: var(--ink); }
  dd .link { font-size: 0.93rem; white-space: nowrap; }
  @media (max-width: 640px) { .term { grid-template-columns: 1fr; gap: 6px; } }
</style>
