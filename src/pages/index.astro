---
import ArrowLayout from '../layouts/ArrowLayout.astro';
import { articles } from '../data/articles';
const faqs = [
  ['What is AI visibility?', 'AI visibility is how often—and how accurately—your brand, expertise and content appear in AI-generated answers. It includes brand mentions, cited sources and recommendation context across the questions your audience asks.'],
  ['How is GEO different from SEO?', 'Generative engine optimization focuses on representation in AI answers. SEO focuses on search discovery and performance. Both benefit from accessible pages, clear information and credible evidence, but their outcomes should be measured separately.'],
  ['Can a website guarantee citations in AI answers?', 'No. Answer products use their own retrieval and selection systems, and results can vary between runs. Clear content and sound technical foundations can remove obstacles, but they do not guarantee a mention, citation or recommendation.'],
  ['How should we measure AI visibility?', 'Start with a fixed set of real buyer questions. Record the answer, model or product, date, region and cited URLs. Track mentions, first-party citations and accuracy separately, and repeat comparable tests to understand variability.'],
  ['How does Arrow Signal connect to Arrow AI?', 'Arrow Signal is the AI visibility editorial destination in the Arrow ecosystem. This site connects readers to the main Arrow AI website, Arrow Answers and Arrow AI Tech through clearly identified ecosystem links.'],
];
const schema = { '@type': 'WebSite', name: 'Arrow Signal', url: 'https://arrow-si.com', description: 'AI visibility intelligence and practical GEO education from the Arrow ecosystem.', publisher: { '@id': 'https://arrow-si.com/#organization' } };
---
<ArrowLayout title="Arrow Signal — AI Visibility & GEO Intelligence" description="AI visibility and GEO from Arrow AI. Learn how to be found, cited and recommended in AI answers, with 15 practical guides and a free GEO audit." schema={schema}>
  <section class="section hero home-hero-blue">
    <a class="hero-pill" href="https://arrow-ai.us/free-audit/"><span class="tag">New</span>Free GEO audit — see how AI engines talk about your brand<span class="arr" aria-hidden="true">→</span></a>
    <h1 class="h-display">Make your brand visible in <span class="hero-accent">AI answers</span></h1>
    <p class="lede">Arrow helps buyers discover your business in AI answers. <span class="lede-hl">Start with a free audit and a clear plan.</span></p>
    <div class="base-check"><div class="base-check-head"><span>Free GEO check</span><span>YOUR NEXT STEP</span></div><a href="https://arrow-ai.us/geo-check/"><span>How visible is your business in AI answers?</span><strong>Start here <span aria-hidden="true">→</span></strong></a><p>Continue to Arrow AI to check your website or company.</p></div>
    <a class="btn btn-heat" href="https://cal.com/noah-maman-arrow-ai/15min">Book a strategy call</a>
    <figure class="base-film"><video controls playsinline preload="none" width="1280" height="720" poster="/brand/arrow-ai-geo-motion-poster.webp" aria-label="Arrow AI film: SEO ranked you. GEO gets you answered."><source src="/brand/arrow-ai-geo-motion-light.webm" type="video/webm"/><source src="/brand/arrow-ai-geo-motion-light.mp4" type="video/mp4"/><track kind="descriptions" src="/brand/geo-film.vtt" srclang="en" label="English visual descriptions"/></video><figcaption>SEO ranked you. GEO gets you answered — the original Arrow AI film. A brand perspective, not a guarantee of AI placement.</figcaption></figure>
    <div class="base-engines"><span>AI VISIBILITY ACROSS</span><span>ChatGPT</span><span>Gemini</span><span>Perplexity</span><span>Claude</span></div>
  </section>
  <section id="visibility" class="section"><span class="cross is-left" aria-hidden="true"></span><span class="cross is-right" aria-hidden="true"></span><div class="base-section-head"><p class="kicker">The Arrow GEO system</p><h2 class="h-section">Be found, cited, and <span class="hl-blue">recommended.</span></h2><p class="lede">AI visibility is how your brand, expertise and content appear in generated answers. Build a clear identity, useful evidence and a site that can be understood.</p></div><div class="base-cards"><a class="base-card" href="/blog/entity-clarity-for-ai-search/"><span class="kicker">01 — Clarity</span><h3 class="h-card">Make your brand understood</h3><p>Clarify your offer, audience and expertise. Keep one consistent identity across the Arrow ecosystem.</p><span class="base-card-link">Explore entity clarity →</span></a><a class="base-card" href="/blog/answer-ready-content/"><span class="kicker">02 — Evidence</span><h3 class="h-card">Become a useful source</h3><p>Publish clear explanations and credible evidence that readers and retrieval systems can inspect.</p><span class="base-card-link">Build answer-ready content →</span></a><a class="base-card" href="/blog/ai-visibility-baseline/"><span class="kicker">03 — Measurement</span><h3 class="h-card">Know what the answers say</h3><p>Measure mentions, citations and recommendation context against the buying questions that matter.</p><span class="base-card-link">Build your baseline →</span></a></div></section>
  <section id="approach" class="section"><div class="base-section-head"><p class="kicker">From audit to visibility</p><h2 class="h-section">A clear plan. <span class="hl-blue">A useful next step.</span></h2><p class="lede">Start with the evidence. Improve the information. Repeat comparable observations.</p></div><div class="base-method"><div><span class="kicker">01 — Observe</span><h3 class="h-card">Listen to the answers</h3><p>Record how AI products describe your brand and which sources they cite. Separate a mention from a recommendation.</p><a href="/blog/brand-mentions-vs-citations/">Understand the signals →</a></div><div><span class="kicker">02 — Strengthen</span><h3 class="h-card">Fix the missing information</h3><p>Connect useful content, credible sources and technically accessible pages around your audience's actual questions.</p><a href="/blog/technical-geo-checklist/">Check the technical foundation →</a></div><div><span class="kicker">03 — Review</span><h3 class="h-card">Choose the next action</h3><p>Repeat your baseline, document what changed and prioritize the gaps that matter to your business.</p><a href="/blog/30-day-ai-visibility-plan/">Plan your first cycle →</a></div></div></section>
  <section class="section"><div class="base-section-head"><p class="kicker">Resources</p><h2 class="h-section">AI visibility, <span class="hl-blue">answered.</span></h2><p class="lede">15 practical English-language guides to GEO, AI visibility, technical access and content strategy.</p><a class="btn btn-blue" href="/blog/">Explore all 15 guides</a></div><div class="base-cards">{[articles[0],articles[2],articles[6]].map(article=><a class="base-card" href={`/blog/${article.slug}/`}><span class="kicker">{article.category}</span><h3 class="h-card">{article.title}</h3><p>{article.description}</p><span class="base-card-link">Read the guide →</span></a>)}</div></section>
  <section id="faq" class="section"><div class="base-section-head"><p class="kicker">FAQ</p><h2 class="h-section">Arrow AI, <span class="hl-blue">answered.</span></h2></div><div class="faq-wrap">{faqs.map(([question,answer])=><details class="faq-item"><summary>{question}<span class="ico" aria-hidden="true"></span></summary><p class="faq-a">{answer}</p></details>)}</div></section>
  <section class="section cta-final"><div class="cta-panel"><p class="kicker">One Arrow ecosystem</p><h2 class="h-section">Build your visibility in AI answers</h2><p class="lede">Start with Arrow AI. Keep learning with Arrow Answers. Explore the GEO demo.</p><div class="row"><a class="btn btn-heat" href="https://arrow-ai.us/">Explore Arrow AI</a><a class="btn btn-ghost" href="https://answers.arrow-ai.us/">Arrow Answers</a><a class="btn btn-ghost" href="https://arrow-ai.tech/">GEO demo</a></div></div></section>
</ArrowLayout>
