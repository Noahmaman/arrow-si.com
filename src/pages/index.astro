<script>
  import { reducedMotion } from '../lib/reveal';

  // Console tilts back to flat as it scrolls into view.
  const stage = document.querySelector<HTMLElement>('[data-tilt]');
  const wrap = stage?.querySelector<HTMLElement>('.console-wrap');
  if (stage && wrap) {
    if (reducedMotion()) {
      wrap.style.setProperty('--rx', '0deg');
      wrap.style.setProperty('--sc', '1');
    } else {
      let ticking = false;
      const update = () => {
        const r = stage.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight * 0.9)));
        wrap.style.setProperty('--rx', `${(14 * (1 - p)).toFixed(2)}deg`);
        wrap.style.setProperty('--sc', (0.94 + 0.06 * p).toFixed(3));
        ticking = false;
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    }
  }

  // Draw the strike-through line on "SEO ranked you." when it enters view.
  const strike = document.querySelector<HTMLElement>('[data-strike]');
  if (strike) {
    if (reducedMotion() || !('IntersectionObserver' in window)) strike.classList.add('is-struck');
    else new IntersectionObserver(([e], o) => { if (e.isIntersecting) { strike.classList.add('is-struck'); o.disconnect(); } }, { threshold: 0.8 }).observe(strike);
  }
</script>
