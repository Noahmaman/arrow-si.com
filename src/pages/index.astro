---
import Base from '../layouts/Base.astro';
import HeroSignal from '../components/HeroSignal.astro';
import SignalBento from '../components/SignalBento.astro';
import MethodTabs from '../components/MethodTabs.astro';
import EcoBeam from '../components/EcoBeam.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../lib/articles';
import { glossary } from '../lib/glossary';
import { SITE, ARROW, ANSWERS, ENGINES, ORGANIZATION_ID, askAiLinks, absolute } from '../lib/site';

const title = 'AI Visibility Guides: Get Your Brand Into AI Answers | Arrow Signal';
const description =
  'Practical guides from Arrow AI on getting your brand mentioned, cited and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.';

const faqs = [
  { q: 'What is AI visibility?', a: 'AI visibility is how often, and how accurately, your brand appears in answers written by AI tools such as ChatGPT, Gemini, Perplexity, Claude, Copilot and Google AI Overviews. It covers being mentioned by name, being cited as a source and being recommended for a buyer’s need.' },
  { q: 'How is it different from SEO?', a: 'SEO earns a position in a list of search results. AI visibility is about the answer itself, which usually names only a few companies. The groundwork overlaps (crawlable pages, clear content, credible evidence), but the results are measured differently.' },
  { q: 'What is GEO?', a: 'Generative engine optimization (GEO) is the work of making your public information clear, accessible and well sourced so AI tools can find, understand and recommend you, then checking what their answers actually say. Arrow AI offers GEO as a managed service.' },
  { q: 'How do you measure AI visibility?', a: 'Write 20 to 50 real buyer questions, run them on the AI tools your customers use, and record each full answer with its date and sources. Note whether you are mentioned, cited and recommended, and whether the facts are right. Repeat every month with the same questions.' },
  { q: 'Can anyone guarantee that ChatGPT will recommend us?', a: 'No. Each AI company controls its own answers, and answers change with wording, location and time. What you can control is your own information and an honest record of what the answers say.' },
  { q: 'How do I get started with Arrow?', a: 'Request the free AI visibility audit on arrow-ai.us. The Arrow AI team reviews how AI tools describe your business and sends you a plan. You can also book a 15-minute call.' },
];

const chapters = [
  { t: 0, label: '0:00', title: 'SEO is dead', img: '/media/film-seo-is-dead.webp', alt: 'Film still: the words “SEO is dead.” struck through by a blue line on a dark background.' },
  { t: 16, label: '0:16', title: 'Enter GEO', img: '/media/film-enter-geo.webp', alt: 'Film still: “Enter GEO, Generative Engine Optimization” in Arrow blue.' },
  { t: 20, label: '0:20', title: 'Make AI recommend you', img: '/media/film-make-ai-recommend-you.webp', alt: 'Film still: an AI answer card where a citation names Arrow AI as the most recommended option.' },
  { t: 24, label: '0:24', title: 'Build authority', img: '/media/film-build-authority.webp', alt: 'Film still: “Build synthetic authority” with badges reading Cited, Recommended and Source linked.' },
];

const stats = [
  { n: articles.length, label: 'practical guides on this site' },
  { n: 105, label: 'short answers on Arrow Answers' },
  { n: glossary.length, label: 'terms in the glossary' },
  { n: ENGINES.length, label: 'AI surfaces covered' },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: `${SITE.url}/`,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: [{ '@type': 'Thing', name: 'AI visibility' }, { '@type': 'Thing', name: 'Generative Engine Optimization' }],
    primaryImageOfPage: { '@type': 'ImageObject', url: absolute(SITE.ogImage), width: 1200, height: 630 },
    video: { '@id': `${SITE.url}/#geo-film` },
    datePublished: SITE.published,
    dateModified: '2026-10-19',
    publisher: { '@id': ORGANIZATION_ID },
  },
  {
    '@type': 'VideoObject',
    '@id': `${SITE.url}/#geo-film`,
    name: 'SEO ranked you. GEO gets you answered.',
    description: 'Arrow AI film on the move from search results to AI answers, what Generative Engine Optimization (GEO) is, and how brands get cited and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.',
    thumbnailUrl: [absolute('/media/arrow-ai-geo-film-poster.webp')],
    uploadDate: '2026-08-18T09:00:00+02:00',
    duration: 'PT36S',
    contentUrl: absolute('/media/arrow-ai-geo-film.mp4'),
    width: 1280,
    height: 720,
    inLanguage: 'en',
    publisher: { '@id': ORGANIZATION_ID },
  },
  { '@type': 'FAQPage', '@id': `${SITE.url}/#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'ItemList', '@id': `${SITE.url}/#guides`, name: 'AI visibility guides', itemListElement: articles.slice(0, 6).map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(a.url), name: a.title })) },
];
const ask = askAiLinks('https://arrow-si.com/', 'AI visibility and GEO');
---
<Base title={title} description={description} schema={schema}>
  <HeroSignal />

  <!-- STATS -->
  <section class="section tight stats" aria-label="Arrow Signal in numbers">
    <span class="cross l" aria-hidden="true"></span><span class="cross r" aria-hidden="true"></span>
    <ul>
      {stats.map((s, i) => <li class="reveal" style={`--d:${i * 70}ms`}><strong data-count={s.n}>{s.n}</strong><span>{s.label}</span></li>)}
    </ul>
  </section>

  <!-- SHIFT -->
  <section class="section" id="visibility" aria-labelledby="shift-title">
    <span class="cross l" aria-hidden="true"></span><span class="cross r" aria-hidden="true"></span>
    <div class="shift">
      <div>
        <p class="kicker blue reveal">What changed</p>
        <h2 id="shift-title" class="h-section reveal" style="--d:60ms"><span class="strike">SEO ranked you.</span><br /><span class="hl">GEO gets you answered.</span></h2>
        <p class="lede reveal" style="--d:120ms">Rankings still matter: Google’s AI Overviews and Microsoft Copilot are built on search indexes, and ChatGPT and Perplexity read web pages. But someone reading an AI answer sees a short list, not a page of results. GEO is the work of earning a place on that list.</p>
        <a class="link reveal" style="--d:160ms" href="/blog/geo-vs-seo/">GEO and SEO compared <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="compare reveal" style="--d:120ms">
        <div class="c-col before">
          <span class="mono c-h">Search results</span>
          <ol>
            {Array.from({ length: 6 }, (_, i) => <li class:list={{ you: i === 4 }}><span class="mono">{i === 4 ? 'yourbrand.com' : `result-${i + 1}.example`}</span><i></i></li>)}
          </ol>
          <span class="c-foot">You are result #5. One of ten.</span>
        </div>
        <div class="c-col after">
          <span class="mono c-h">AI answer</span>
          <p class="bubble">Which firm should we choose?</p>
          <p class="reply">For your situation, <mark>Your Brand</mark> is the best fit. It specialises in this and publishes clear pricing.<sup>1</sup></p>
          <div class="c-chips"><span class="chip ok">mentioned</span><span class="chip ok">cited</span><span class="chip ok">recommended</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SIGNALS -->
  <section class="section" aria-labelledby="signals-title">
    <span class="cross l" aria-hidden="true"></span><span class="cross r" aria-hidden="true"></span>
    <div class="section-head">
      <p class="kicker blue reveal">What to measure</p>
      <h2 id="signals-title" class="h-section reveal" style="--d:60ms">Four signals in every answer. <span class="hl">Track them separately.</span></h2>
      <p class="lede reveal" style="--d:120ms">A brand can be cited often and still never be recommended. Each signal needs different work, so a single score hides the real problem.</p>
    </div>
    <SignalBento />
    <p class="after"><a class="link" href="/blog/mentions-citations-recommendations/">Mentions, citations and recommendations explained <span class="arr" aria-hidden="true">→</span></a></p>
  </section>

  <!-- METHOD -->
  <section class="section" id="method" aria-labelledby="method-title">
    <span class="cross l" aria-hidden="true"></span><span class="cross r" aria-hidden="true"></span>
    <div class="section-head">
      <p class="kicker reveal">How Arrow works</p>
      <h2 id="method-title" class="h-section reveal" style="--d:60ms">From audit to <span class="hl">answers.</span></h2>
      <p class="lede reveal" style="--d:120ms">Start with what the answers say today, fix what stops AI tools from using your site, then check again on the same questions every month.</p>
    </div>
    <div class="reveal" style="--d:160ms"><MethodTabs /></div>
  </section>

  <!-- FILM -->
  <section class="section" id="film" aria-labelledby="film-title">
    <span class="cross l" aria-hidden="true"></span><span class="cross r" aria-hidden="true"></span>
    <div class="section-head center">
      <p class="kicker reveal">The Arrow story</p>
      <h2 id="film-title" class="h-section reveal" style="--d:60ms">Arrow AI in <span class="hl">36 seconds.</span></h2>
    </div>
    <div class="film reveal" style="--d:100ms">
      <video data-film controls playsinline preload="none" width="1280" height="720" poster="/media/arrow-ai-geo-film-poster.webp" aria-label="Arrow AI film, 36 seconds: SEO ranked you. GEO gets you answered.">
        <source src="/media/arrow-ai-geo-film.webm" type="video/webm" />
        <source src="/media/arrow-ai-geo-film.mp4" type="video/mp4" />
        <track kind="captions" src="/media/arrow-ai-geo-film.en.vtt" srclang="en" label="English" />
      </video>
    </div>
    <ol class="chapters">
      {chapters.map((c, i) => (
        <li class="reveal" style={`--d:${i * 70}ms`}>
          <button type="button" data-seek={c.t} aria-label={`Play from ${c.label}: ${c.title}`}>
            <img src={c.img} alt={c.alt} width="1280" height="720" loading="lazy" decoding="async" />
            <span><span class="mono">{c.label}</span>{c.title}</span>
          </button>
        </li>
      ))}
    </ol>
  </section>

  <!-- GUIDES -->
  <section class="section" aria-labelledby="guides-title">
    <span class="cross l" aria-hidden="true"></span><span class="cross r" aria-hidden="true"></span>
    <div class="head-row">
      <div class="section-head">
        <p class="kicker blue reveal">Guides</p>
        <h2 id="guides-title" class="h-section reveal" style="--d:60ms">Start with <span class="hl">these.</span></h2>
      </div>
      <a class="btn btn-blue reveal" href="/blog/">All 15 guides <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <ul class="guide-grid">
      {articles.slice(0, 6).map((a) => <ArticleCard article={a} />)}
    </ul>
  </section>

  <!-- ECOSYSTEM -->
  <section class="section" aria-labelledby="eco-title">
    <span class="cross l" aria-hidden="true"></span><span class="cross r" aria-hidden="true"></span>
    <div class="section-head">
      <p class="kicker reveal">The Arrow ecosystem</p>
      <h2 id="eco-title" class="h-section reveal" style="--d:60ms">Three Arrow sites. <span class="hl">One goal.</span></h2>
      <p class="lede reveal" style="--d:120ms">Learn here, go deeper on Arrow Answers, see the process in the demo, and let the Arrow AI team do the work.</p>
    </div>
    <EcoBeam />
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <span class="cross l" aria-hidden="true"></span><span class="cross r" aria-hidden="true"></span>
    <div class="faq-layout">
      <div>
        <p class="kicker reveal">FAQ</p>
        <h2 id="faq-title" class="h-section reveal" style="--d:60ms">AI visibility, <span class="hl">answered.</span></h2>
        <p class="lede reveal" style="--d:120ms">More in <a class="link" href={ANSWERS.url}>Arrow Answers</a>.</p>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details class="reveal" style={`--d:${i * 50}ms`} open={i === 0}>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" aria-labelledby="cta-title">
    <span class="cross l" aria-hidden="true"></span><span class="cross r" aria-hidden="true"></span>
    <div class="cta reveal">
      <p class="kicker">Work with Arrow</p>
      <h2 id="cta-title" class="h-section">See what AI says <span class="hl">about your brand.</span></h2>
      <p class="lede">The free audit shows how AI tools describe your business today, with a clear plan for what to fix first.</p>
      <div class="btn-row center">
        <a class="btn btn-heat" href={ARROW.freeAudit}>Get the free audit <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={ARROW.call}>Book 15 minutes with Noah</a>
      </div>
      <div class="inline-links center-row">
        <span class="label">Ask AI about this site</span>
        {ask.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.name}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* stats */
  .stats ul { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--a8); border: 1px solid var(--a8); border-radius: var(--r-lg); overflow: hidden; }
  .stats li { background: var(--bg-card); padding: 22px 24px; display: grid; gap: 4px; }
  .stats strong { font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stats span { color: var(--muted); font-size: 0.92rem; }
  @media (max-width: 760px) { .stats ul { grid-template-columns: 1fr 1fr; } }

  /* shift */
  .shift { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .shift .lede { margin-top: 18px; }
  .shift .link { margin-top: 20px; }
  .strike { position: relative; color: var(--faint); }
  .strike::after { content: ''; position: absolute; left: -2%; right: -2%; top: 55%; height: 0.08em; border-radius: 99px; background: var(--geo); transform: scaleX(0) rotate(-2deg); transform-origin: 0 50%; transition: transform 0.8s var(--ease) 0.5s; }
  .h-section.in .strike::after { transform: scaleX(1) rotate(-2deg); }
  :global(.no-js) .strike::after { transform: scaleX(1) rotate(-2deg); }
  .compare { display: grid; grid-template-columns: 1fr 1.15fr; gap: 12px; }
  .c-col { padding: 18px; border-radius: var(--r-lg); background: var(--bg-card); border: 1px solid var(--a8); display: flex; flex-direction: column; gap: 10px; }
  .c-col.after { border-color: transparent; background: linear-gradient(var(--bg-card), var(--bg-card)) padding-box, linear-gradient(160deg, var(--geo), var(--violet) 50%, var(--heat)) border-box; box-shadow: 0 20px 50px -30px rgba(37, 99, 235, 0.5); }
  .c-h { font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  .c-col ol { list-style: none; display: grid; gap: 8px; }
  .c-col li { display: grid; gap: 4px; opacity: 0.55; }
  .c-col li .mono { font-size: 0.66rem; color: var(--muted); }
  .c-col li i { height: 7px; border-radius: 4px; background: var(--a10); width: 85%; }
  .c-col li.you { opacity: 1; padding: 6px 8px; margin: 0 -8px; border-radius: 8px; background: var(--geo-soft); }
  .c-col li.you i { background: var(--geo); }
  .c-foot { font-size: 0.8rem; color: var(--muted); margin-top: auto; }
  .bubble { align-self: flex-end; padding: 8px 12px; border-radius: 12px 12px 2px 12px; background: var(--ink); color: #fff; font-size: 0.85rem; }
  .reply { font-size: 0.9rem; color: var(--ink-soft); }
  .reply mark { background: var(--heat); color: #fff; padding: 0 4px; border-radius: 4px; }
  .reply sup { color: var(--geo); font-weight: 600; }
  .c-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }
  @media (max-width: 900px) { .shift { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .compare { grid-template-columns: 1fr; } }
  .after { margin-top: 28px; }

  /* film */
  .film { max-width: 920px; margin: 0 auto; border-radius: 20px; padding: 6px; background: linear-gradient(160deg, rgba(37, 99, 235, 0.5), var(--a10) 45%, rgba(255, 100, 47, 0.45)); box-shadow: 0 30px 80px -40px rgba(18, 20, 40, 0.45); }
  .film video { width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: 15px; background: #000; }
  .chapters { list-style: none; max-width: 920px; margin: 14px auto 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .chapters button { width: 100%; text-align: left; border-radius: var(--r-md); overflow: hidden; background: var(--bg-card); border: 1px solid var(--a8); transition: transform 0.2s var(--ease), border-color 0.2s; }
  .chapters button:hover, .chapters button.on { transform: translateY(-2px); border-color: var(--geo); }
  .chapters img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .chapters button > span { display: grid; gap: 1px; padding: 8px 10px 10px; font-size: 0.85rem; font-weight: 600; }
  .chapters .mono { font-size: 0.64rem; font-weight: 500; color: var(--heat-strong); letter-spacing: 0.08em; }
  @media (max-width: 700px) { .chapters { grid-template-columns: 1fr 1fr; } }

  /* guides */
  .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .head-row .btn { margin-bottom: clamp(36px, 5vw, 56px); }

  /* faq */
  .faq-layout { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .faq-layout .lede { margin-top: 14px; }
  .faq { display: grid; gap: 8px; }
  .faq details { border-radius: var(--r-md); background: var(--bg-card); border: 1px solid var(--a8); transition: border-color 0.2s; }
  .faq details[open] { border-color: var(--a16); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 18px; font-weight: 600; letter-spacing: -0.01em; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq details p { padding: 0 18px 18px; color: var(--muted); }
  .plus { position: relative; width: 12px; height: 12px; flex-shrink: 0; }
  .plus::before, .plus::after { content: ''; position: absolute; background: var(--heat); border-radius: 2px; transition: transform 0.2s var(--ease); }
  .plus::before { left: 0; right: 0; top: 5px; height: 2px; }
  .plus::after { top: 0; bottom: 0; left: 5px; width: 2px; }
  .faq details[open] .plus::after { transform: scaleY(0); }
  @media (max-width: 860px) { .faq-layout { grid-template-columns: 1fr; } }

  /* cta */
  .cta { position: relative; text-align: center; padding: clamp(48px, 7vw, 80px) clamp(20px, 5vw, 64px); border-radius: 24px; background: var(--bg-card); border: 1px solid var(--a8); overflow: hidden; display: flex; flex-direction: column; align-items: center; }
  .cta::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(var(--a8) 1px, transparent 1px); background-size: 22px 22px; mask-image: radial-gradient(ellipse 60% 70% at 50% 0%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 0%, #000 20%, transparent 75%); }
  .cta::after { content: ''; position: absolute; bottom: -260px; left: 50%; transform: translateX(-50%); width: 760px; height: 420px; background: radial-gradient(closest-side at 40% 50%, rgba(255, 100, 47, 0.14), transparent 70%), radial-gradient(closest-side at 62% 50%, rgba(37, 99, 235, 0.12), transparent 70%); pointer-events: none; }
  .cta > * { position: relative; z-index: 1; }
  .cta .lede { margin: 16px auto 0; }
  .cta .btn-row { margin-top: 28px; }
  .center-row { justify-content: center; margin-top: 22px; }
</style>

<script>
  import { reduced } from '../lib/motion';
  const video = document.querySelector<HTMLVideoElement>('[data-film]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-seek]');
  buttons.forEach((btn) => btn.addEventListener('click', () => {
    if (!video) return;
    video.preload = 'auto';
    video.currentTime = Number(btn.dataset.seek);
    video.play().catch(() => {});
    video.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'center' });
  }));
  video?.addEventListener('timeupdate', () => {
    const t = video.currentTime;
    buttons.forEach((b, i) => {
      const start = Number(b.dataset.seek);
      const next = buttons[i + 1] ? Number(buttons[i + 1].dataset.seek) : Infinity;
      b.classList.toggle('on', t >= start && t < next);
    });
  });
</script>
