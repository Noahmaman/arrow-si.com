---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../lib/articles';
import { SITE, ARROW, ANSWERS, DEMO, ORGANIZATION_ID, askAiLinks, absolute } from '../lib/site';

const title = 'AI Visibility Guides: Get Your Brand Into AI Answers | Arrow Signal';
const description =
  'Practical guides from Arrow AI on getting your brand mentioned, cited and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.';

const faqs = [
  {
    q: 'What is AI visibility?',
    a: 'AI visibility is how often, and how accurately, your brand appears in answers written by AI tools such as ChatGPT, Gemini, Perplexity, Claude, Copilot and Google AI Overviews. It covers being mentioned by name, being cited as a source and being recommended for a buyer’s need.',
  },
  {
    q: 'How is it different from SEO?',
    a: 'SEO earns a position in a list of search results. AI visibility is about the answer itself, which usually names only a few companies. The groundwork overlaps (crawlable pages, clear content, credible evidence), but the results are measured differently.',
  },
  {
    q: 'What is GEO?',
    a: 'Generative engine optimization (GEO) is the work of making your public information clear, accessible and well sourced so AI tools can find, understand and recommend you, then checking what their answers actually say. Arrow AI offers GEO as a managed service.',
  },
  {
    q: 'How do you measure AI visibility?',
    a: 'Write 20 to 50 real buyer questions, run them on the AI tools your customers use, and record each full answer with its date and sources. Note whether you are mentioned, cited and recommended, and whether the facts are right. Repeat every month with the same questions.',
  },
  {
    q: 'Can anyone guarantee that ChatGPT will recommend us?',
    a: 'No. Each AI company controls its own answers, and answers change with wording, location and time. What you can control is your own information and an honest record of what the answers say.',
  },
  {
    q: 'How do I get started with Arrow?',
    a: 'Request the free AI visibility audit on arrow-ai.us. The Arrow AI team reviews how AI tools describe your business and sends you a plan. You can also book a 15-minute call.',
  },
];

const signals = [
  { t: 'Mentioned', d: 'The answer names your brand when buyers ask about your category or problem.' },
  { t: 'Cited', d: 'The answer links to one of your pages as a source for what it says.' },
  { t: 'Recommended', d: 'The answer suggests you as a good choice for the buyer’s situation.' },
  { t: 'Accurate', d: 'What the answer says about your offer, prices and locations is correct.' },
];

const steps = [
  { t: 'Baseline', d: 'Run 20 to 50 real buyer questions on the AI tools your customers use. Record the answers, the dates and the sources.', href: '/blog/how-to-measure-ai-visibility/', link: 'How to build a baseline' },
  { t: 'Fix access and facts', d: 'Make sure crawlers can reach your pages and that your business is described the same way everywhere.', href: '/blog/technical-ai-visibility-checklist/', link: 'Technical checklist' },
  { t: 'Publish answer pages', d: 'Write pages that answer pricing, comparison and “is this right for me” questions directly, with evidence.', href: '/blog/content-ai-engines-cite/', link: 'Writing pages AI can cite' },
  { t: 'Measure every month', d: 'Re-run the same questions, compare with the baseline and choose what to work on next.', href: '/blog/ai-share-of-voice/', link: 'Tracking share of voice' },
];

const ecosystem = [
  { name: 'Arrow AI', host: 'arrow-ai.us', url: ARROW.url, d: 'The team behind this site. GEO, AI systems and AI Studio for businesses.', cta: 'Visit Arrow AI' },
  { name: 'Arrow Answers', host: 'answers.arrow-ai.us', url: ANSWERS.url, d: 'Short, specific answers to more than a hundred GEO questions.', cta: 'Browse Arrow Answers' },
  { name: 'GEO demo', host: 'arrow-ai.tech', url: DEMO.url, d: 'An interactive walkthrough from a website to a cited AI answer.', cta: 'Try the demo' },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: `${SITE.url}/`,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: [{ '@type': 'Thing', name: 'AI visibility' }, { '@type': 'Thing', name: 'Generative Engine Optimization' }],
    primaryImageOfPage: { '@type': 'ImageObject', url: absolute(SITE.ogImage), width: 1200, height: 630 },
    video: { '@id': `${SITE.url}/#geo-film` },
    datePublished: SITE.published,
    dateModified: '2026-10-19',
    publisher: { '@id': ORGANIZATION_ID },
  },
  {
    '@type': 'VideoObject',
    '@id': `${SITE.url}/#geo-film`,
    name: 'SEO ranked you. GEO gets you answered.',
    description: 'Arrow AI film on the move from search results to AI answers, what Generative Engine Optimization (GEO) is, and how brands get cited and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.',
    thumbnailUrl: [absolute('/media/arrow-ai-geo-film-poster.webp')],
    uploadDate: '2026-08-18T09:00:00+02:00',
    duration: 'PT36S',
    contentUrl: absolute('/media/arrow-ai-geo-film.mp4'),
    width: 1280,
    height: 720,
    inLanguage: 'en',
    publisher: { '@id': ORGANIZATION_ID },
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE.url}/#faq`,
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/#guides`,
    name: 'AI visibility guides',
    itemListElement: articles.slice(0, 6).map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(a.url), name: a.title })),
  },
];
const ask = askAiLinks('https://arrow-si.com/', 'AI visibility and GEO');
---
<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">AI visibility guides from Arrow AI</span>
        <h1>Get your brand into AI answers</h1>
        <p class="lede">Buyers now ask ChatGPT, Gemini and Perplexity which company to choose, and the answer usually names two or three. These guides explain how those answers are put together and what you can do to be one of the names.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={ARROW.freeAudit}>Get a free AI visibility audit</a>
          <a class="btn btn-secondary" href="/blog/">Read the guides</a>
        </div>
        <p class="hero-note">Covers ChatGPT, Google AI Overviews and AI Mode, Gemini, Perplexity, Claude and Copilot.</p>
      </div>
      <figure class="answer" aria-labelledby="answer-cap">
        <figcaption id="answer-cap">Example of an AI answer</figcaption>
        <p class="q">Which accounting firm should a 20-person startup in Austin use?</p>
        <div class="a">
          <p>For a team that size, <strong>Northpeak Accounting</strong> is a good fit. It works mostly with venture-backed startups and publishes fixed monthly pricing.<sup>1</sup> Two larger firms are also worth comparing.<sup>2</sup></p>
          <ol>
            <li>northpeak.example/pricing</li>
            <li>review-site.example/austin</li>
          </ol>
        </div>
        <p class="answer-note">Northpeak is mentioned, cited and recommended. That is what these guides help you work toward.</p>
      </figure>
    </div>
  </section>

  <section class="section soft" id="visibility" aria-labelledby="shift-title">
    <div class="wrap two-col">
      <div>
        <span class="eyebrow">What changed</span>
        <h2 id="shift-title">Search used to be a list. Now it is an answer.</h2>
        <p>Rankings still matter. Google’s AI Overviews and Microsoft Copilot are built on search indexes, and ChatGPT and Perplexity read web pages. But someone reading an AI answer sees a short list, not a page of results.</p>
        <p>Arrow puts it simply: <em>SEO ranked you. GEO gets you answered.</em> Generative engine optimization is the work of earning a place on that short list.</p>
        <a class="link" href="/blog/geo-vs-seo/">GEO and SEO compared</a>
      </div>
      <div class="table-wrap">
        <table class="compare">
          <caption class="sr-only">Search results compared with AI answers</caption>
          <thead><tr><th scope="col"></th><th scope="col">Search results</th><th scope="col">AI answers</th></tr></thead>
          <tbody>
            <tr><th scope="row">What people see</th><td>Ten links and ads</td><td>A written answer with a few sources</td></tr>
            <tr><th scope="row">What counts</th><td>Your ranking</td><td>Being named, cited and recommended</td></tr>
            <tr><th scope="row">How to measure</th><td>Rankings and clicks</td><td>Answers to a fixed set of buyer questions</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="signals-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What to measure</span>
        <h2 id="signals-title">Four things to check in every answer</h2>
        <p>Measure them separately. A brand can be cited often and still never be recommended, and the fix is different each time.</p>
      </div>
      <ol class="cols">
        {signals.map((s, i) => (
          <li>
            <span class="num">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
      <p class="after"><a class="link" href="/blog/mentions-citations-recommendations/">Mentions, citations and recommendations explained</a></p>
    </div>
  </section>

  <section class="section" id="method" aria-labelledby="method-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How Arrow works</span>
        <h2 id="method-title">A simple monthly routine</h2>
        <p>Start with what the answers say today, fix what stops AI tools from using your site, then check again on the same questions.</p>
      </div>
      <ol class="cols steps">
        {steps.map((s, i) => (
          <li>
            <span class="num">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <a class="link" href={s.href}>{s.link}</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section soft" id="film" aria-labelledby="film-title">
    <div class="wrap film">
      <div>
        <span class="eyebrow">The film</span>
        <h2 id="film-title">Arrow AI in 36 seconds</h2>
        <p>A short film on the shift from ranking in search to being named in the answer, and what Arrow does about it.</p>
        <details class="transcript">
          <summary>Read the transcript</summary>
          <p>SEO is dead. Your brand used to be one result among ten. Enter GEO: generative engine optimization. Make AI recommend you, so that when a buyer asks for the best option in your category, the answer names you and cites your page. Build authority: cited, recommended, source linked. Arrow AI, arrow-ai.us.</p>
        </details>
      </div>
      <video controls playsinline preload="none" width="1280" height="720" poster="/media/arrow-ai-geo-film-poster.webp" aria-label="Arrow AI film, 36 seconds: SEO ranked you. GEO gets you answered.">
        <source src="/media/arrow-ai-geo-film.webm" type="video/webm" />
        <source src="/media/arrow-ai-geo-film.mp4" type="video/mp4" />
        <track kind="captions" src="/media/arrow-ai-geo-film.en.vtt" srclang="en" label="English" />
      </video>
    </div>
  </section>

  <section class="section" aria-labelledby="guides-title">
    <div class="wrap">
      <div class="head-row">
        <div class="section-head">
          <span class="eyebrow">Guides</span>
          <h2 id="guides-title">Start with these</h2>
        </div>
        <a class="link" href="/blog/">All 15 guides</a>
      </div>
      <ul class="post-list">
        {articles.slice(0, 6).map((a) => <ArticleCard article={a} />)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="eco-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Part of Arrow AI</span>
        <h2 id="eco-title">Where to go next</h2>
      </div>
      <ul class="eco">
        {ecosystem.map((e) => (
          <li>
            <a href={e.url}>
              <span class="host">{e.host}</span>
              <h3>{e.name}</h3>
              <p>{e.d}</p>
              <span class="link">{e.cta}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap two-col faq-layout">
      <div>
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title">Common questions</h2>
        <p class="muted">More in <a class="link" href={ANSWERS.url}>Arrow Answers</a>.</p>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta-inner">
      <div>
        <h2>See what AI says about your brand</h2>
        <p>The free audit shows how AI tools describe your business today, with a clear plan for what to fix first.</p>
      </div>
      <div class="cta-side">
        <div class="btn-row">
          <a class="btn btn-primary" href={ARROW.freeAudit}>Get the free audit</a>
          <a class="btn btn-secondary" href={ARROW.call}>Book a 15-minute call</a>
        </div>
        <div class="inline-links">
          <span class="label">Ask about this site in</span>
          {ask.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.name}</a>)}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(56px, 9vw, 104px) 0 clamp(56px, 8vw, 96px); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  .hero h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.08; letter-spacing: -0.03em; }
  .lede { margin-top: 20px; font-size: 1.15rem; color: var(--text); max-width: 560px; }
  .hero .btn-row { margin-top: 28px; }
  .hero-note { margin-top: 20px; font-size: 0.9rem; color: var(--muted); }

  .answer { border: 1px solid var(--line); border-radius: 12px; padding: 20px; background: #fff; }
  .answer figcaption { font-size: 0.8rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .q { margin-top: 14px; margin-left: auto; width: fit-content; max-width: 90%; padding: 10px 14px; border-radius: 12px 12px 2px 12px; background: var(--bg-soft); border: 1px solid var(--line); font-size: 0.95rem; color: var(--ink); }
  .a { margin-top: 14px; font-size: 0.97rem; }
  .a strong { color: var(--ink); background: var(--blue-tint); padding: 0 3px; border-radius: 3px; }
  .a sup { color: var(--blue); font-size: 0.7em; font-weight: 600; margin-left: 1px; }
  .a ol { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line); padding-left: 1.2em; font-size: 0.82rem; color: var(--muted); }
  .answer-note { margin-top: 14px; font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .two-col h2 { font-size: clamp(1.75rem, 3.2vw, 2.4rem); }
  .two-col p { margin-top: 14px; }
  .two-col .link { display: inline-block; margin-top: 18px; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .compare { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .compare th, .compare td { text-align: left; padding: 14px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .compare thead th { font-size: 0.85rem; color: var(--muted); font-weight: 600; }
  .compare tbody th { color: var(--ink); font-weight: 600; width: 32%; }
  .compare tr:last-child th, .compare tr:last-child td { border-bottom: 0; }
  .compare td:last-child { color: var(--ink); }
  @media (max-width: 860px) { .two-col { grid-template-columns: 1fr; } }

  .cols { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .cols li { border-top: 2px solid var(--ink); padding-top: 18px; display: flex; flex-direction: column; }
  .cols .num { font-size: 0.9rem; font-weight: 600; color: var(--blue); }
  .cols h3 { margin-top: 8px; font-size: 1.15rem; }
  .cols p { margin-top: 8px; color: var(--muted); font-size: 0.97rem; flex: 1; }
  .steps .link { margin-top: 14px; font-size: 0.93rem; }
  .after { margin-top: 32px; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .cols { grid-template-columns: 1fr; } }

  .film { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .film h2 { font-size: clamp(1.75rem, 3.2vw, 2.4rem); }
  .film p { margin-top: 14px; color: var(--muted); }
  .film video { width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: 12px; background: #000; border: 1px solid var(--line); }
  .transcript { margin-top: 18px; }
  .transcript summary { cursor: pointer; color: var(--blue); font-weight: 600; font-size: 0.95rem; }
  @media (max-width: 860px) { .film { grid-template-columns: 1fr; } }

  .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .head-row .section-head { margin-bottom: 24px; }
  .head-row .link { margin-bottom: 28px; }

  .eco { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .eco a { display: flex; flex-direction: column; height: 100%; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; transition: border-color 0.15s; }
  .eco a:hover { border-color: var(--blue); }
  .host { font-size: 0.85rem; color: var(--muted); }
  .eco h3 { margin-top: 6px; font-size: 1.2rem; }
  .eco p { margin-top: 8px; color: var(--muted); flex: 1; }
  .eco .link { margin-top: 16px; font-size: 0.95rem; }
  @media (max-width: 860px) { .eco { grid-template-columns: 1fr; } }

  .faq { border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; padding: 18px 0; font-weight: 600; color: var(--ink); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--blue); font-size: 1.3rem; line-height: 1; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { padding: 0 0 18px; color: var(--text); margin: 0; }

  .cta { background: var(--blue-tint); border-top: 1px solid var(--blue-line); padding: clamp(48px, 7vw, 80px) 0; }
  .cta-inner { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; }
  .cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .cta p { margin-top: 10px; color: var(--text); max-width: 560px; }
  .cta-side { display: grid; gap: 16px; }
  @media (max-width: 860px) { .cta-inner { grid-template-columns: 1fr; } }
</style>
