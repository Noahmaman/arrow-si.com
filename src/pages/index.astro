---
import Base from '../layouts/Base.astro';
import HeroStage from '../components/HeroStage.astro';
import Highlights from '../components/Highlights.astro';
import SignalBento from '../components/SignalBento.astro';
import MethodTabs from '../components/MethodTabs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../lib/articles';
import { glossary } from '../lib/glossary';
import { SITE, ARROW, ANSWERS, DEMO, ENGINES, ORGANIZATION_ID, askAiLinks, absolute } from '../lib/site';

const title = 'AI Visibility Guides: Get Your Brand Into AI Answers | Arrow Signal';
const description =
  'Practical guides from Arrow AI on getting your brand mentioned, cited and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.';

const faqs = [
  { q: 'What is AI visibility?', a: 'AI visibility is how often, and how accurately, your brand appears in answers written by AI tools such as ChatGPT, Gemini, Perplexity, Claude, Copilot and Google AI Overviews. It covers being mentioned by name, being cited as a source and being recommended for a buyer’s need.' },
  { q: 'How is it different from SEO?', a: 'SEO earns a position in a list of search results. AI visibility is about the answer itself, which usually names only a few companies. The groundwork overlaps (crawlable pages, clear content, credible evidence), but the results are measured differently.' },
  { q: 'What is GEO?', a: 'Generative engine optimization (GEO) is the work of making your public information clear, accessible and well sourced so AI tools can find, understand and recommend you, then checking what their answers actually say. Arrow AI offers GEO as a managed service.' },
  { q: 'How do you measure AI visibility?', a: 'Write 20 to 50 real buyer questions, run them on the AI tools your customers use, and record each full answer with its date and sources. Note whether you are mentioned, cited and recommended, and whether the facts are right. Repeat every month with the same questions.' },
  { q: 'Can anyone guarantee that ChatGPT will recommend us?', a: 'No. Each AI company controls its own answers, and answers change with wording, location and time. What you can control is your own information and an honest record of what the answers say.' },
  { q: 'How do I get started with Arrow?', a: 'Request the free AI visibility audit on arrow-ai.us. The Arrow AI team reviews how AI tools describe your business and sends you a plan. You can also book a 15-minute call.' },
];

const stats = [
  { n: articles.length, label: 'practical guides on this site' },
  { n: 105, label: 'short answers on Arrow Answers' },
  { n: glossary.length, label: 'terms in the glossary' },
  { n: ENGINES.length, label: 'AI surfaces covered' },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: `${SITE.url}/`,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: [{ '@type': 'Thing', name: 'AI visibility' }, { '@type': 'Thing', name: 'Generative Engine Optimization' }],
    primaryImageOfPage: { '@type': 'ImageObject', url: absolute(SITE.ogImage), width: 1200, height: 630 },
    video: { '@id': `${SITE.url}/#geo-film` },
    datePublished: SITE.published,
    dateModified: '2026-10-20',
    publisher: { '@id': ORGANIZATION_ID },
  },
  {
    '@type': 'VideoObject',
    '@id': `${SITE.url}/#geo-film`,
    name: 'SEO ranked you. GEO gets you answered.',
    description: 'Arrow AI film on the move from search results to AI answers, what Generative Engine Optimization (GEO) is, and how brands get cited and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.',
    thumbnailUrl: [absolute('/media/arrow-ai-geo-film-poster.webp')],
    uploadDate: '2026-08-18T09:00:00+02:00',
    duration: 'PT36S',
    contentUrl: absolute('/media/arrow-ai-geo-film.mp4'),
    width: 1280,
    height: 720,
    inLanguage: 'en',
    publisher: { '@id': ORGANIZATION_ID },
  },
  { '@type': 'FAQPage', '@id': `${SITE.url}/#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'ItemList', '@id': `${SITE.url}/#guides`, name: 'AI visibility guides', itemListElement: articles.slice(0, 6).map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(a.url), name: a.title })) },
];
const ask = askAiLinks('https://arrow-si.com/', 'AI visibility and GEO');
const anchors = [
  { href: '#highlights', label: 'Highlights' },
  { href: '#changed', label: 'What changed' },
  { href: '#signals', label: 'Signals' },
  { href: '#method', label: 'Method' },
  { href: '#guides', label: 'Guides' },
  { href: '#ecosystem', label: 'Ecosystem' },
  { href: '#faq', label: 'FAQ' },
];
const sites = [
  { host: 'arrow-ai.us', name: 'Arrow AI', d: 'The team behind this site. GEO, AI systems and AI Studio for businesses.', url: ARROW.url, cta: 'Visit Arrow AI' },
  { host: 'answers.arrow-ai.us', name: 'Arrow Answers', d: 'Short, sourced answers to more than a hundred specific GEO questions.', url: ANSWERS.url, cta: 'Browse the answers' },
  { host: 'arrow-ai.tech', name: 'GEO demo', d: 'An interactive walkthrough from a website to a cited AI answer.', url: DEMO.url, cta: 'Try the demo' },
];
---
<Base title={title} description={description} schema={schema}>
  <HeroStage />

  <nav class="anchors" aria-label="On this page">
    <ul>{anchors.map((a) => <li><a href={a.href}>{a.label}</a></li>)}</ul>
  </nav>

  <Highlights />

  <!-- WHAT CHANGED -->
  <section class="section" id="changed" aria-labelledby="shift-title">
    <div class="shift">
      <div>
        <p class="kicker blue reveal">What changed</p>
        <h2 id="shift-title" class="h-section reveal" style="--d:60ms">SEO ranked you.<br /><span class="hl">GEO gets you answered.</span></h2>
        <p class="lede reveal" style="--d:120ms">Rankings still matter: Google’s AI Overviews and Microsoft Copilot are built on search indexes, and ChatGPT and Perplexity read web pages. But someone reading an AI answer sees a short list, not a page of results. GEO is the work of earning a place on that list.</p>
        <a class="link reveal" style="--d:160ms" href="/blog/geo-vs-seo/">GEO and SEO compared <span class="arr" aria-hidden="true">›</span></a>
      </div>
      <div class="compare reveal" style="--d:120ms">
        <div class="c-col">
          <span class="c-h">Search results</span>
          <ol>
            {Array.from({ length: 6 }, (_, i) => <li class:list={{ you: i === 4 }}><span>{i === 4 ? 'yourbrand.com' : `result-${i + 1}.example`}</span><i></i></li>)}
          </ol>
          <span class="c-foot">You are result #5. One of ten.</span>
        </div>
        <div class="c-col after">
          <span class="c-h"><img src="/logos/chatgpt.svg" alt="" width="14" height="14" loading="lazy" />AI answer</span>
          <p class="bubble">Which firm should we choose?</p>
          <p class="reply">For your situation, <mark>Your Brand</mark> is the best fit. It specialises in this and publishes clear pricing.<sup>1</sup></p>
          <div class="c-chips"><span class="chip ok">Mentioned</span><span class="chip ok">Cited</span><span class="chip ok">Recommended</span></div>
        </div>
      </div>
    </div>
    <ul class="stats">
      {stats.map((s, i) => <li class="reveal" style={`--d:${i * 70}ms`}><strong data-count={s.n}>{s.n}</strong><span>{s.label}</span></li>)}
    </ul>
  </section>

  <!-- SIGNALS -->
  <section class="section" id="signals" aria-labelledby="signals-title">
    <div class="section-head">
      <p class="kicker blue reveal">What to measure</p>
      <h2 id="signals-title" class="h-section reveal" style="--d:60ms">Four signals in every answer. <span class="hl">Track them separately.</span></h2>
      <p class="lede reveal" style="--d:120ms">A brand can be cited often and still never be recommended. Each signal needs different work, so a single score hides the real problem.</p>
    </div>
    <SignalBento />
    <p class="after"><a class="link" href="/blog/mentions-citations-recommendations/">Mentions, citations and recommendations explained <span class="arr" aria-hidden="true">›</span></a></p>
  </section>

  <!-- METHOD -->
  <section class="section mist" id="method" aria-labelledby="method-title">
    <div class="section-head">
      <p class="kicker reveal">How Arrow works</p>
      <h2 id="method-title" class="h-section reveal" style="--d:60ms">From audit to <span class="hl">answers.</span></h2>
      <p class="lede reveal" style="--d:120ms">Start with what the answers say today, fix what stops AI tools from using your site, then check again on the same questions every month.</p>
    </div>
    <div class="reveal" style="--d:160ms"><MethodTabs /></div>
  </section>

  <!-- GUIDES -->
  <section class="section" id="guides" aria-labelledby="guides-title">
    <div class="head-row">
      <div>
        <p class="kicker blue reveal">Guides</p>
        <h2 id="guides-title" class="h-section reveal" style="--d:60ms">Start with <span class="hl">these.</span></h2>
      </div>
      <a class="link reveal" href="/blog/">All 15 guides <span class="arr" aria-hidden="true">›</span></a>
    </div>
    <ul class="guide-grid">
      {articles.slice(0, 6).map((a) => <ArticleCard article={a} />)}
    </ul>
  </section>

  <!-- ECOSYSTEM -->
  <section class="section mist" id="ecosystem" aria-labelledby="eco-title">
    <div class="section-head">
      <p class="kicker reveal">The Arrow ecosystem</p>
      <h2 id="eco-title" class="h-section reveal" style="--d:60ms">Three Arrow sites. <span class="hl">One goal.</span></h2>
      <p class="lede reveal" style="--d:120ms">Learn here, go deeper on Arrow Answers, see the process in the demo, and let the Arrow AI team do the work.</p>
    </div>
    <ul class="sites">
      {sites.map((c, i) => (
        <li class="reveal" style={`--d:${i * 80}ms`}>
          <img src="/brand/arrow-icon-192.png" alt="" width="44" height="44" loading="lazy" />
          <span class="eyebrow">{c.host}</span>
          <h3 class="t-card">{c.name}</h3>
          <p>{c.d}</p>
          <a class="link" href={c.url}>{c.cta} <span class="arr" aria-hidden="true">›</span></a>
        </li>
      ))}
    </ul>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="faq-layout">
      <div>
        <p class="kicker reveal">FAQ</p>
        <h2 id="faq-title" class="h-section reveal" style="--d:60ms">AI visibility, <span class="hl">answered.</span></h2>
        <p class="lede reveal" style="--d:120ms">More in <a class="link" href={ANSWERS.url}>Arrow Answers</a>.</p>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" aria-labelledby="cta-title">
    <div class="cta reveal">
      <img src="/brand/arrow-icon-192.png" alt="" width="56" height="56" loading="lazy" />
      <h2 id="cta-title" class="h-section">See what AI says <span class="hl">about your brand.</span></h2>
      <p class="lede">The free audit shows how AI tools describe your business today, with a clear plan for what to fix first.</p>
      <div class="btn-row center">
        <a class="btn btn-primary" href={ARROW.freeAudit}>Get the free audit</a>
        <a class="link" href={ARROW.call}>Book 15 minutes with Noah <span class="arr" aria-hidden="true">›</span></a>
      </div>
      <div class="inline-links center-row">
        <span class="label">Ask AI about this site</span>
        {ask.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.name}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* in-page anchors */
  .anchors { padding: 64px var(--pad) 8px; }
  .anchors ul { list-style: none; display: flex; justify-content: center; gap: 8px 36px; overflow-x: auto; scrollbar-width: none; padding: 20px 0 28px; }
  .anchors ul::-webkit-scrollbar { display: none; }
  .anchors a { font-size: 1rem; font-weight: 500; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .anchors a:hover { color: var(--link); }
  @media (max-width: 734px) { .anchors { padding-top: 40px; } .anchors ul { justify-content: flex-start; gap: 24px; } }

  /* what changed */
  .shift { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .shift .lede { margin-top: 18px; }
  .shift .link { margin-top: 20px; }
  .compare { display: grid; grid-template-columns: 1fr 1.15fr; gap: 12px; }
  .c-col { padding: 22px; border-radius: var(--r-card); background: var(--mist); display: flex; flex-direction: column; gap: 12px; }
  .c-col.after { background: var(--white); box-shadow: var(--ring); }
  .c-h { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--steel); }
  .c-h img { width: 14px; height: 14px; }
  .c-col ol { list-style: none; display: grid; gap: 9px; }
  .c-col li { display: grid; gap: 4px; opacity: 0.5; }
  .c-col li span { font-family: var(--mono); font-size: 0.66rem; color: var(--slate); }
  .c-col li i { height: 7px; border-radius: 4px; background: var(--hairline); width: 85%; }
  .c-col li.you { opacity: 1; }
  .c-col li.you span { color: var(--ink); }
  .c-col li.you i { background: var(--blue); }
  .c-foot { font-size: 0.82rem; color: var(--slate); margin-top: auto; }
  .bubble { align-self: flex-end; padding: 8px 13px; border-radius: 16px 16px 4px 16px; background: var(--blue); color: #fff; font-size: 0.86rem; }
  .reply { font-size: 0.92rem; color: var(--slate); }
  .reply mark { background: var(--blue-tint); color: var(--ink); font-weight: 600; padding: 0 4px; border-radius: 4px; }
  .reply sup { color: var(--link); font-weight: 600; }
  .c-chips { display: flex; flex-wrap: wrap; gap: 12px; margin-top: auto; }
  .stats { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 72px; padding-top: 40px; border-top: 1px solid var(--hairline); }
  .stats li { display: grid; gap: 6px; }
  .stats strong { font-size: clamp(2.4rem, 4.4vw, 3.4rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1; }
  .stats span { color: var(--slate); font-size: 0.93rem; }
  @media (max-width: 900px) { .shift { grid-template-columns: 1fr; } .stats { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .compare { grid-template-columns: 1fr; } }
  .after { margin-top: 36px; }

  /* ecosystem */
  .sites { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); }
  .sites li { display: flex; flex-direction: column; align-items: flex-start; padding: 36px 32px 32px; border-radius: var(--r-card); background: var(--white); }
  .sites img { width: 44px; height: 44px; border-radius: 12px; margin-bottom: 28px; }
  .sites h3 { margin-top: 8px; }
  .sites p { margin-top: 10px; color: var(--slate); flex: 1; }
  .sites .link { margin-top: 24px; }
  @media (max-width: 900px) { .sites { grid-template-columns: 1fr; } }

  /* faq */
  .faq-layout { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 56px; align-items: start; }
  .faq-layout .lede { margin-top: 14px; }
  .faq details { border-top: 1px solid var(--hairline); }
  .faq details:last-child { border-bottom: 1px solid var(--hairline); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; font-size: 1.1rem; font-weight: 600; letter-spacing: -0.02em; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { color: var(--link); }
  .faq details p { padding: 0 40px 24px 0; color: var(--slate); }
  .plus { position: relative; width: 14px; height: 14px; flex-shrink: 0; }
  .plus::before, .plus::after { content: ''; position: absolute; background: var(--slate); border-radius: 2px; transition: transform 0.3s var(--ease); }
  .plus::before { left: 0; right: 0; top: 6px; height: 2px; }
  .plus::after { top: 0; bottom: 0; left: 6px; width: 2px; }
  .faq details[open] .plus::after { transform: scaleY(0); }
  @media (max-width: 860px) { .faq-layout { grid-template-columns: 1fr; gap: 32px; } }

  /* cta */
  .cta { text-align: center; padding: 72px clamp(24px, 6vw, 72px); border-radius: var(--r-card); background: var(--mist); display: flex; flex-direction: column; align-items: center; }
  .cta img { width: 56px; height: 56px; border-radius: 14px; margin-bottom: 28px; }
  .cta .lede { margin: 16px auto 0; }
  .cta .btn-row { margin-top: 30px; }
  .center-row { justify-content: center; margin-top: 28px; }
</style>
