---
import Base from '../layouts/Base.astro';
import HeroStage from '../components/HeroStage.astro';
import Highlights from '../components/Highlights.astro';
import SignalBento from '../components/SignalBento.astro';
import Phone from '../components/Phone.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../lib/articles';
import { glossary } from '../lib/glossary';
import { SITE, ARROW, ANSWERS, DEMO, ENGINES, ORGANIZATION_ID, askAiLinks, absolute } from '../lib/site';

const title = 'AI Visibility Guides: Get Your Brand Into AI Answers | Arrow Signal';
const description =
  'Practical guides from Arrow AI on getting your brand mentioned, cited and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.';

const faqs = [
  { q: 'What is AI visibility?', a: 'AI visibility is how often, and how accurately, your brand appears in answers written by AI tools such as ChatGPT, Gemini, Perplexity, Claude, Copilot and Google AI Overviews. It covers being mentioned by name, being cited as a source and being recommended for a buyer’s need.' },
  { q: 'How is it different from SEO?', a: 'SEO earns a position in a list of search results. AI visibility is about the answer itself, which usually names only a few companies. The groundwork overlaps (crawlable pages, clear content, credible evidence), but the results are measured differently.' },
  { q: 'What is GEO?', a: 'Generative engine optimization (GEO) is the work of making your public information clear, accessible and well sourced so AI tools can find, understand and recommend you, then checking what their answers actually say. Arrow AI offers GEO as a managed service.' },
  { q: 'How do you measure AI visibility?', a: 'Write 20 to 50 real buyer questions, run them on the AI tools your customers use, and record each full answer with its date and sources. Note whether you are mentioned, cited and recommended, and whether the facts are right. Repeat every month with the same questions.' },
  { q: 'Can anyone guarantee that ChatGPT will recommend us?', a: 'No. Each AI company controls its own answers, and answers change with wording, location and time. What you can control is your own information and an honest record of what the answers say.' },
  { q: 'How do I get started with Arrow?', a: 'Request the free AI visibility audit on arrow-ai.us. The Arrow AI team reviews how AI tools describe your business and sends you a plan. You can also book a 15-minute call.' },
];

const stats = [
  { n: articles.length, label: 'practical guides on this site' },
  { n: 105, label: 'short answers on Arrow Answers' },
  { n: glossary.length, label: 'terms in the glossary' },
  { n: ENGINES.length, label: 'AI surfaces covered' },
];

const steps = [
  { t: 'Baseline the answers.', d: 'Run 20 to 50 real buyer questions on the AI tools your customers use, and save every answer with its date and sources.', href: '/blog/how-to-measure-ai-visibility/', link: 'Build a baseline' },
  { t: 'Fix access and facts.', d: 'Let AI crawlers reach your pages, and describe your business the same way on your site, profiles and directories.', href: '/blog/technical-ai-visibility-checklist/', link: 'Technical checklist' },
  { t: 'Publish answer pages.', d: 'Answer pricing, comparison and “is this right for me” questions directly, with evidence AI tools can cite.', href: '/blog/content-ai-engines-cite/', link: 'Write citable pages' },
  { t: 'Measure every month.', d: 'Re-run the same questions, track share of voice and citations, and pick what to fix next.', href: '/blog/ai-share-of-voice/', link: 'Track share of voice' },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: `${SITE.url}/`,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: [{ '@type': 'Thing', name: 'AI visibility' }, { '@type': 'Thing', name: 'Generative Engine Optimization' }],
    primaryImageOfPage: { '@type': 'ImageObject', url: absolute(SITE.ogImage), width: 1200, height: 630 },
    video: { '@id': `${SITE.url}/#geo-film` },
    datePublished: SITE.published,
    dateModified: '2026-10-20',
    publisher: { '@id': ORGANIZATION_ID },
  },
  {
    '@type': 'VideoObject',
    '@id': `${SITE.url}/#geo-film`,
    name: 'SEO ranked you. GEO gets you answered.',
    description: 'Arrow AI film on the move from search results to AI answers, what Generative Engine Optimization (GEO) is, and how brands get cited and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.',
    thumbnailUrl: [absolute('/media/arrow-ai-geo-film-poster.webp')],
    uploadDate: '2026-08-18T09:00:00+02:00',
    duration: 'PT36S',
    contentUrl: absolute('/media/arrow-ai-geo-film.mp4'),
    width: 1280,
    height: 720,
    inLanguage: 'en',
    publisher: { '@id': ORGANIZATION_ID },
  },
  { '@type': 'FAQPage', '@id': `${SITE.url}/#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'ItemList', '@id': `${SITE.url}/#guides`, name: 'AI visibility guides', itemListElement: articles.slice(0, 6).map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(a.url), name: a.title })) },
];
const ask = askAiLinks('https://arrow-si.com/', 'AI visibility and GEO');
const anchors = [
  { href: '#highlights', label: 'Highlights' },
  { href: '#changed', label: 'What changed' },
  { href: '#signals', label: 'Signals' },
  { href: '#method', label: 'Method' },
  { href: '#guides', label: 'Guides' },
  { href: '#faq', label: 'FAQ' },
];
const sites = [
  { host: 'arrow-ai.us', name: 'Arrow AI', d: 'The team behind this site. GEO, AI systems and AI Studio for businesses.', url: ARROW.url, cta: 'Visit Arrow AI' },
  { host: 'answers.arrow-ai.us', name: 'Arrow Answers', d: 'Short, sourced answers to more than a hundred specific GEO questions.', url: ANSWERS.url, cta: 'Browse the answers' },
  { host: 'arrow-ai.tech', name: 'GEO demo', d: 'An interactive walkthrough from a website to a cited AI answer.', url: DEMO.url, cta: 'Try the demo' },
];
---
<Base title={title} description={description} schema={schema}>
  <HeroStage />

  <nav class="anchors" aria-label="On this page">
    <ul>{anchors.map((a) => <li><a href={a.href}>{a.label}</a></li>)}</ul>
  </nav>

  <Highlights />

  <!-- WHAT CHANGED -->
  <section class="section" id="changed" aria-labelledby="shift-title">
    <div class="editorial">
      <div class="ed-copy">
        <p class="kicker reveal">What changed</p>
        <h2 id="shift-title" class="h-section reveal" style="--d:60ms">SEO ranked you. GEO gets you answered.</h2>
        <p class="copy reveal" style="--d:120ms">Rankings still matter. Google’s AI Overviews and Copilot are built on search indexes, and ChatGPT and Perplexity read web pages. <strong>But someone reading an AI answer sees a short list, not a page of results.</strong> GEO is the work of earning a place on that list.</p>
        <a class="link reveal" style="--d:160ms" href="/blog/geo-vs-seo/">GEO and SEO compared <span class="arr" aria-hidden="true">›</span></a>
      </div>
      <div class="ed-media reveal" style="--d:120ms">
        <Phone kind="search" size={320} label="Illustrative example: a search results page where yourbrand.com is the fifth result." />
        <p class="footnote">Before: result #5 of 10.</p>
      </div>
    </div>
    <ul class="stats">
      {stats.map((s, i) => <li class="reveal" style={`--d:${i * 70}ms`}><strong data-count={s.n}>{s.n}</strong><span>{s.label}</span></li>)}
    </ul>
  </section>

  <!-- SIGNALS -->
  <section class="section mist" id="signals" aria-labelledby="signals-title">
    <div class="section-head">
      <p class="kicker reveal">What to measure</p>
      <h2 id="signals-title" class="h-section reveal" style="--d:60ms">Four signals in every answer.</h2>
      <p class="copy reveal" style="--d:120ms">A brand can be cited often and still never be recommended. <strong>Each signal needs different work,</strong> so a single score hides the real problem.</p>
    </div>
    <SignalBento />
    <p class="after"><a class="link" href="/blog/mentions-citations-recommendations/">Mentions, citations and recommendations explained <span class="arr" aria-hidden="true">›</span></a></p>
  </section>

  <!-- METHOD -->
  <section class="section" id="method" aria-labelledby="method-title">
    <div class="section-head">
      <p class="kicker reveal">How Arrow works</p>
      <h2 id="method-title" class="h-section reveal" style="--d:60ms">From audit to answers.</h2>
      <p class="copy reveal" style="--d:120ms">Start with what the answers say today, <strong>fix what stops AI tools from using your site,</strong> then check again on the same questions every month.</p>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="reveal" style={`--d:${i * 80}ms`}>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          <a class="link" href={s.href}>{s.link} <span class="arr" aria-hidden="true">›</span></a>
        </li>
      ))}
    </ol>
  </section>

  <!-- GUIDES -->
  <section class="section mist" id="guides" aria-labelledby="guides-title">
    <div class="head-row">
      <h2 id="guides-title" class="h-section">Start with the guides.</h2>
      <a class="link" href="/blog/">All 15 guides <span class="arr" aria-hidden="true">›</span></a>
    </div>
    <ul class="guide-grid">
      {articles.slice(0, 6).map((a) => <ArticleCard article={a} />)}
    </ul>
  </section>

  <!-- ECOSYSTEM -->
  <section class="section" id="ecosystem" aria-labelledby="eco-title">
    <div class="section-head">
      <p class="kicker reveal">The Arrow ecosystem</p>
      <h2 id="eco-title" class="h-section reveal" style="--d:60ms">Three Arrow sites. One goal.</h2>
      <p class="copy reveal" style="--d:120ms">Learn here, go deeper on Arrow Answers, see the process in the demo, <strong>and let the Arrow AI team do the work.</strong></p>
    </div>
    <ul class="sites">
      {sites.map((c, i) => (
        <li class="reveal" style={`--d:${i * 80}ms`}>
          <img src="/brand/arrow-icon-192.png" alt="" width="48" height="48" loading="lazy" />
          <span class="eyebrow">{c.host}</span>
          <h3 class="t-small-head">{c.name}</h3>
          <p>{c.d}</p>
          <a class="link" href={c.url}>{c.cta} <span class="arr" aria-hidden="true">›</span></a>
        </li>
      ))}
    </ul>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="faq-layout">
      <div>
        <h2 id="faq-title" class="h-section">Questions? <span class="hl">Answers.</span></h2>
        <p class="faq-more">More in <a class="link" href={ANSWERS.url}>Arrow Answers <span class="arr" aria-hidden="true">›</span></a></p>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" aria-labelledby="cta-title">
    <div class="cta reveal">
      <img src="/brand/arrow-icon-192.png" alt="" width="64" height="64" loading="lazy" />
      <h2 id="cta-title" class="h-section">See what AI says about your brand.</h2>
      <p class="lede">The free audit shows how AI tools describe your business today, with a clear plan for what to fix first.</p>
      <div class="btn-row center">
        <a class="btn btn-primary" href={ARROW.freeAudit}>Get the free audit</a>
        <a class="link" href={ARROW.call}>Book 15 minutes with Noah <span class="arr" aria-hidden="true">›</span></a>
      </div>
      <div class="inline-links center-row">
        <span class="label">Ask AI about this site:</span>
        {ask.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.name}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* in-page anchors */
  .anchors { padding: 48px var(--pad) 8px; }
  .anchors ul { list-style: none; display: flex; justify-content: center; gap: 8px 40px; overflow-x: auto; scrollbar-width: none; padding: 28px 0; }
  .anchors ul::-webkit-scrollbar { display: none; }
  .anchors a { font-size: 17px; font-weight: 500; line-height: 1.47; letter-spacing: -0.022em; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .anchors a:hover { color: var(--link); }
  @media (max-width: 734px) { .anchors { padding-top: 28px; } .anchors ul { justify-content: flex-start; gap: 26px; } }

  /* editorial: what changed */
  .editorial { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; }
  .ed-copy .copy { margin-top: 24px; }
  .ed-copy .link { margin-top: 24px; }
  .ed-media { display: grid; justify-items: center; gap: 18px; margin-right: calc(-1 * min(120px, var(--gutter) - var(--pad))); }
  .stats { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 96px; padding-top: 48px; border-top: 1px solid var(--hairline); }
  .stats li { display: grid; gap: 8px; }
  .stats strong { font-size: 64px; font-weight: 600; line-height: 1; letter-spacing: -0.01em; }
  .stats span { font-size: 17px; font-weight: 600; letter-spacing: -0.022em; color: var(--steel); }
  @media (max-width: 834px) { .editorial { grid-template-columns: 1fr; } .ed-media { margin-right: 0; } .stats { grid-template-columns: 1fr 1fr; row-gap: 40px; } }
  @media (max-width: 734px) { .stats strong { font-size: 48px; } .ed-media :global(.phone) { --w: 260px !important; } }
  .after { margin-top: 40px; }

  /* method steps */
  .steps { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px 28px; }
  .steps li { display: flex; flex-direction: column; align-items: flex-start; }
  .steps .n { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; box-shadow: inset 0 0 0 1.5px var(--ink); font-size: 17px; font-weight: 600; }
  .steps h3 { margin-top: 24px; font-size: 21px; line-height: 1.19; letter-spacing: 0.011em; }
  .steps p { margin-top: 10px; color: var(--slate); flex: 1; }
  .steps .link { margin-top: 18px; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }

  /* ecosystem */
  .sites { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); }
  .sites li { display: flex; flex-direction: column; align-items: flex-start; padding: 40px 32px 32px; border-radius: var(--r-card); background: var(--mist); }
  .sites img { width: 48px; height: 48px; border-radius: 12px; margin-bottom: 32px; }
  .sites h3 { margin-top: 6px; }
  .sites p { margin-top: 10px; color: var(--slate); flex: 1; }
  .sites .link { margin-top: 24px; }
  @media (max-width: 900px) { .sites { grid-template-columns: 1fr; } }

  /* faq */
  .faq-layout { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: 56px; align-items: start; }
  .faq-more { margin-top: 16px; }
  .faq details { border-top: 1px solid var(--hairline); }
  .faq details:last-child { border-bottom: 1px solid var(--hairline); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 24px 0; font-size: 21px; font-weight: 600; line-height: 1.19; letter-spacing: 0.011em; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq details p { padding: 0 48px 26px 0; color: var(--slate); }
  .plus { position: relative; width: 16px; height: 16px; flex-shrink: 0; }
  .plus::before, .plus::after { content: ''; position: absolute; background: var(--ink); border-radius: 2px; transition: transform 0.3s var(--ease); }
  .plus::before { left: 0; right: 0; top: 7px; height: 2px; }
  .plus::after { top: 0; bottom: 0; left: 7px; width: 2px; }
  .faq details[open] .plus::after { transform: scaleY(0); }
  @media (max-width: 860px) { .faq-layout { grid-template-columns: 1fr; gap: 32px; } .faq summary { font-size: 19px; } }

  /* cta */
  .cta { text-align: center; padding: 80px clamp(24px, 6vw, 80px); border-radius: var(--r-card); background: var(--mist); display: flex; flex-direction: column; align-items: center; }
  .cta img { width: 64px; height: 64px; border-radius: 16px; margin-bottom: 28px; }
  .cta .lede { margin: 18px auto 0; color: var(--slate); }
  .cta .btn-row { margin-top: 32px; }
  .center-row { justify-content: center; margin-top: 32px; }
</style>
