---
import Base from '../layouts/Base.astro';
import HeroStage from '../components/HeroStage.astro';
import Highlights from '../components/Highlights.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../lib/articles';
import { SITE, ARROW, ANSWERS, DEMO, ORGANIZATION_ID, askAiLinks, absolute } from '../lib/site';

const title = 'AI Visibility Guides: Get Your Brand Into AI Answers | Arrow Signal';
const description =
  'Practical guides from Arrow AI on getting your business mentioned and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.';

const faqs = [
  { q: 'What is AI visibility?', a: 'It is how often AI tools like ChatGPT, Gemini or Google’s AI Overviews mention your business, link to your site or suggest you to someone, and whether what they say about you is right.' },
  { q: 'Is this different from SEO?', a: 'Partly. SEO gets you a spot in a list of links. An AI answer usually names only a few businesses, so the bar is higher. The basics overlap: pages that load, say clearly what you do, and are backed up by other sites.' },
  { q: 'What is GEO?', a: 'Generative engine optimization. It is the name for this work: making your information easy for AI tools to find and trust, then checking what their answers actually say. Arrow AI does it as a service.' },
  { q: 'How do I know where I stand?', a: 'Ask the questions your customers would ask, in the tools they use, and write down what comes back. Do it again next month with the same questions. Our guide on measuring AI visibility walks you through it.' },
  { q: 'Can you guarantee ChatGPT will recommend us?', a: 'No, and be careful with anyone who does. The AI companies decide what their tools say. We can make your information clear and well sourced, and show you honestly what changes.' },
  { q: 'How do I start?', a: 'Ask for the free audit on arrow-ai.us. We look at what AI tools say about you today and send you a short plan. You can also book 15 minutes with Noah.' },
];

const sites = [
  { name: 'Arrow AI', d: 'The agency behind this site. We do GEO, AI systems and content for businesses.', url: ARROW.url, host: 'arrow-ai.us' },
  { name: 'Arrow Answers', d: 'Short answers to more than a hundred specific questions about GEO.', url: ANSWERS.url, host: 'answers.arrow-ai.us' },
  { name: 'GEO demo', d: 'Follow a website step by step until it shows up as a cited answer.', url: DEMO.url, host: 'arrow-ai.tech' },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: `${SITE.url}/`,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: [{ '@type': 'Thing', name: 'AI visibility' }, { '@type': 'Thing', name: 'Generative Engine Optimization' }],
    primaryImageOfPage: { '@type': 'ImageObject', url: absolute(SITE.ogImage), width: 1200, height: 630 },
    video: { '@id': `${SITE.url}/#geo-film` },
    datePublished: SITE.published,
    dateModified: '2026-10-20',
    publisher: { '@id': ORGANIZATION_ID },
  },
  {
    '@type': 'VideoObject',
    '@id': `${SITE.url}/#geo-film`,
    name: 'SEO ranked you. GEO gets you answered.',
    description: 'Arrow AI film on the move from search results to AI answers, what Generative Engine Optimization (GEO) is, and how brands get cited and recommended in ChatGPT, Gemini, Perplexity, Claude and Google AI Overviews.',
    thumbnailUrl: [absolute('/media/arrow-ai-geo-film-poster.webp')],
    uploadDate: '2026-08-18T09:00:00+02:00',
    duration: 'PT36S',
    contentUrl: absolute('/media/arrow-ai-geo-film.mp4'),
    width: 1280,
    height: 720,
    inLanguage: 'en',
    publisher: { '@id': ORGANIZATION_ID },
  },
  { '@type': 'FAQPage', '@id': `${SITE.url}/#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'ItemList', '@id': `${SITE.url}/#guides`, name: 'AI visibility guides', itemListElement: articles.slice(0, 6).map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(a.url), name: a.title })) },
];
const ask = askAiLinks('https://arrow-si.com/', 'AI visibility and GEO');
---
<Base title={title} description={description} schema={schema}>
  <HeroStage />

  <Highlights />

  <!-- WHAT CHANGED -->
  <section class="section" id="changed" aria-labelledby="shift-title">
    <div class="editorial">
      <p class="kicker reveal">What changed</p>
      <h2 id="shift-title" class="t-big reveal" style="--d:60ms">People now ask AI who&nbsp;to&nbsp;call.</h2>
      <div class="cols">
        <p class="copy reveal" style="--d:120ms">Someone looking for an accountant, a dentist or a CRM types the question into ChatGPT and gets a short answer with two or three names. <strong>If you are not one of them, you never hear about it.</strong></p>
        <p class="copy reveal" style="--d:180ms">The guides on this site explain how those answers get written, and what tends to get a business into them. <a class="link" href="/blog/geo-vs-seo/">How it differs from Google <span class="arr" aria-hidden="true">›</span></a></p>
      </div>
    </div>
  </section>

  <!-- GUIDES -->
  <section class="section mist" id="guides" aria-labelledby="guides-title">
    <div class="head-row">
      <h2 id="guides-title" class="h-section">Where to start.</h2>
      <a class="link" href="/blog/">All 15 guides <span class="arr" aria-hidden="true">›</span></a>
    </div>
    <ul class="guide-grid">
      {articles.slice(0, 6).map((a) => <ArticleCard article={a} />)}
    </ul>
  </section>

  <!-- HOW WE WORK -->
  <section class="section" id="method" aria-labelledby="method-title">
    <div class="split">
      <img class="split-img reveal" src="/media/arrow-object-flat.webp" alt="The Arrow AI app icon lying flat on a white surface in soft studio light." width="1600" height="1200" loading="lazy" decoding="async" />
      <div>
        <p class="kicker reveal">How Arrow works</p>
        <h2 id="method-title" class="h-section reveal" style="--d:60ms">We start with the questions your customers ask.</h2>
        <p class="copy reveal" style="--d:120ms">We run 20 to 50 real buyer questions through ChatGPT, Gemini, Perplexity and Google, and keep every answer with its date and sources. <strong>Then we fix what is missing, on your site and elsewhere,</strong> and run the same questions again every month so you can see what moved.</p>
        <div class="btn-row reveal" style="--d:160ms">
          <a class="btn btn-primary" href={ARROW.freeAudit}>Get a free audit</a>
          <a class="link" href="/blog/how-to-measure-ai-visibility/">How we measure it <span class="arr" aria-hidden="true">›</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ECOSYSTEM -->
  <section class="section mist" id="ecosystem" aria-labelledby="eco-title">
    <div class="section-head center">
      <h2 id="eco-title" class="h-section reveal">More from Arrow.</h2>
    </div>
    <img class="trio reveal" src="/media/arrow-object-trio.webp" alt="Three Arrow AI app icons floating side by side, one for each Arrow site." width="2400" height="1200" loading="lazy" decoding="async" />
    <ul class="sites">
      {sites.map((c, i) => (
        <li class="reveal" style={`--d:${i * 80}ms`}>
          <h3>{c.name}</h3>
          <p>{c.d}</p>
          <a class="link" href={c.url}>{c.host} <span class="arr" aria-hidden="true">›</span></a>
        </li>
      ))}
    </ul>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="faq-layout">
      <div>
        <h2 id="faq-title" class="h-section">Questions we get a lot.</h2>
        <p class="faq-more">More on <a class="link" href={ANSWERS.url}>Arrow Answers <span class="arr" aria-hidden="true">›</span></a></p>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" aria-labelledby="cta-title">
    <div class="cta reveal">
      <h2 id="cta-title" class="h-section">Want to know what ChatGPT says about you?</h2>
      <p class="lede">Ask for a free audit. We check the answers and send you a short plan.</p>
      <div class="btn-row center">
        <a class="btn btn-primary" href={ARROW.freeAudit}>Get a free audit</a>
        <a class="link" href={ARROW.call}>Or book 15 minutes with Noah <span class="arr" aria-hidden="true">›</span></a>
      </div>
      <p class="summ">Summarize this site with {ask.map((l, i) => <><a href={l.url} target="_blank" rel="noopener">{l.name}</a>{i < ask.length - 2 ? ', ' : i === ask.length - 2 ? ' or ' : '.'}</>)}</p>
    </div>
  </section>
</Base>

<style>
  /* what changed */
  .editorial { max-width: var(--content); }
  .t-big { font-size: 64px; font-weight: 600; line-height: 1.06; letter-spacing: -0.01em; max-width: 820px; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 48px; }
  .cols .copy .link { font-weight: 600; }
  @media (max-width: 1068px) { .t-big { font-size: 52px; } }
  @media (max-width: 734px) { .t-big { font-size: 36px; line-height: 1.11; } .cols { grid-template-columns: 1fr; gap: 20px; margin-top: 28px; } }

  /* how we work */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .split-img { width: 100%; height: auto; }
  .split .copy { margin-top: 22px; }
  .split .btn-row { margin-top: 32px; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; gap: 24px; } .split-img { max-width: 520px; margin: 0 auto; } }

  /* ecosystem */
  .trio { width: 100%; height: auto; margin: -24px 0 8px; }
  .sites { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; text-align: center; }
  .sites h3 { font-size: 24px; line-height: 1.17; letter-spacing: 0.009em; }
  .sites p { margin: 10px auto 0; max-width: 280px; color: var(--slate); }
  .sites .link { margin-top: 14px; }
  @media (max-width: 734px) { .sites { grid-template-columns: 1fr; gap: 36px; } .trio { margin-top: 0; } }

  /* faq */
  .faq-layout { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: 56px; align-items: start; }
  .faq-more { margin-top: 16px; }
  .faq details { border-top: 1px solid var(--hairline); }
  .faq details:last-child { border-bottom: 1px solid var(--hairline); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 24px 0; font-size: 21px; font-weight: 600; line-height: 1.19; letter-spacing: 0.011em; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq details p { padding: 0 48px 26px 0; color: var(--slate); }
  .plus { position: relative; width: 16px; height: 16px; flex-shrink: 0; }
  .plus::before, .plus::after { content: ''; position: absolute; background: var(--ink); border-radius: 2px; transition: transform 0.3s var(--ease); }
  .plus::before { left: 0; right: 0; top: 7px; height: 2px; }
  .plus::after { top: 0; bottom: 0; left: 7px; width: 2px; }
  .faq details[open] .plus::after { transform: scaleY(0); }
  @media (max-width: 860px) { .faq-layout { grid-template-columns: 1fr; gap: 32px; } .faq summary { font-size: 19px; } }

  /* cta */
  .cta { text-align: center; padding: 80px clamp(24px, 6vw, 80px); border-radius: var(--r-card); background: var(--mist); display: flex; flex-direction: column; align-items: center; }
  .cta .h-section { max-width: 640px; }
  .cta .lede { margin: 18px auto 0; color: var(--slate); }
  .cta .btn-row { margin-top: 32px; }
  .summ { margin-top: 32px; font-size: 14px; line-height: 1.43; letter-spacing: -0.016em; color: var(--slate); }
  .summ a { color: var(--link); text-decoration: none; }
  .summ a:hover { text-decoration: underline; }
</style>
