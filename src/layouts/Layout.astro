---
import '../styles/global.css';
import '../styles/home.css';
interface Props { title: string; description: string; schema?: object; noindex?: boolean }
const { title, description, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const organization = { '@context': 'https://schema.org', '@type': 'Organization', '@id': 'https://arrow-si.com/#organization', name: 'Arrow Signal', url: 'https://arrow-si.com', logo: 'https://arrow-si.com/brand/arrow-app-icon.svg', parentOrganization: { '@type': 'Organization', name: 'Arrow AI', url: 'https://arrow-ai.us', sameAs: ['https://www.linkedin.com/company/arrow-ai-us/', 'https://www.instagram.com/arrowai.us/', 'https://www.youtube.com/@Arrowaius'] } };
const home = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={home ? "#ffffff" : "#060b19"} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/brand/arrow-app-icon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Arrow Signal journal" href="/feed.xml" />
    <meta property="og:type" content={schema && '@type' in schema && schema['@type'] === 'Article' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Arrow Signal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://arrow-si.com/og.png" />
    <meta property="og:image:alt" content="Arrow Signal — Your brand. The answer. Blue and lavender signal gradients on white." />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://arrow-si.com/og.png" />
    <meta name="twitter:image:alt" content="Arrow Signal: AI visibility intelligence from the Arrow ecosystem." />
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...schema }).replace(/</g, '\\u003c')} />}
  </head>
  <body class:list={{ 'home-light': home }}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Arrow Signal home"><img class="brand-logo" src="/brand/arrow-app-icon.svg" alt="" width="34" height="34" /><span>arrow<span class="brand-divider">/</span><span class="brand-light">signal</span></span></a>
      <button class="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label="Open navigation"><span></span><span></span></button>
      <nav id="navigation" aria-label="Main navigation">
        <a href={home ? '#visibility' : '/#visibility'}>AI visibility</a>
        <a href={home ? '#approach' : '/#approach'}>The signal method</a>
        <a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Journal</a>
        <a class="nav-cta" href="https://arrow-ai.us/geo-check/">Get your GEO check <span aria-hidden="true"><svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><a href="/" class="brand" aria-label="Arrow Signal home"><img class="brand-logo" src="/brand/arrow-app-icon.svg" alt="" width="34" height="34" /><span>arrow<span class="brand-divider">/</span><span class="brand-light">signal</span></span></a><p>Less noise.<br />More signal.</p><a class="text-link" href="https://arrow-ai.us/">Find your next direction <span aria-hidden="true"><svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></span></a></div>
      <div class="footer-grid"><div><span class="eyebrow">OUR FOCUS</span><p>AI visibility intelligence.<br />A clearer path from discovery to trust.</p></div><div><span class="eyebrow">EXPLORE</span><a href="/#visibility">AI visibility & GEO</a><a href="/blog/">The Signal Journal</a><a href="/#faq">Your questions, answered</a></div><div><span class="eyebrow">THE ARROW ECOSYSTEM</span><a href="https://arrow-ai.us/">Arrow AI <span aria-hidden="true"><svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></span></a><a href="https://answers.arrow-ai.us/">Arrow Answers <span aria-hidden="true"><svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></span></a><a href="https://arrow-ai.tech/">Arrow AI Tech <span aria-hidden="true"><svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></span></a></div><div><span class="eyebrow">FOLLOW ARROW</span><a href="https://www.linkedin.com/company/arrow-ai-us/" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="https://www.instagram.com/arrowai.us/" target="_blank" rel="noopener noreferrer">Instagram</a><a href="https://www.youtube.com/@Arrowaius" target="_blank" rel="noopener noreferrer">YouTube</a><span class="eyebrow footer-share-label">SHARE THE SIGNAL</span><a href="https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Farrow-si.com%2F" target="_blank" rel="noopener noreferrer">Share on LinkedIn <span aria-hidden="true"><svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></span></a><a href="https://twitter.com/intent/tweet?url=https%3A%2F%2Farrow-si.com%2F&text=Be%20the%20signal.%20Become%20the%20answer." target="_blank" rel="noopener noreferrer">Share on X <span aria-hidden="true"><svg class="icon-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" /></svg></span></a></div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Arrow Signal.</span><span>An editorial destination in the Arrow ecosystem.</span><a href="/privacy/">Privacy</a></div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#navigation');
      function closeMenu() { button?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('open'); }
      button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') !== 'true'; button.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('open', open); });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape') { closeMenu(); button?.focus(); } });
      const observer = new IntersectionObserver(entries => { entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); } }); }, { threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
