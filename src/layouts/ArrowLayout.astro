---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/geist-mono';
const { title, description, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const organization = { '@context': 'https://schema.org', '@type': 'Organization', '@id': 'https://arrow-si.com/#organization', name: 'Arrow Signal', url: 'https://arrow-si.com', logo: 'https://arrow-si.com/brand/arrow-app-icon.svg', parentOrganization: { '@type': 'Organization', name: 'Arrow AI', url: 'https://arrow-ai.us', sameAs: ['https://www.linkedin.com/company/arrow-ai-us/', 'https://www.instagram.com/arrowai.us/', 'https://www.youtube.com/@Arrowaius'] } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#f7f7f9"/>
    <meta name="robots" content="index, follow, max-image-preview:large"/><link rel="canonical" href={canonical}/>
    <link rel="icon" type="image/svg+xml" href="/brand/arrow-app-icon.svg"/><link rel="alternate" type="application/rss+xml" title="Arrow Signal journal" href="/feed.xml"/>
    <meta property="og:type" content="website"/><meta property="og:site_name" content="Arrow Signal"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://arrow-si.com/og.png"/><meta property="og:image:alt" content="Arrow AI — AI visibility and GEO. The official Arrow logo and blue headline on the Arrow neutral background."/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="https://arrow-si.com/og.png"/>
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')}/>
    {schema && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...schema }).replace(/</g, '\\u003c')}/>}
    <link rel="stylesheet" href="/brand/arrow-home.css"/>
    <link rel="stylesheet" href="/brand/arrow-base.css"/>
  </head>
  <body>
    <a class="base-skip" href="#main">Skip to content</a>
    <header class="v5-nav"><div class="v5-nav-inner"><a class="v5-brand" href="/" aria-label="Arrow Signal home"><img src="/brand/arrow-app-icon.svg" alt="" width="26" height="26"/>Arrow <span class="sub" aria-hidden="true">AI</span></a><nav class="v5-nav-links" aria-label="Primary"><a href="/#visibility">AI visibility</a><a href="/#approach">Method</a><a href="/blog/">Resources</a><a href="https://arrow-ai.us/en-about/">About Arrow</a></nav><div class="v5-nav-actions"><a class="btn btn-blue btn-sm" href="https://arrow-ai.us/free-audit/">Free audit</a><a class="btn btn-dark btn-sm" href="https://cal.com/noah-maman-arrow-ai/15min">Book a call</a></div><button class="v5-nav-toggle" type="button" aria-controls="mobile-navigation" aria-expanded="false" aria-label="Open menu"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 5h14M2 9h14M2 13h14"/></svg></button></div><nav id="mobile-navigation" class="base-mobile" aria-label="Mobile navigation" hidden><a href="/#visibility">AI visibility</a><a href="/#approach">Method</a><a href="/blog/">Resources</a><a href="https://arrow-ai.us/en-about/">About Arrow</a><a href="https://arrow-ai.us/free-audit/">Free audit</a><a href="https://cal.com/noah-maman-arrow-ai/15min">Book a call</a></nav></header>
    <div class="frame"><main id="main"><slot/></main></div>
    <footer class="v5-footer"><div class="v5-footer-inner"><div class="v5-footer-grid"><div class="v5-footer-brand"><a class="v5-brand" href="/" aria-label="Arrow Signal home"><img src="/brand/arrow-app-icon.svg" alt="" width="26" height="26" loading="lazy"/>Arrow <span class="sub" aria-hidden="true">AI</span></a><p>Arrow Signal focuses on AI visibility and GEO. Part of the Arrow ecosystem.</p></div><div class="v5-footer-col"><span class="col-title">AI visibility</span><a href="https://arrow-ai.us/geo/">GEO</a><a href="https://arrow-ai.us/free-audit/">Free audit</a><a href="/blog/">15 practical guides</a></div><div class="v5-footer-col"><span class="col-title">Arrow ecosystem</span><a href="https://arrow-ai.us/">Arrow AI</a><a href="https://answers.arrow-ai.us/">Arrow Answers</a><a href="https://arrow-ai.tech/">GEO demo</a></div><div class="v5-footer-col"><span class="col-title">Follow Arrow</span><a href="https://www.linkedin.com/company/arrow-ai-us/">LinkedIn</a><a href="https://www.instagram.com/arrowai.us/">Instagram</a><a href="https://www.youtube.com/@Arrowaius">YouTube</a></div><div class="v5-footer-col"><span class="col-title">Company</span><a href="https://arrow-ai.us/en-about/">About Arrow</a><a href="https://arrow-ai.us/contact/">Contact</a><a href="/privacy/">Privacy</a></div></div><div class="base-footer-bottom">© {new Date().getFullYear()} Arrow Signal. AI visibility intelligence from the Arrow ecosystem.</div></div></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.v5-nav-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-navigation');
      function close() { if (menu) menu.hidden = true; toggle?.setAttribute('aria-expanded','false'); }
      toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));if(menu)menu.hidden=!open;});
      menu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
      document.addEventListener('keydown',e=>{if(e.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){close();toggle.focus();}});
    </script>
  </body>
</html>
